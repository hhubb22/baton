{
  "name": "@baton/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": "./src/auth.ts",
    "./database": "./src/database.ts",
    "./gateway": "./src/gateway.ts",
    "./nodes": "./src/nodes.ts",
    "./server": "./src/server.ts",
    "./testing/database": "./src/testing/database.ts"
  },
  "scripts": {
    "dev": "node ../../tools/ts-migration/run-server.mjs",
    "build": "node ../../tools/ts-migration/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint .",
    "test": "vp test run --config ../../vitest.config.ts",
    "test:unit": "vp test run --config ../../vitest.config.ts --project unit",
    "test:integration": "vp test run --config ../../vitest.config.ts --project integration"
  },
  "dependencies": {
    "@baton/telemetry": "workspace:*",
    "@baton/protocol": "workspace:*",
    "ws": "8.22.0",
    "effect": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
