use "resources/fonts/Inter-Regular.otf"
use "resources/fonts/Inter-Medium.otf"
use "resources/fonts/Inter-SemiBold.otf"

import "tokens/colors.elyx" as c
import "foundations/typography.elyx" as t
import "blocks/desktop-system.elyx" as native

systemReference = frame {
  title: "Desktop / Notifications and tray",
  caption: "Native system surfaces. Content and order only; macOS and Windows provide the appearance.",
  left: 0px,
  top: 0px,
  width: 1440px,
  layout: {direction: .column, item-gap: 28px},
  fill: c.colors.canvas,
  padding: 40px,
  children: [heading, columns],

  heading = text : t.title {
    contents: "Notifications and tray"
  }

  columns = frame {
    width: 100%,
    layout: {item-gap: 64px},
    children: [notifications, tray, states],

    notifications = frame {
      width: 520px,
      layout: {direction: .column, item-gap: 20px},
      children: [label, question, ended, stopped, rejected, behavior],

      label = text : t.heading {
        contents: "System notifications"
      }

      question = frame : native.notificationExample {
        width: 100%
      }

      ended = frame : native.notificationExample {
        width: 100%,

        eventLabel {
          contents: "Reply ended"
        }

        bodyRule {
          contents: "Body · State that the reply ended; make no claim about task success."
        }

        exampleTitle {
          contents: "Check Windows reconnect"
        }

        exampleBody {
          contents: "Codex finished replying."
        }
      }

      stopped = frame : native.notificationExample {
        width: 100%,

        eventLabel {
          contents: "Failed or unexpectedly stopped"
        }

        bodyRule {
          contents: "Body · Name the interruption and a known cause."
        }

        exampleTitle {
          contents: "Check Windows reconnect"
        }

        exampleBody {
          contents: "Codex stopped before finishing: the process exited unexpectedly."
        }
      }

      rejected = frame : native.notificationExample {
        width: 100%,

        eventLabel {
          contents: "Local device rejected"
        }

        titleRule {
          contents: "Title · Local device name"
        }

        bodyRule {
          contents: "Body · Name the connection rejection and its reason."
        }

        exampleTitle {
          contents: "MacBook Pro"
        }

        exampleBody {
          contents: "Connection rejected: Baton 0.2.0 is required."
        }
      }

      behavior = text : t.caption {
        width: 100%,
        contents: "Question example: “Codex asks which branch to use.”\nProject example: “Release checks” / “The project assistant needs your decision.”\n\nClick opens the matching thread or project and focuses Baton. Deleted or archived: open its list with “This thread was deleted.” or “This project was archived.”\nDevice rejection opens local device details.\n\nSuppress a thread's notification while it is visible in the focused window. Notify each event once, including after reload or reconnect.",
        line-height: 1.6
      }
    }

    tray = frame {
      width: 360px,
      layout: {direction: .column, item-gap: 16px},
      children: [label, device, work, waiting, preferences, actions],

      label = text : t.heading {
        contents: "Tray menu · in order"
      }

      device = frame : native.trayGroup {
        width: 100%
      }

      work = frame : native.trayGroup {
        width: 100%,

        label {
          contents: "Work across all your devices"
        }

        entries {
          contents: "2 running · 7 waiting for you"
        }
      }

      waiting = frame : native.trayGroup {
        width: 100%,

        label {
          contents: "Waiting for you · up to 5 threads"
        }

        entries {
          contents: "Review reconnect logs\nChoose migration order\nApprove test command\nReview release notes\nChoose target branch"
        }
      }

      preferences = frame : native.trayGroup {
        width: 100%,

        label {
          contents: "Preferences"
        }

        entries {
          contents: "Notifications · On\nLaunch at login · On\nSettings…"
        }
      }

      actions = frame : native.trayGroup {
        width: 100%,

        label {
          contents: "Actions"
        }

        entries {
          contents: "Open Baton\nRestart device service\nOpen logs folder\nQuit Baton"
        }
      }
    }

    states = frame {
      width: 352px,
      layout: {direction: .column, item-gap: 20px},
      children: [label, deviceStates, permissions, counts, editor, quit],

      label = text : t.heading {
        contents: "Native state rules"
      }

      deviceStates = frame : native.trayGroup {
        width: 100%,

        label {
          contents: "Device status"
        }

        entries {
          contents: "Not connected\nConnecting…\nOnline: green dot only\nRejected · Setup code expired\nRejected · Requires Baton 0.2.0"
        }
      }

      permissions = frame : native.trayGroup {
        width: 100%,

        label {
          contents: "System notifications disabled"
        }

        entries {
          contents: "Notifications · On\nDisabled in system settings\nOpen notification settings"
        }
      }

      counts = text : t.small {
        width: 100%,
        contents: "Waiting threads mark the tray icon. Each waiting row opens its thread. Counts cover your threads on every device, including project threads.",
        line-height: 1.6
      }

      editor = text : t.small {
        width: 100%,
        contents: "Notifications default to On and persist locally. Off stops notifications; counts and waiting rows remain.\n\nSettings… includes Editor, with System default selected until an editor is chosen.",
        line-height: 1.6
      }

      quit = text : t.small {
        width: 100%,
        contents: "External service: omit Restart device service and show “Managed by an external service”.\n\nDuring migration, replace restart with the current phase. Open logs folder stays available.\n\nQuit Baton stops the managed device service. An external service keeps running.",
        line-height: 1.6
      }
    }
  }
}
