use "resources/fonts/Inter-Regular.otf"
use "resources/fonts/Inter-Medium.otf"
use "resources/fonts/Inter-SemiBold.otf"

import "tokens/colors.elyx" as c
import "controls/button.elyx" as buttons
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "blocks/project-page.elyx" as page
import "blocks/sidebar.elyx" as sidebars
import "controls/avatar.elyx" as avatars
import "blocks/project-header.elyx" as headers
import "blocks/overview.elyx" as overviews
import "controls/input.elyx" as inputs
import "blocks/dialog.elyx" as dialogs
import "controls/field.elyx" as fields
import "controls/label.elyx" as labels

create = frame : page.projectPage {
  title: "New project",
  caption: "Name the project, add an optional goal, and choose a model.",
  left: 0px,
  top: 0px,
  overrides: [insert(scrim, after = page.projectPage.overview)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      footer {
        actions {
          @with-variant(buttons.button)
          confirm {
            connections[0].target: creating,

            label {
              contents: "Create project"
            }
          }
        }

        note {
          display: .none
        }
      }

      content {
        overrides: [
          insert(titleField, after = .nil),
          insert(goalField, after = titleField),
          insert(modelField, after = goalField),
          remove(dialogs.dialog.content.message)
        ]
      }

      heading {
        contents: "New project"
      }

      titleField = frame : fields.field {
        width: 100%,

        helper {
          display: .none
        }

        @with-variant(inputs.focus)
        input {
          value {
            contents: "Release Check"
          }

          top: .nil
        }
      }

      goalField = frame : fields.optionalText {
        width: 100%,

        helper {
          display: .none
        }

        input {
          @with-variant(t.small)
          value {
            contents: "Run the full test suite across all three OSes before every release and return logs as attachments"
          }
        }
      }

      modelField = frame {
        width: 100%,
        layout: {direction: .column, item-gap: 6px},
        children: [modelLabel, modelRow, modelHelp],

        modelLabel = frame : labels.label {
          labelText {
            contents: "Project assistant model"
          }
        }

        modelRow = frame {
          width: 100%,
          layout: {item-gap: s.space.sm},
          children: [subscription, model],

          subscription = frame : inputs.select {
            width: 100%,

            value {
              contents: "ChatGPT subscription"
            }
          }

          model = frame : inputs.select {
            width: 100%,

            value {
              contents: "gpt-5.1"
            }
          }
        }

        modelHelp = text : t.caption {
          width: 100%,
          display: .none,
          contents: "",
          fill[0].color: c.colors.muted
        }
      }
    }
  }
}

created = frame : page.projectPage {
  title: "New project / Empty conversation",
  caption: "Describe the first task to start working with the project assistant.",
  left: 1728px,
  top: 0px,

  overview {
    body {
      overrides: [
        insert(noTasks, after = .nil),
        remove(overviews.overview.body.recentRow2),
        remove(overviews.overview.body.recentRow1),
        remove(overviews.overview.body.recentHead),
        remove(overviews.overview.body.recentMore),
        remove(overviews.overview.body.queuedHead),
        remove(overviews.overview.body.activeRow1),
        remove(overviews.overview.body.queuedRow),
        remove(overviews.overview.body.activeRow2),
        remove(overviews.overview.body.activeHead),
        remove(overviews.overview.body.needsRow),
        remove(overviews.overview.body.needsHead)
      ]
    }

    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              display: .none
            }

            runtimeDevice {
              runtimeName {
                contents: "Not started yet"
              }
            }
          }
        }
      }

      goal {
        goalText {
          contents: "Run the full test suite across all three OSes before every release and return logs as attachments"
        }
      }
    }

    tabBar {
      memoryTab {
        count {
          contents: "0"
        }
      }

      threadsTab {
        count {
          contents: "0"
        }
      }
    }
  }

  main {
    dock {
      composer {
        prompt {
          contents: "Describe what you want to build or verify…"
        }
      }
    }

    transcript {
      overrides: [
        insert(empty, after = .nil),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day),
        remove(page.projectPage.main.transcript.user1),
        remove(page.projectPage.main.transcript.agent1),
        remove(page.projectPage.main.transcript.agent0),
        remove(page.projectPage.main.transcript.user0)
      ],
      layout.justify-content: .center
    }

    @with-variant(headers.headerIdle)
    header {
      lead {
        identity {
          avatar {
            fill[0].color: c.hues.blue,

            initial {
              contents: "R"
            }
          }

          name {
            contents: "Release Check"
          }
        }

        state {
          caption {
            contents: "Not started yet"
          }
        }
      }

      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        overrides: [insert(projRelease, after = .nil)],

        @with-variant(sidebars.projectRowLive)
        projBaton {}
      }
    }
  }

  projRelease = frame : sidebars.projectRowActive {
    width: 100%,

    lead {
      avatar {
        fill[0].color: c.hues.blue,

        initial {
          contents: "R"
        }
      }

      name {
        contents: "Release Check"
      }
    }
  }

  empty = frame {
    width: 440px,
    layout: {direction: .column, align-items: .center, item-gap: s.space.md},
    children: [emptyAvatar, emptyTitle, emptyGoal, emptyHint],

    emptyAvatar = frame : avatars.large {
      fill[0].color: c.hues.blue,

      initial {
        contents: "R"
      }
    }

    emptyTitle = text : t.title {
      contents: "Release Check"
    }

    emptyGoal = text : t.small {
      width: 100%,
      contents: "Run the full test suite across all three OSes before every release and return logs as attachments",
      align: .center,
      fill[0].color: c.colors.muted
    }

    emptyHint = text : t.caption {
      width: 100%,
      display: .none,
      contents: "",
      align: .center,
      fill[0].color: c.colors.faint
    }
  }

  noTasks = text : t.small {
    width: 100%,
    contents: "No threads",
    fill[0].color: c.colors.muted
  }
}

nameRequired = frame : create {
  title: "New project / Name required",
  caption: "The name error appears beside the field. Goal and model choices stay filled in.",
  left: 3456px,
  top: 0px,

  scrim {
    form {
      content {
        titleField {
          @with-variant(t.captionDanger)
          helper {
            display: .visible,
            contents: "Enter a project name."
          }

          @with-variant(inputs.error)
          input {}
        }
      }
    }
  }
}

creating = frame : create {
  title: "New project / Creating",
  caption: "Create project keeps the form visible until the project is saved.",
  left: 0px,
  top: 1080px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            connections[0].target: created,

            label {
              contents: "Creating…"
            }
          }
        }

        note {
          display: .visible,
          contents: "Creating project…"
        }
      }
    }
  }
}

creationFailed = frame : create {
  title: "New project / Couldn't save",
  caption: "Creation failed. Keep the entered name, goal and model, then retry.",
  left: 1728px,
  top: 1080px,

  scrim {
    form {
      footer {
        layout.direction: .column,
        layout.align-items: .end,

        actions {
          confirm {
            label {
              contents: "Try again"
            }
          }
        }

        @with-variant(t.captionDanger)
        note {
          display: .visible,
          contents: "Couldn't create the project. Try again."
        }
      }
    }
  }
}

noReadyDevice = frame : create {
  title: "New project / No device ready",
  caption: "Creation remains available. Work waits until a device is ready.",
  left: 3456px,
  top: 1080px,

  scrim {
    form {
      content {
        modelField {
          modelRow {
            subscription {
              value {
                contents: "Claude subscription"
              }
            }

            model {
              value {
                contents: "claude-opus-5.5"
              }
            }
          }

          modelHelp {
            display: .visible,
            contents: "No online device has Claude signed in. Messages wait until one does."
          }
        }
      }
    }
  }
}
