import "blocks/desktop-local.elyx" as local
import "tokens/colors.elyx" as c
import "blocks/thread-list.elyx" as lists

threadLocalWindows = frame : local.localThread {
  title: "Desktop thread / Windows",
  caption: "Folder and editor icons end the device and folder line. Hover or focus shows the action label.",
  left: 0px,
  top: 0px,

  detail {
    footer {
      localFolder {
        row {
          actions {
            editor {
              connections[0].target: threadFolderMissing,
              connections[0].label: "Folder was removed"
            }

            reveal {
              connections[0].target: threadFolderMissing,
              connections[0].label: "Folder was removed"
            }
          }
        }
      }
    }
  }
}

threadLocalMac = frame : local.localThreadMac {
  title: "Desktop thread / macOS",
  caption: "Hover the folder icon for Show in Finder. The selected thread, log attachment and working folder all belong to MacBook Pro.",
  left: 1728px,
  top: 0px
}

threadFolderMissing = frame : local.localThread {
  title: "Desktop thread / Missing folder",
  caption: "Keep both icons in the device and folder line. Report the missing folder below it without creating a folder.",
  left: 3456px,
  top: 0px,

  detail {
    footer {
      localFolder {
        error {
          display: .visible
        }
      }
    }
  }
}

threadExplorerHover = frame : local.localThread {
  title: "Desktop thread / Explorer tooltip",
  caption: "Hover or keyboard focus shows Show in Explorer above the folder icon.",
  left: 0px,
  top: 3240px,

  detail {
    footer {
      localFolder {
        row {
          actions {
            reveal {
              tooltip {
                display: .visible
              }
            }
          }
        }
      }
    }
  }
}

threadFinderHover = frame : local.localThreadMac {
  title: "Desktop thread / Finder tooltip",
  caption: "Hover or keyboard focus shows Show in Finder above the folder icon.",
  left: 1728px,
  top: 3240px,

  detail {
    footer {
      localFolder {
        row {
          actions {
            reveal {
              tooltip {
                display: .visible
              }
            }
          }
        }
      }
    }
  }
}

threadLocation = frame : lists.threadsPage {
  title: "Desktop / Thread folder selection",
  caption: "Choose local folder opens the system picker for MacBook Pro. Cancel keeps the draft, device, model and current folder.",
  left: 0px,
  top: 1080px,
  overrides: [insert(scrim, after = lists.threadsPage.main)],

  main {
    compose {
      composer {
        prompt {
          contents: "Review the reconnect logs."
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: picker,

    picker = frame : local.localFolderPicker {
      footer {
        actions {
          confirm {
            connections[0].target: threadDraft,
            connections[0].label: "Use selected folder"
          }

          cancel {
            connections[0].target: threadDraft,
            connections[0].label: "Keep previous selection"
          }
        }
      }

      content {
        nativePicker {
          connections[2].target: threadLocation,
          connections[1].target: threadLocationOutside,
          connections[0].target: threadLocationSelected,
          connections[2].label: "Native picker canceled; keep selection",
          connections[1].label: "Native picker returns a folder outside the allowed range",
          connections[0].label: "Native picker returns an allowed folder"
        }
      }
    }
  }
}

threadLocationOutside = frame : lists.threadsPage {
  title: "Desktop / Thread folder outside allowed range",
  caption: "Reject the native selection. The previous folder and message draft remain; choose again or cancel.",
  left: 1728px,
  top: 1080px,
  overrides: [insert(scrim, after = lists.threadsPage.main)],

  main {
    compose {
      composer {
        prompt {
          contents: "Review the reconnect logs."
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: picker,

    picker = frame : local.localFolderPicker {
      footer {
        actions {
          confirm {
            connections[0].target: threadDraft,
            connections[0].label: "Use unchanged selection"
          }

          cancel {
            connections[0].target: threadDraft
          }
        }
      }

      content {
        nativePicker {
          connections[0].target: threadLocation,
          connections[0].label: "Choose again"
        }

        selectionError {
          display: .visible
        }
      }
    }
  }
}

threadLocationSelected = frame : lists.threadsPage {
  title: "Desktop / Thread local folder selected",
  caption: "An allowed native selection becomes the current folder. Selecting it returns to the preserved draft.",
  left: 3456px,
  top: 1080px,
  overrides: [insert(scrim, after = lists.threadsPage.main)],

  main {
    compose {
      composer {
        prompt {
          contents: "Review the reconnect logs."
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: picker,

    picker = frame : local.localFolderPicker {
      footer {
        actions {
          confirm {
            connections[0].target: threadDraftSelected
          }

          cancel {
            connections[0].target: threadDraft
          }
        }
      }

      content {
        nativePicker {
          connections[0].target: threadLocation
        }

        path {
          value {
            contents: "~/src/reconnect-checks"
          }
        }
      }
    }
  }
}

threadDraftSelected = frame : lists.threadsPage {
  title: "Desktop / Thread selected folder draft",
  caption: "Keep the draft and model; use the newly selected local folder for the first message.",
  left: 1728px,
  top: 2160px,

  main {
    compose {
      composer {
        toolbar {
          lead {
            location {
              connections[0].target: threadLocationSelected,

              label {
                contents: "reconnect-checks · MacBook Pro"
              }
            }
          }
        }

        prompt {
          contents: "Review the reconnect logs."
        }
      }
    }
  }
}

threadDraft = frame : lists.threadsPage {
  title: "Desktop / Thread draft",
  caption: "The location control opens folder selection. Desktop entries disappear for remote devices and missing capabilities; browser screens stay unchanged.",
  left: 0px,
  top: 2160px,

  main {
    compose {
      composer {
        toolbar {
          lead {
            location {
              connections[0].target: threadLocation
            }
          }
        }

        prompt {
          contents: "Review the reconnect logs."
        }
      }
    }
  }
}
