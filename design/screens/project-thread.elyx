import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "blocks/project-page.elyx" as page
import "blocks/project-header.elyx" as headers
import "blocks/thread-line.elyx" as lines
import "blocks/attention-card.elyx" as attention
import "blocks/thread-detail.elyx" as details

threadOpen = frame : page.projectPage {
  title: "Project · Thread 详情",
  caption: "点主对话里的 Thread 记录或概览里的 Thread 行，Thread 在右侧打开，替换概览栏，主对话不跳走。事项同时显示在主对话和关联的 Thread 里，在任何一处处理都会同步。选中回复里的文字可以带着引用问 Project Agent。",
  left: 0px,
  top: 0px,
  overrides: [
    insert(detail, after = page.projectPage.main),
    remove(page.projectPage.overview)
  ],

  main {
    dock {
      signals {
        attention {
          count {
            contents: "2"
          }
        }

        running {
          count {
            contents: "1"
          }
        }

        display: .visible
      }
    }

    transcript {
      overrides: [
        insert(decision, after = page.projectPage.main.transcript.agent1),
        remove(page.projectPage.main.transcript.typing)
      ],

      agent1 {
        @with-variant(lines.threadCardIdle)
        work {
          cardRows {
            @with-variant(lines.threadLineSelected)
            row1 {}
          }
        }
      }
    }

    @with-variant(headers.headerIdle)
    header {
      trail {
        overview {
          fill[0].color: c.colors.transparent,

          glyph {
            fill[0].color: c.colors.muted
          }
        }
      }

      lead {
        state {
          stateText {
            contents: "空闲"
          }
        }
      }

      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }
          }
        }
      }

      nav {
        navDevices {
          trail {
            note {
              display: .none
            }
          }
        }
      }
    }
  }

  detail = frame : details.threadDetail {
    overrides: [insert(ask, after = details.threadDetail.footer)],

    body {
      reply1 {
        @with-variant(details.threadTraceOpen)
        trace {}
      }
    }

    ask = frame : details.selectionMenu {
      left: 150px,
      top: 426px,
      ignore-stack: .true
    }
  }

  decision = frame : attention.attentionCard {
    width: 100%,
    max-width: s.size.measure,
    overrides: [
      remove(attention.attentionCard.footer),
      remove(attention.attentionCard.summary),
      remove(attention.attentionCard.threadRef)
    ],

    head {
      time {
        display: .none
      }
    }

    options {
      third {
        label {
          contents: "再跑一次"
        }
      }

      second {
        label {
          contents: "先跳过"
        }
      }

      first {
        label {
          contents: "找出原因并修好"
        }
      }
    }

    heading {
      contents: "1 项测试没通过，下一步怎么做？"
    }
  }
}

threadRunning = frame : page.projectPage {
  title: "Project · Thread 执行中",
  caption: "用户在 Thread 里直接给 Codex 发消息，开启新的一轮；Project Agent 不会收到通知。实时输出显示这一轮已过的时间。执行中再发的消息默认排队，发出前可以撤回；Codex 支持插入。可以停止这一轮。",
  left: 1728px,
  top: 0px,
  overrides: [
    insert(detail, after = page.projectPage.main),
    remove(page.projectPage.overview)
  ],

  main {
    dock {
      signals {
        display: .visible
      }
    }

    transcript {
      overrides: [remove(page.projectPage.main.transcript.typing)],

      agent1 {
        work {
          cardRows {
            row1 {
              fill[0].color: c.colors.selected
            }
          }
        }
      }
    }

    @with-variant(headers.headerIdle)
    header {
      trail {
        overview {
          fill[0].color: c.colors.transparent,

          glyph {
            fill[0].color: c.colors.muted
          }
        }
      }

      lead {
        state {
          stateText {
            contents: "空闲"
          }
        }
      }

      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }
          }
        }
      }

      nav {
        navDevices {
          trail {
            note {
              display: .none
            }
          }
        }
      }
    }
  }

  detail = frame : details.threadDetailRunning {}
}
