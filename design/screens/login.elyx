use "resources/fonts/Inter-Medium.otf"
use "resources/fonts/Inter-SemiBold.otf"
use "resources/fonts/Inter-Regular.otf"

import "foundations/typography.elyx" as t
import "controls/input.elyx" as inputs
import "blocks/login-shell.elyx" as auth

login = frame : auth.loginPage {
  left: 0px,
  top: 0px,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in"
      }
    }
  }
}

loginError = frame : auth.loginPage {
  title: "Sign in / Invalid credentials",
  caption: "The same message covers an incorrect username or password.",
  left: 1728px,
  top: 0px,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in"
      }

      secret {
        @with-variant(t.captionDanger)
        helper {
          display: .visible,
          contents: "Invalid username or password."
        }

        @with-variant(inputs.error)
        input {
          @with-variant(t.small)
          value {
            contents: "••••••••"
          }
        }
      }
    }
  }
}

loginReset = frame : auth.loginPage {
  title: "Sign in / Password reset",
  caption: "Sign in again with the password provided by your administrator.",
  left: 3456px,
  top: 0px,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in"
      }

      secret {
        input {
          value {
            contents: "New password"
          }
        }
      }
    }

    notice {
      display: .visible
    }
  }
}

loginSubmitting = frame : auth.loginPage {
  title: "Sign in / Signing in",
  caption: "Keep the username while sign-in is checked.",
  left: 0px,
  top: 1080px,
  connections[0].label: "Invalid credentials",
  connections[0].target: loginError,
  connections[1].label: "Session expired",
  connections[1].target: loginExpired,
  connections[2].label: "Password reset",
  connections[2].target: loginReset,
  connections[3].label: "Can't reach Baton",
  connections[3].target: loginUnavailable,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in",

        label {
          contents: "Signing in…"
        }
      }
    }
  }
}

loginExpired = frame : auth.loginPage {
  title: "Sign in / Session expired",
  caption: "Sign in again to return to your workspace.",
  left: 1728px,
  top: 1080px,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in"
      }

      secret {
        input {
          value {
            contents: "Password"
          }
        }
      }
    }

    notice {
      noticeDetail {
        display: .none
      }

      noticeHeading {
        contents: "Your sign-in expired"
      }

      display: .visible
    }
  }
}

loginSignedOut = frame : auth.signedOutPage {
  left: 3456px,
  top: 1080px,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in"
      }
    }
  }
}

loginUnavailable = frame : auth.loginPage {
  title: "Sign in / Connection unavailable",
  caption: "Keep the form and retry when Baton is reachable.",
  left: 5184px,
  top: 1080px,

  column {
    card {
      submit {
        connections[0].target: loginSubmitting,
        connections[0].label: "Sign in",

        label {
          contents: "Try signing in again"
        }
      }
    }

    notice {
      noticeDetail {
        display: .none
      }

      noticeHeading {
        contents: "Can't reach Baton"
      }

      display: .visible
    }
  }
}
