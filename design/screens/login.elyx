import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/input.elyx" as inputs
import "controls/field.elyx" as fields

login = frame {
  title: "Sign in",
  caption: "Sign in with the account provided by your administrator.",
  left: 0px,
  top: 0px,
  width: s.size.screenWidth,
  height: s.size.screenHeight,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.canvas,
  children: column,

  column = frame {
    width: 360px,
    layout: {direction: .column, align-items: .center, item-gap: s.space.xl},
    children: [brand, notice, card, note],

    brand = frame {
      layout: {direction: .column, align-items: .center, item-gap: s.space.md},
      children: [mark, heading],

      mark = frame {
        width: 36px,
        height: 36px,
        layout: {justify-content: .center, align-items: .center},
        fill: c.colors.text,
        corner-radius: 9px,
        children: markLetter,

        markLetter = text : t.heading {
          contents: "B",
          font-size: 18,
          font-style: "Semibold",
          line-height: 1,
          fill[0].color: c.colors.surface
        }
      }

      heading = text : t.title {
        contents: "Sign in to Baton"
      }
    }

    notice = frame {
      width: 100%,
      display: .none,
      layout: {direction: .column, item-gap: s.space.xxs},
      fill: c.colors.panel,
      border: c.colors.borderSoft,
      corner-radius: 10px,
      padding: [10px, 14px],
      children: [noticeHeading, noticeDetail],

      noticeHeading = text : t.label {
        contents: "Password reset by administrator"
      }

      noticeDetail = text : t.caption {
        width: 100%,
        contents: "Previous sessions have been signed out. Sign in with your new password.",
        fill[0].color: c.colors.muted
      }
    }

    card = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      fill: c.colors.surface,
      border: c.colors.hairline,
      shadow: [
        {
          drop-shadow: {
            color: rgb(0%, 0%, 0%, 4%),
            offset: point(0px, 1px),
            blur-radius: 2px
          }
        },
        {
          drop-shadow: {
            color: rgb(0%, 0%, 0%, 4%),
            offset: point(0px, 8px),
            blur-radius: 24px
          }
        }
      ],
      corner-radius: 14px,
      padding: s.space.xl,
      children: [account, secret, submit],

      account = frame : fields.field {
        width: 100%,

        helper {
          display: .none
        }

        @with-variant(inputs.filled)
        input {
          value {
            contents: "chen.lin"
          }

          top: .nil
        }

        label {
          labelText {
            contents: "Username"
          }
        }
      }

      secret = frame : fields.field {
        width: 100%,

        helper {
          display: .none
        }

        @with-variant(inputs.filled)
        input {
          value {
            contents: "••••••••••••"
          }

          top: .nil
        }

        label {
          labelText {
            contents: "Password"
          }
        }
      }

      submit = frame : buttons.button {
        width: 100%,

        label {
          contents: "Sign in"
        }
      }
    }

    note = text : t.caption {
      contents: "Contact your administrator if you need an account or password reset.",
      fill[0].color: c.colors.faint
    }
  }
}

loginError = frame : login {
  title: "Sign in / Invalid credentials",
  caption: "The same message covers an incorrect username or password.",
  left: 1728px,
  top: 0px,

  column {
    card {
      secret {
        helper {
          fill[0].color: c.colors.danger,
          display: .visible,
          contents: "Invalid username or password."
        }

        @with-variant(inputs.error)
        input {
          value {
            fill[0].color: c.colors.text,
            contents: "••••••••"
          }
        }
      }
    }
  }
}

loginReset = frame : login {
  title: "Sign in / Password reset",
  caption: "Sign in again with the password provided by your administrator.",
  left: 3456px,
  top: 0px,

  column {
    card {
      secret {
        input {
          value {
            fill[0].color: c.colors.faint,
            contents: "New password"
          }
        }
      }
    }

    notice {
      display: .visible
    }
  }
}
