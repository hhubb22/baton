import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "blocks/project-page.elyx" as page
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "blocks/project-header.elyx" as headers
import "blocks/overview.elyx" as overviews
import "controls/input.elyx" as inputs
import "blocks/dialog.elyx" as dialogs
import "controls/field.elyx" as fields
import "controls/label.elyx" as labels

settings = frame : page.projectPage {
  title: "Project settings",
  caption: "Open Project settings from the header menu. Changes save automatically; the model applies next run.",
  left: 0px,
  top: 0px,
  overrides: [insert(scrim, after = page.projectPage.overview)],

  main {
    dock {
      composer {
        toolbar {
          send {
            fill[0].color: c.colors.subtle,

            sendGlyph {
              fill[0].color: c.colors.text
            }
          }
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      width: 560px,

      footer {
        actions {
          overrides: [remove(dialogs.dialog.footer.actions.cancel)],

          @with-variant(buttons.secondary)
          confirm {
            label {
              contents: "Done"
            }
          }
        }

        note {
          contents: "Saved"
        }
      }

      content {
        overrides: [
          insert(general, after = .nil),
          insert(agent, after = general),
          insert(lifecycle, after = agent),
          remove(dialogs.dialog.content.message)
        ],
        layout.item-gap: s.space.xl
      }

      heading {
        contents: "Baton Dev · settings"
      }

      general = frame {
        width: 100%,
        layout: {direction: .column, item-gap: s.space.lg},
        children: [titleField, goalField],

        titleField = frame : fields.field {
          width: 100%,

          helper {
            display: .none
          }

          @with-variant(inputs.filled)
          input {
            top: .nil
          }
        }

        goalField = frame : fields.optionalText {
          width: 100%,

          input {
            value {
              fill[0].color: c.colors.text,
              contents: "Milestone 1: run real work end-to-end across devices and return replies with attachments."
            }

            height: 64px
          }

          helper {
            contents: "The project assistant reads goal changes with your next message."
          }
        }
      }

      agent = frame {
        width: 100%,
        layout: {direction: .column, item-gap: 6px},
        border: {color: c.colors.borderSoft, sides: .top},
        padding: [s.space.lg, 0px, 0px],
        children: [agentLabel, agentRow, agentHelp],

        agentLabel = frame : labels.label {
          labelText {
            contents: "Project assistant model"
          }
        }

        agentRow = frame {
          width: 100%,
          layout: {item-gap: s.space.sm},
          children: [subscription, model],

          subscription = frame : inputs.select {
            width: 100%,

            value {
              contents: "ChatGPT subscription"
            }
          }

          model = frame : inputs.select {
            width: 100%,

            value {
              contents: "gpt-5.1"
            }
          }
        }

        agentHelp = text : t.caption {
          width: 100%,
          contents: "Applies to the next run. The current run on Ubuntu Dev keeps its model.",
          fill[0].color: c.colors.muted
        }
      }

      lifecycle = frame {
        width: 100%,
        layout: {direction: .column, item-gap: s.space.md},
        border: {color: c.colors.borderSoft, sides: .top},
        padding: [s.space.lg, 0px, 0px],
        children: [pauseRow, archiveRow],

        pauseRow = frame : dialogs.settingRow {
          action {
            connections[0].target: pausedSettings
          }
        }

        archiveRow = frame : dialogs.settingRow {
          action {
            connections[0].target: archiveConfirm,

            label {
              fill[0].color: c.colors.danger,
              contents: "Archive"
            }

            @with-variant(icons.archive)
            lead {
              fill[0].color: c.colors.danger
            }
          }

          copy {
            rowText {
              contents: "Stops the project assistant and withdraws open questions. Chats and memory are kept. Existing threads continue."
            }

            rowTitle {
              contents: "Archive project"
            }
          }
        }
      }
    }
  }
}

archiveConfirm = frame : page.projectPage {
  title: "Archive confirmation",
  caption: "Archive project replaces settings with this confirmation. Existing threads keep working.",
  left: 1728px,
  top: 0px,
  overrides: [insert(scrim, after = page.projectPage.overview)],

  main {
    dock {
      composer {
        toolbar {
          send {
            fill[0].color: c.colors.subtle,

            sendGlyph {
              fill[0].color: c.colors.text
            }
          }
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      footer {
        actions {
          confirm {
            connections[0].target: archiving
          }

          cancel {
            connections[0].target: settings
          }
        }
      }

      content {
        message {
          contents: "Stops the project assistant and withdraws 1 open question. Chats and memory are kept. Existing threads continue."
        }
      }

      heading {
        contents: "Archive “Baton Dev”?"
      }
    }
  }
}

saving = frame : settings {
  title: "Project settings / Saving",
  caption: "Editing a field starts autosave. Keep the draft visible until saved.",
  left: 0px,
  top: 1080px,

  scrim {
    form {
      content {
        general {
          titleField {
            input {
              value {
                contents: "Baton Release"
              }
            }
          }
        }
      }

      footer {
        note {
          contents: "Saving…"
        }
      }
    }
  }
}

saveFailed = frame : settings {
  title: "Project settings / Save failed",
  caption: "Autosave failed. The edited name stays in the form; Retry saves it again.",
  left: 1728px,
  top: 1080px,

  scrim {
    form {
      content {
        general {
          titleField {
            helper {
              fill[0].color: c.colors.danger,
              contents: "Name not saved. Baton could not be reached. Retry to save your changes.",
              display: .visible
            }

            input {
              value {
                contents: "Baton Release"
              }
            }
          }
        }
      }

      footer {
        note {
          fill[0].color: c.colors.danger,
          contents: "Changes not saved"
        }

        actions {
          overrides: [insert(retry, after = .nil)]
        }
      }
    }
  }

  retry = frame : buttons.button {
    connections[0].target: saving,

    label {
      contents: "Retry"
    }
  }
}

saved = frame : settings {
  title: "Project settings / Saved",
  caption: "After autosave, the new name appears in the header and sidebar.",
  left: 3456px,
  top: 1080px,

  main {
    header {
      lead {
        identity {
          name {
            contents: "Baton Release"
          }
        }
      }
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          lead {
            name {
              contents: "Baton Release"
            }
          }
        }
      }
    }
  }

  scrim {
    form {
      heading {
        contents: "Baton Release · settings"
      }

      content {
        general {
          titleField {
            input {
              value {
                contents: "Baton Release"
              }
            }
          }
        }
      }

      footer {
        note {
          contents: "Saved"
        }
      }
    }
  }
}

pausedSettings = frame : settings {
  title: "Project settings / Paused",
  caption: "Pause keeps messages and question replies saved. Resume makes them available to the assistant.",
  left: 0px,
  top: 2160px,

  scrim {
    form {
      content {
        lifecycle {
          pauseRow {
            action {
              connections[0].target: resumedSettings,

              label {
                contents: "Resume"
              }
            }

            copy {
              rowText {
                contents: "3 inputs are saved. Threads and questions remain available. Resume to process the saved inputs."
              }

              rowTitle {
                contents: "Project is paused"
              }
            }
          }
        }
      }
    }
  }

  overview {
    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.muted,
                contents: "Paused"
              }

              @with-variant(status.dotIdle)
              runtimeDot {}
            }

            runtimeDevice {
              display: .none
            }
          }

          runtimeNote {
            contents: "3 inputs saved until you resume."
          }
        }
      }
    }
  }

  main {
    transcript {
      overrides: [remove(page.projectPage.main.transcript.typing)]
    }

    @with-variant(headers.headerPaused)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }

            paused {
              display: .visible
            }
          }
        }
      }
    }
  }
}

resumedSettings = frame : settings {
  title: "Project settings / Resumed",
  caption: "Resume lets the assistant process saved inputs. Done returns to the main conversation.",
  left: 1728px,
  top: 2160px,

  scrim {
    form {
      content {
        lifecycle {
          pauseRow {
            copy {
              rowText {
                contents: "Project resumed. The assistant can now process the 3 saved inputs on an available device."
              }
            }
          }
        }
      }
    }
  }
}

archiving = frame : archiveConfirm {
  title: "Project / Archiving",
  caption: "Archive waits for confirmation before showing the read-only project.",
  left: 3456px,
  top: 2160px,

  scrim {
    form {
      footer {
        note {
          contents: "Archiving…"
        }

        actions {
          confirm {
            label {
              contents: "Archiving…"
            }
          }
        }
      }
    }
  }
}

archiveFailed = frame : archiveConfirm {
  title: "Project / Archive failed",
  caption: "If the archive request cannot be saved, retry from the confirmation.",
  left: 0px,
  top: 3240px,

  scrim {
    form {
      footer {
        note {
          fill[0].color: c.colors.danger,
          contents: "Baton could not save the archive request. Try again."
        }

        layout.direction: .column,
        layout.align-items: .end,

        actions {
          confirm {
            label {
              contents: "Try again"
            }
          }
        }
      }
    }
  }
}

archivedSettings = frame : settings {
  title: "Archived project / Settings",
  caption: "Open settings from an archived project's menu. Values remain readable; Done returns to its records.",
  left: 1728px,
  top: 3240px,

  scrim {
    form {
      content {
        agent {
          agentRow {
            model {
              border[0].width: 0px,

              chevron {
                display: .none
              }
            }

            subscription {
              border[0].width: 0px,

              chevron {
                display: .none
              }
            }
          }

          agentHelp {
            contents: "Project assistant stopped. Existing threads remain available."
          }
        }

        general {
          goalField {
            input {
              border[0].width: 0px
            }

            helper {
              contents: "Project settings are read-only while archived."
            }
          }

          titleField {
            input {
              border[0].width: 0px
            }
          }
        }

        lifecycle {
          display: .none
        }
      }

      footer {
        note {
          contents: "Read-only · project archived"
        }
      }

      heading {
        contents: "Baton Dev · archived"
      }
    }
  }

  overview {
    body {
      overrides: [
        remove(overviews.overview.body.needsHead),
        remove(overviews.overview.body.needsRow)
      ]
    }

    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.muted,
                contents: "Archived"
              }

              @with-variant(status.dotIdle)
              runtimeDot {}
            }

            runtimeDevice {
              display: .none
            }
          }

          runtimeNote {
            contents: "Project assistant stopped. 1 question withdrawn."
          }
        }
      }

      goal {
        goalHead {
          goalEdit {
            display: .none
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [remove(page.projectPage.main.dock.composer)]
    }

    transcript {
      overrides: [remove(page.projectPage.main.transcript.typing)]
    }

    @with-variant(headers.headerIdle)
    header {
      lead {
        state {
          stateText {
            contents: "Archived"
          }
        }
      }

      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }
          }
        }
      }

      nav {
        navInbox {
          trail {
            count {
              value {
                contents: "2"
              }
            }
          }
        }
      }
    }
  }
}
