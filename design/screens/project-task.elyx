import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "blocks/project-page.elyx" as page
import "blocks/project-header.elyx" as headers
import "blocks/conversation.elyx" as conv
import "blocks/task-card.elyx" as cards
import "blocks/attention-card.elyx" as attention
import "blocks/task-detail.elyx" as details

taskOpen = frame : page.projectPage {
  title: "Project · 任务详情",
  caption: "点任务卡片或概览里的任务行，详情在右侧打开，替换概览栏，主对话不跳走。事项同时显示在主对话和任务详情里，在任何一处处理都会同步。",
  left: 0px,
  top: 0px,
  overrides: [
    insert(detail, after = page.projectPage.main),
    remove(page.projectPage.overview)
  ],

  main {
    dock {
      composer {
        width: 560px,
        corner-radius: 16px,
        border[0].color: c.colors.borderSoft
      }

      padding-bottom: s.space.xl
    }

    transcript {
      overrides: [
        insert(decisionRow, after = page.projectPage.main.transcript.agent1),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.agent2),
        remove(page.projectPage.main.transcript.task2),
        remove(page.projectPage.main.transcript.task1),
        remove(page.projectPage.main.transcript.memory1),
        remove(page.projectPage.main.transcript.command1),
        remove(page.projectPage.main.transcript.user2),
        remove(page.projectPage.main.transcript.day)
      ],

      agent1 {
        overrides: [
          insert(activity, after = conv.agentTurn.content),
          insert(dispatched, after = activity)
        ],

        content {
          contents: "好，先跑一遍。"
        }

        head {
          time {
            contents: "14:02"
          }
        }
      }

      user1 {
        bubble {
          content {
            contents: "PS-160 的验收先在 Windows 上跑重连测试，结果出来告诉我。"
          }
        }
      }
    }

    @with-variant(headers.headerIdle)
    header {
      trail {
        overview {
          fill[0].color: c.colors.transparent,

          glyph {
            fill[0].color: c.colors.muted
          }
        }
      }

      lead {
        state {
          stateText {
            contents: "空闲"
          }
        }
      }

      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }
          }
        }
      }

      nav {
        navDevices {
          trail {
            note {
              display: .none
            }
          }
        }
      }
    }
  }

  activity = frame : conv.activityLog {
    width: 100%
  }

  decisionRow = frame {
    width: s.size.measure,
    layout: {direction: .row},
    children: decision
  }

  dispatched = frame : cards.taskLineSelected {
    width: 100%,
    fill[0].color: c.colors.hover
  }

  detail = frame : details.taskDetail {
    footer {
      overrides: [remove(details.taskDetail.footer.rerun)]
    }

    body {
      overrides: [
        insert(facts, after = details.taskDetail.body.intro),
        insert(technical, after = details.taskDetail.body.related),
        remove(details.taskDetail.body.artifacts),
        remove(details.taskDetail.body.verify),
        remove(details.taskDetail.body.meta)
      ],

      related {
        item {
          padding-left: 0px,
          padding-right: 0px,
          fill[0].color: c.colors.transparent,

          itemState {
            display: .none
          }

          itemLead {
            itemTitle {
              contents: "1 项测试没通过，下一步怎么做？"
            }
          }
        }

        label {
          contents: "等你决定"
        }
      }

      evidence {
        evidenceB {
          corner-radius: 0px,
          padding-left: 0px,
          padding-right: 0px,
          border[0].visible: .false,

          copy {
            note {
              contents: "MacBook Pro · 离线"
            }

            path {
              contents: "macos-reconnect.log",
              font-size: 13,
              font-family: "PingFang SC"
            }
          }
        }

        evidenceA {
          corner-radius: 0px,
          padding-left: 0px,
          padding-right: 0px,
          border[0].sides: .bottom,

          action {
            contents: "查看"
          }

          copy {
            note {
              contents: "Windows 台式机 · 48 KiB"
            }

            path {
              contents: "reconnect.log",
              font-size: 13,
              font-family: "PingFang SC"
            }
          }
        }

        label {
          contents: "附件"
        }
      }

      result {
        overrides: [remove(details.taskDetail.body.result.errorBox)],

        content {
          contents: "48 项中 47 项通过。TestReconnectAfterSleep 在睡眠唤醒后没有重新连上。"
        }
      }

      intro {
        line {
          origin {
            contents: "Windows 台式机 · 用时 28 分钟"
          }
        }
      }
    }

    head {
      tools {
        overrides: [
          insert(more, after = details.taskDetail.head.tools.external)
        ]
      }
    }

    more = frame : buttons.iconButton {}

    technical = frame {
      width: 100%,
      height: 32px,
      layout: {justify-content: .space-between, align-items: .center},
      border: {color: c.colors.borderSoft, sides: .top},
      padding: [s.space.sm, 0px, 0px],
      children: [technicalLabel, technicalGlyph],

      technicalLabel = text : t.small {
        contents: "执行细节",
        fill[0].color: c.colors.muted
      }

      technicalGlyph = asset : icons.chevronRight {
        width: 14px,
        height: 14px,
        fill[0].color: c.colors.faint
      }
    }

    facts = text : t.small {
      width: 100%,
      contents: "完成标准：重连测试全部通过。",
      fill[0].color: c.colors.muted
    }
  }

  decision = frame : attention.attentionCard {
    width: 480px,
    corner-radius: s.radius.lg,
    border[0].color: c.colors.borderSoft,
    overrides: [
      remove(attention.attentionCard.footer),
      remove(attention.attentionCard.taskRef),
      remove(attention.attentionCard.summary)
    ],

    options {
      third {
        corner-radius: 0px,
        padding-left: 0px,
        padding-right: 0px,
        border[0].visible: .false,

        label {
          contents: "再跑一次"
        }
      }

      second {
        corner-radius: 0px,
        padding-left: 0px,
        padding-right: 0px,
        border[0].color: c.colors.borderSoft,
        border[0].sides: .bottom,

        label {
          contents: "先跳过"
        }
      }

      first {
        corner-radius: 0px,
        padding-left: 0px,
        padding-right: 0px,
        border[0].color: c.colors.borderSoft,
        border[0].sides: .bottom,

        label {
          contents: "找出原因并修好"
        }
      }
    }

    head {
      time {
        display: .none
      }
    }

    heading {
      contents: "1 项测试没通过，下一步怎么做？",
      font-size: 14
    }
  }
}
