import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "blocks/inbox-page.elyx" as pages
import "blocks/attention-card.elyx" as attention

inbox = frame : pages.inboxPage {
  title: "Inbox / Pending",
  caption: "Details start collapsed. Scroll the list; Handled items stays in the header. Browser tab: Baton (3).",
  left: 0px,
  top: 0px,

  main {
    head {
      handled {
        connections[0].target: ::handled,
        connections[0].label: "Handled items"
      }
    }
  }
}

empty = frame : pages.inboxPage {
  title: "Inbox / Nothing waiting",
  caption: "The last handled item leaves Inbox. Its card remains in the main chat and linked thread; open Handled items for the record. Browser tab: Baton.",
  left: 1760px,
  top: 0px,

  main {
    head {
      handled {
        connections[0].target: ::handled,
        connections[0].label: "View past decisions"
      }
    }

    content {
      item3 {
        display: .none
      }

      item2 {
        display: .none
      }

      item1 {
        display: .none
      }

      intro {
        introCount {
          display: .none
        }

        introText {
          contents: "All caught up"
        }
      }

      notice {
        display: .visible
      }
    }
  }

  sidebar {
    top {
      projects {
        projCompat {
          trail {
            count {
              display: .none
            }
          }
        }

        projBaton {
          trail {
            count {
              display: .none
            }

            live {
              display: .none
            }
          }
        }
      }

      nav {
        navInbox {
          trail {
            count {
              display: .none
            }
          }
        }
      }
    }
  }
}

loadFailed = frame : pages.inboxPage {
  title: "Inbox / Loading failed",
  caption: "Keep the last known pending count while the connection is unavailable. Try again reloads the list; it never shows an empty success state.",
  left: 3520px,
  top: 0px,

  main {
    content {
      notice {
        retry {
          connections[0].target: ::inbox,
          connections[0].label: "Try again",
          display: .visible
        }

        explanation {
          contents: "Check your connection. Past decisions are still saved in your chats."
        }

        noticeTitle {
          contents: "Could not load inbox"
        }

        display: .visible
      }

      item3 {
        display: .none
      }

      item2 {
        display: .none
      }

      item1 {
        display: .none
      }

      intro {
        introCount {
          display: .none
        }

        introText {
          contents: "Inbox unavailable"
        }
      }
    }

    head {
      handled {
        connections[0].target: ::handled,
        connections[0].label: "Handled items"
      }
    }
  }
}

handled = frame : pages.inboxPage {
  title: "Inbox / Handled items",
  caption: "Read past answers, closes, withdrawals, and resolutions here. Open the project name or linked chat for context. Browser tab: Baton.",
  left: 0px,
  top: 1120px,

  main {
    content {
      overrides: [
        insert(closedItem, after = pages.inboxPage.main.content.item3)
      ],

      @with-variant(attention.attentionWithdrawn)
      item3 {
        border[0].color: c.colors.borderSoft,
        border[0].sides: .bottom,

        head {
          kind {
            mark {
              display: .none
            }

            project {
              display: .visible
            }
          }

          time {
            contents: "Yesterday"
          }
        }

        answer {
          answerText {
            contents: "Withdrawn by the project assistant · Yesterday 22:15"
          }
        }

        padding-top: s.space.xl,
        padding-bottom: s.space.xl
      }

      @with-variant(attention.systemResolved)
      item2 {
        border[0].color: c.colors.borderSoft,
        border[0].sides: .bottom,

        resultNote {
          display: .none
        }

        footer {
          display: .none
        }

        head {
          kind {
            mark {
              display: .none
            }
          }

          time {
            contents: "15:24"
          }
        }

        padding-top: s.space.xl,
        padding-bottom: s.space.xl
      }

      @with-variant(attention.attentionAnsweredPaused)
      item1 {
        border[0].color: c.colors.borderSoft,
        border[0].sides: .bottom,

        resultNote {
          display: .none
        }

        head {
          kind {
            mark {
              display: .none
            }

            project {
              display: .visible
            }
          }

          time {
            contents: "16:00"
          }
        }

        answer {
          answerText {
            contents: "Bundle the certificate and retest · Kaken He · 16:00"
          }
        }

        padding-top: s.space.xl,
        padding-bottom: s.space.xl
      }

      intro {
        introCount {
          contents: "Most recent first"
        }

        introText {
          contents: "Past decisions"
        }
      }
    }

    head {
      handled {
        connections[0].target: ::inbox,
        connections[0].label: "Back to inbox",

        label {
          contents: "Back to inbox"
        }
      }

      headTitle {
        contents: "Handled items"
      }
    }
  }

  sidebar {
    top {
      projects {
        projCompat {
          trail {
            count {
              display: .none
            }
          }
        }

        projBaton {
          trail {
            count {
              display: .none
            }

            live {
              display: .none
            }
          }
        }
      }

      nav {
        navInbox {
          trail {
            count {
              display: .none
            }
          }
        }
      }
    }
  }

  closedItem = frame : attention.attentionClosed {
    width: 100%,
    padding-top: s.space.xl,
    padding-left: 0px,
    padding-bottom: s.space.xl,
    padding-right: 0px,
    border[0].color: c.colors.borderSoft,
    border[0].sides: .bottom,

    threadRef {
      display: .none
    }

    head {
      kind {
        mark {
          display: .none
        }

        project {
          display: .visible
        }
      }

      time {
        contents: "Yesterday"
      }
    }

    heading {
      contents: "Should the Ubuntu report include debug logs?"
    }

    answer {
      answerText {
        contents: "Closed by Kaken He · Yesterday 20:15"
      }
    }
  }
}

compactReply = frame : pages.inboxPage {
  title: "Inbox / Reply at 1024 px",
  caption: "At 1024 px the sidebar and 720 px list fit without horizontal scrolling. The reply stays in the scrolling list; Handled items remains visible.",
  left: 1760px,
  top: 1120px,
  width: 1024px,

  main {
    content {
      @with-variant(attention.attentionReply)
      item1 {
        response {
          note {
            value {
              contents: "Include the intermediate certificate. Keep the installer logs."
            }
          }
        }

        head {
          kind {
            project {
              display: .visible
            }
          }
        }
      }
    }

    head {
      handled {
        connections[0].target: ::handled,
        connections[0].label: "Handled items"
      }
    }
  }
}

loading = frame : pages.inboxPage {
  title: "Inbox / Loading",
  caption: "Fetching the current list. Keep the last known count until it loads; questions are not marked handled by loading.",
  left: 3520px,
  top: 1120px,

  main {
    head {
      handled {
        connections[0].target: ::handled,
        connections[0].label: "Handled items"
      }
    }

    content {
      item3 {
        display: .none
      }

      item2 {
        display: .none
      }

      item1 {
        display: .none
      }

      intro {
        introCount {
          display: .none
        }

        introText {
          contents: "Loading inbox…"
        }
      }

      notice {
        explanation {
          contents: "Waiting for the latest questions and notices."
        }

        noticeTitle {
          contents: "Loading inbox…"
        }

        display: .visible
      }
    }
  }
}
