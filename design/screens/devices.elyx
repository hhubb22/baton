import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "blocks/sidebar.elyx" as sidebars
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "blocks/device-row.elyx" as rows
import "controls/toggle.elyx" as toggles
import "blocks/enroll-dialog.elyx" as enroll
import "blocks/dialog.elyx" as dialogs
import "blocks/device-feedback.elyx" as feedback

export devices = frame {
  title: "Devices",
  caption: "Manage connected computers, assistants, allowed folders, and command permissions.",
  left: 0px,
  top: 0px,
  width: s.size.screenWidth,
  height: s.size.screenHeight,
  layout: {direction: .row},
  fill: c.colors.canvas,
  children: [sidebar, main],

  sidebar = frame : sidebars.sidebar {
    top {
      projects {
        @with-variant(sidebars.projectRowLive)
        projBaton {}
      }

      nav {
        @with-variant(sidebars.navRowActive)
        navDevices {
          top: .nil
        }
      }
    }
  }

  main = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, align-items: .center},
    children: [head, content],

    head = frame {
      width: 100%,
      height: s.size.header,
      layout: {align-items: .center},
      border: {color: c.colors.borderSoft, sides: .bottom},
      padding: [0px, 20px],
      children: headTitle,

      headTitle = text : t.label {
        contents: "Devices",
        font-size: 14,
        font-style: "Semibold"
      }
    }

    content = frame {
      width: 800px,
      layout: {direction: .column, item-gap: s.space.lg},
      padding: [s.space.xxl, 0px],
      children: [intro, notice, list, empty],

      notice = frame : feedback.notice {
        display: .none
      }

      empty = frame : feedback.emptyDevices {
        display: .none,

        action {
          connections[0].target: devicesEnroll
        }
      }

      intro = frame {
        width: 100%,
        layout: {justify-content: .space-between, item-gap: s.space.xl},
        children: [introCopy, enroll],

        introCopy = frame {
          width: 100%,
          layout: {direction: .column, item-gap: s.space.xs},
          children: [introTitle, introText],

          introTitle = text : t.title {
            contents: "3 devices, 2 online"
          }

          introText = text : t.small {
            width: 100%,
            contents: "Connect the computers where your code lives. The project assistant uses your default device first, then another available computer.",
            fill[0].color: c.colors.muted
          }
        }

        enroll = frame : buttons.secondary {
          connections[0].target: devicesEnroll,

          label {
            contents: "Connect a device"
          }

          lead {
            display: .visible
          }
        }
      }

      list = frame {
        width: 100%,
        layout: {direction: .column},
        fill: c.colors.surface,
        border: c.colors.border,
        corner-radius: 10px,
        children: [mac, macDetail, windows, ubuntu, ubuntuDetail],

        mac = frame : rows.deviceOffline {
          width: 100%,
          border[0].color: c.colors.borderSoft,
          border[0].sides: .bottom,
          connections[0].label: "View offline device",
          connections[0].target: devicesOfflineView
        }

        macDetail = frame {
          width: 100%,
          display: .none,
          layout: {direction: .column, item-gap: 20px},
          fill: c.colors.panel,
          border: {color: c.colors.borderSoft, sides: .bottom},
          padding: [s.space.xs, s.space.lg, 20px, 60px],
          children: [macNotice, macActions],

          macNotice = frame : feedback.deviceNotice {
            width: 100%
          }

          macActions = frame {
            width: 100%,
            layout: {align-items: .center, item-gap: s.space.sm},
            children: [macDefault, macRevoke],

            macDefault = frame : buttons.smallSecondary {
              label {
                contents: "Default device"
              }
            }

            macRevoke = frame : buttons.smallGhost {
              connections[0].target: devicesDisconnect,

              label {
                fill[0].color: c.colors.danger,
                contents: "Disconnect device"
              }
            }
          }
        }

        windows = frame : rows.deviceRow {
          width: 100%,
          border[0].color: c.colors.borderSoft,
          border[0].sides: .bottom
        }

        ubuntu = frame : rows.deviceRuntime {
          width: 100%,
          fill[0].color: c.colors.panel
        }

        ubuntuDetail = frame {
          width: 100%,
          layout: {direction: .column, item-gap: 20px},
          fill: c.colors.panel,
          padding: [s.space.xs, s.space.lg, 20px, 60px],
          children: [deviceNotice, columns, exec, detailActions],

          deviceNotice = frame : feedback.deviceNotice {
            width: 100%,
            display: .none
          }

          columns = frame {
            width: 100%,
            layout: {item-gap: s.space.xxl},
            children: [agentsCol, dirsCol],

            agentsCol = frame {
              width: 100%,
              layout: {direction: .column, item-gap: s.space.sm},
              children: [
                agentsLabel,
                agentLine1,
                agentLine2,
                agentLine3,
                capabilityNote
              ],

              capabilityNote = text : t.caption {
                width: 100%,
                contents: "Codex 0.42 · GPT-5 (default), GPT-5 mini\nNew chat · send next · send now · stop\nResume chat · change model",
                fill[0].color: c.colors.muted
              }

              agentsLabel = text : t.captionMedium {
                contents: "Agents & subscriptions",
                fill[0].color: c.colors.faint
              }

              agentLine1 = frame : rows.capabilityLine {
                note {
                  contents: "Signed in · send now · resume chat"
                }
              }

              agentLine2 = frame : rows.capabilityLine {
                name {
                  contents: "Pi"
                }

                note {
                  contents: "Installed · send now · resume chat"
                }
              }

              agentLine3 = frame : rows.capabilityLine {
                width: 100%,

                name {
                  contents: "Project assistant"
                }

                note {
                  contents: "ChatGPT signed in"
                }
              }
            }

            dirsCol = frame {
              width: 100%,
              layout: {direction: .column, item-gap: s.space.sm},
              children: [dirsLabel, dir1, dir2, repos, dirsNote],

              dirsLabel = text : t.captionMedium {
                contents: "Allowed folders",
                fill[0].color: c.colors.faint
              }

              dir1 = text : t.mono {
                contents: "~/work/baton"
              }

              dir2 = text : t.mono {
                contents: "~/work/docs"
              }

              repos = text : t.caption {
                width: 100%,
                contents: "2 repositories discovered: baton, baton-docs",
                fill[0].color: c.colors.muted
              }

              dirsNote = text : t.caption {
                width: 100%,
                contents: "Manage these folders in the batond configuration on Ubuntu Dev.",
                fill[0].color: c.colors.faint
              }
            }
          }

          exec = frame {
            width: 100%,
            layout: {direction: .column, item-gap: 10px},
            fill: c.colors.surface,
            border: c.colors.borderSoft,
            corner-radius: s.radius.md,
            padding: [14px, s.space.lg],
            children: [execToggle, warning, permissionFeedback],

            permissionFeedback = text : t.caption {
              width: 100%,
              display: .none,
              contents: "Saving command permission…",
              fill[0].color: c.colors.muted
            }

            execToggle = frame : toggles.on {
              width: 100%,
              connections[0].label: "Change command permission",
              connections[0].target: devicesPermissionSaving,

              copy {
                helper {
                  contents: "Lets the project assistant run shell commands in allowed folders as user “kaken” (zsh). Commands can run for up to 2 hours."
                }
              }
            }

            warning = frame {
              width: 100%,
              layout: {item-gap: s.space.sm},
              fill: c.colors.attentionSoft,
              corner-radius: s.radius.sm,
              padding: [s.space.sm, 10px],
              children: [warnGlyph, warnText],

              warnGlyph = asset : icons.shield {
                width: 14px,
                height: 14px,
                fill[0].color: c.colors.attentionText
              }

              warnText = text : t.caption {
                width: 100%,
                contents: "Commands run directly on Ubuntu Dev without a sandbox. Baton does not inspect them.",
                fill[0].color: c.colors.attentionText
              }
            }
          }

          detailActions = frame {
            width: 100%,
            layout: {
              align-items: .center,
              item-gap: s.space.sm,
              wrap: .true,
              line-gap: 8px
            },
            children: [makeDefault, revoke, revokeNote],

            makeDefault = frame : buttons.smallSecondary {
              connections[0].target: devicesDefaultSaved,

              label {
                contents: "Set as default"
              }
            }

            revoke = frame : buttons.smallGhost {
              connections[0].target: devicesDisconnect,

              label {
                fill[0].color: c.colors.danger,
                contents: "Disconnect device"
              }
            }

            revokeNote = text : t.caption {
              width: 100%,
              display: .none,
              contents: "Removes this computer from Baton. If it is offline, agents still running on it will keep running locally. Past records are kept.",
              fill[0].color: c.colors.faint
            }
          }
        }
      }
    }
  }
}

export devicesEnroll = frame : devices {
  title: "Devices · Connect device",
  caption: "Choose a system, run the command, and paste the setup code.",
  left: 1728px,
  top: 0px,
  overrides: [insert(scrim, after = devices.main)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : enroll.enrollDialog {
      footer {
        actions {
          cancel {
            connections[0].target: devices
          }
        }
      }
    }
  }
}

devicesDisconnect = frame : devices {
  title: "Devices · Disconnect device",
  caption: "Confirm removal after reviewing what happens to local work and saved records.",
  left: 3456px,
  top: 0px,
  overrides: [insert(scrim, after = devices.main)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      footer {
        actions {
          confirm {
            connections[0].target: devicesDisconnecting,

            label {
              contents: "Disconnect device"
            }
          }

          cancel {
            connections[0].target: devices
          }
        }
      }

      content {
        message {
          contents: "Removes Ubuntu Dev from Baton. If it is offline, agents still running on it will keep running locally. Past chats and records are kept. This does not undo file changes or commands already run."
        }
      }

      heading {
        contents: "Disconnect “Ubuntu Dev”?"
      }
    }
  }
}

export devicesEmpty = frame : devices {
  title: "Devices / No devices",
  caption: "Connect a computer, then open Threads to start a chat.",
  left: 0px,
  top: 1080px,

  main {
    content {
      intro {
        enroll {
          display: .none
        }

        introCopy {
          introTitle {
            contents: "Your devices"
          }
        }
      }

      list {
        display: .none
      }

      empty {
        display: .visible
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "0 devices"
            }
          }
        }
      }
    }
  }
}

devicesSyncing = frame : devices {
  title: "Devices / Syncing",
  caption: "Connection is restored. Wait for device information before starting work.",
  left: 1728px,
  top: 1080px,

  main {
    content {
      list {
        ubuntu {
          state {
            stateText {
              fill[0].color: c.colors.muted,
              contents: "Syncing · last seen now"
            }

            @with-variant(status.dotQueued)
            mark {}
          }

          agents {
            contents: "Checking availability…"
          }
        }

        ubuntuDetail {
          exec {
            display: .none
          }

          columns {
            display: .none
          }

          deviceNotice {
            detail {
              contents: "Connected just now. Chats will wait until device information is up to date."
            }

            heading {
              contents: "Ubuntu Dev is syncing"
            }

            display: .visible
          }
        }
      }

      intro {
        introCopy {
          introTitle {
            contents: "3 devices · 1 online · 1 syncing"
          }
        }
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "1 online · 1 syncing"
            }
          }
        }
      }
    }
  }
}

devicesMissing = frame : devices {
  title: "Devices / Missing programs and sign-ins",
  caption: "Check setup on Ubuntu Dev; availability updates after the device reports again.",
  left: 3456px,
  top: 1080px,

  main {
    content {
      list {
        ubuntuDetail {
          columns {
            agentsCol {
              agentLine3 {
                note {
                  fill[0].color: c.colors.attentionText,
                  contents: "Not installed"
                }

                check {
                  display: .none
                }
              }

              agentLine2 {
                note {
                  fill[0].color: c.colors.attentionText,
                  contents: "Program not installed"
                }

                check {
                  display: .none
                }
              }

              agentLine1 {
                note {
                  fill[0].color: c.colors.attentionText,
                  contents: "ChatGPT sign-in expired"
                }

                check {
                  display: .none
                }
              }

              capabilityNote {
                contents: "Codex 0.42 · GPT-5 (default)\nNew chats unavailable until signed in.\nPi models unavailable until installed."
              }
            }
          }

          exec {
            display: .none
          }

          deviceNotice {
            detail {
              contents: "Sign in to ChatGPT for Codex, install Pi, and update Baton for the project assistant. Make these changes on Ubuntu Dev."
            }

            heading {
              contents: "Finish setup on Ubuntu Dev"
            }

            display: .visible
          }
        }

        ubuntu {
          agents {
            fill[0].color: c.colors.attentionText,
            contents: "Setup needed"
          }

          state {
            stateText {
              fill[0].color: c.colors.text,
              contents: "Online"
            }

            @with-variant(status.dotOnline)
            mark {}
          }
        }
      }
    }
  }
}

devicesDefaultOffline = frame : devicesDisconnect {
  title: "Devices / Choose offline default",
  caption: "Save an offline default after reviewing how new work waits or uses another device.",
  left: 0px,
  top: 2160px,

  scrim {
    form {
      footer {
        actions {
          cancel {
            connections[0].target: devicesOfflineSelect
          }

          confirm {
            fill[0].color: c.colors.accent,
            connections[0].target: devicesOfflineDefaultSaved,

            label {
              contents: "Save default device"
            }
          }
        }
      }

      heading {
        contents: "Use MacBook Pro as default?"
      }

      content {
        message {
          contents: "MacBook Pro is offline, last seen at 13:52. New chats on it wait until it reconnects. Projects can use another available computer. You can still save it as your default."
        }
      }
    }
  }

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        windows {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesOfflineDefaultSaved = frame : devices {
  title: "Devices / Offline default saved",
  caption: "MacBook Pro stays the default even while offline.",
  left: 1728px,
  top: 2160px,

  main {
    content {
      notice {
        action {
          display: .none
        }

        heading {
          contents: "Default device saved"
        }

        detail {
          contents: "MacBook Pro is your default device. It is offline; new chats on it wait until it reconnects."
        }

        display: .visible
      }
    }
  }
}

devicesDefaultSaved = frame : devices {
  title: "Devices / Default saved",
  caption: "The new default is used for the next chat and preferred for projects.",
  left: 3456px,
  top: 2160px,

  main {
    content {
      list {
        ubuntuDetail {
          detailActions {
            revoke {
              connections[0].target: devicesDefaultDisconnect
            }

            makeDefault {
              label {
                contents: "Default device"
              }
            }
          }
        }

        mac {
          connections[0].target: devicesOfflineSelect,

          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }

      notice {
        action {
          display: .none
        }

        heading {
          contents: "Default device saved"
        }

        detail {
          contents: "Ubuntu Dev is your default for new chats and the first choice for the project assistant."
        }

        display: .visible
      }
    }
  }
}

devicesPermissionSaving = frame : devices {
  title: "Devices / Saving permission",
  caption: "Keep the last saved setting visible until the change is saved.",
  left: 0px,
  top: 3240px,
  connections[0].label: "Saved",
  connections[0].target: devicesPermissionSaved,
  connections[1].label: "Could not save",
  connections[1].target: devicesPermissionFailed,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              display: .visible
            }
          }
        }
      }
    }
  }
}

devicesPermissionSaved = frame : devices {
  title: "Devices / Commands turned off",
  caption: "The switch changes after the permission is saved.",
  left: 1728px,
  top: 3240px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              display: .visible,
              contents: "Saved · command permission is off"
            }

            @with-variant(toggles.toggle)
            execToggle {
              connections[0].target: devicesPermissionEnabling,

              copy {
                helper {
                  contents: "Commands run as user “kaken” (zsh) in allowed folders. Turn on only if you allow direct access without a sandbox."
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesPermissionFailed = frame : devices {
  title: "Devices / Permission not saved",
  caption: "The previous setting stays active. Retry the change.",
  left: 3456px,
  top: 3240px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              fill[0].color: c.colors.attentionText,
              connections[0].target: devicesPermissionSaving,
              display: .visible,
              contents: "Could not save because Baton could not be reached. Commands are still allowed. Click the switch to try again."
            }
          }
        }
      }
    }
  }
}

devicesDisconnecting = frame : devicesDisconnect {
  title: "Devices / Disconnecting",
  caption: "Wait until new connections are blocked and the current connection is closed.",
  left: 0px,
  top: 4320px,
  connections[0].label: "Disconnected",
  connections[0].target: devicesDisconnected,
  connections[1].label: "Could not disconnect",
  connections[1].target: devicesDisconnectFailed,

  scrim {
    form {
      footer {
        actions {
          cancel {
            display: .none
          }

          confirm {
            label {
              contents: "Disconnecting…"
            }
          }
        }
      }

      content {
        message {
          contents: "Baton is blocking new connections and closing the current connection. Wait for confirmation before treating this device as disconnected."
        }
      }

      heading {
        contents: "Disconnecting Ubuntu Dev…"
      }
    }
  }
}

devicesDisconnectFailed = frame : devicesDisconnect {
  title: "Devices / Disconnect not confirmed",
  caption: "Keep the device listed until disconnection can be confirmed.",
  left: 1728px,
  top: 4320px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            connections[0].target: devicesDisconnecting,

            label {
              contents: "Retry disconnection"
            }
          }
        }
      }

      heading {
        contents: "Could not confirm disconnection"
      }

      content {
        message {
          contents: "Baton could not be reached while disconnecting Ubuntu Dev. Its connection may still be active. Check your connection, then retry to confirm removal."
        }
      }
    }
  }
}

devicesDisconnected = frame : devices {
  title: "Devices / Device disconnected",
  caption: "The removed device is gone from the list. Saved chats and records remain.",
  left: 3456px,
  top: 4320px,

  main {
    content {
      notice {
        action {
          display: .none
        }

        heading {
          contents: "Ubuntu Dev disconnected"
        }

        detail {
          contents: "Past chats and records are kept. If Ubuntu Dev was offline, its agents may still be running locally."
        }

        display: .visible
      }

      list {
        ubuntu {
          display: .none
        }

        ubuntuDetail {
          display: .none
        }
      }

      intro {
        introCopy {
          introTitle {
            contents: "2 devices, 1 online"
          }
        }
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "1/2 online"
            }
          }
        }
      }
    }
  }
}

devicesDefaultRemoved = frame : devicesDisconnected {
  title: "Devices / Default device removed",
  caption: "Removing the default clears it. Choose another device; Baton does not choose one for you.",
  left: 0px,
  top: 5400px,

  main {
    content {
      notice {
        action {
          connections[0].target: devicesReplacementSaved,
          display: .visible
        }

        detail {
          contents: "Ubuntu Dev was your default and has been removed. No replacement has been selected. Past chats and records are kept."
        }

        heading {
          contents: "Choose a new default device"
        }
      }

      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesReplacementSaved = frame : devicesDisconnected {
  title: "Devices / Replacement default saved",
  caption: "Windows Desktop becomes the default only after you choose it.",
  left: 1728px,
  top: 5400px,

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
