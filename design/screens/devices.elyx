use "resources/fonts/Inter-Medium.otf"
use "resources/fonts/Inter-Regular.otf"
use "resources/fonts/Inter-SemiBold.otf"

import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "resources/assets/backdrop-day-frost.jpg" as backdrop
import "foundations/typography.elyx" as t
import "blocks/sidebar.elyx" as sidebars
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "blocks/device-row.elyx" as rows
import "controls/toggle.elyx" as toggles
import "blocks/enroll-dialog.elyx" as enroll
import "blocks/dialog.elyx" as dialogs
import "blocks/device-feedback.elyx" as feedback

export devices = frame {
  title: "Devices",
  caption: "Manage connected computers, assistants, and command permissions. Folders are added when choosing a location for a new chat; Folders… removes them.",
  left: 0px,
  top: 0px,
  width: s.size.screenWidth,
  height: s.size.screenHeight,
  layout: {item-gap: s.size.gutter},
  fill: [{image: {ref: backdrop}}, c.colors.glass],
  padding: [s.size.gutter, s.size.gutter, s.size.gutter, 0px],
  children: [sidebar, main],

  sidebar = frame : sidebars.sidebar {
    height: 100%,

    top {
      projects {
        @with-variant(sidebars.projectRowLive)
        projBaton {}
      }

      nav {
        @with-variant(sidebars.navRowActive)
        navDevices {
          top: .nil
        }
      }
    }
  }

  main = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, align-items: .center},
    fill: c.colors.canvas,
    border: c.colors.hairline,
    shadow: [
      {
        drop-shadow: {
          color: c.colors.shadowNear,
          offset: point(0px, 1px),
          blur-radius: 3px
        }
      },
      {
        drop-shadow: {
          color: c.colors.shadowFar,
          offset: point(0px, 12px),
          blur-radius: 40px
        }
      }
    ],
    corner-radius: s.radius.lg,
    children: [head, content],

    head = frame {
      width: 100%,
      height: s.size.header,
      layout: {align-items: .center},
      border: {color: c.colors.borderSoft, sides: .bottom},
      padding: [0px, 20px],
      children: headTitle,

      headTitle = text : t.label {
        contents: "Devices",
        font-size: 14,
        font-style: "SemiBold"
      }
    }

    content = frame {
      width: 800px,
      layout: {direction: .column, item-gap: s.space.lg},
      padding: [s.space.xxl, 0px],
      children: [intro, notice, list, empty],

      notice = frame : feedback.notice {
        display: .none
      }

      empty = frame : feedback.emptyDevices {
        display: .none,

        action {
          connections[0].target: devicesEnroll
        }
      }

      intro = frame {
        width: 100%,
        layout: {justify-content: .space-between, item-gap: s.space.xl},
        padding: [0px, s.space.lg],
        children: [introCopy, enroll],

        introCopy = frame {
          width: 100%,
          layout: {direction: .column, item-gap: s.space.xs},
          children: [introTitle, introText],

          introTitle = text : t.title {
            contents: "3 devices, 2 online"
          }

          introText = text : t.small {
            width: 100%,
            display: .none,
            contents: "",
            fill[0].color: c.colors.muted
          }
        }

        enroll = frame : buttons.secondary {
          connections[0].target: devicesEnroll,

          label {
            contents: "Connect a device"
          }

          lead {
            display: .visible
          }
        }
      }

      list = frame {
        width: 100%,
        layout: {direction: .column},
        border: {color: c.colors.borderSoft, sides: .top},
        children: [mac, macDetail, windows, ubuntu, ubuntuDetail],

        mac = frame : rows.deviceOffline {
          width: 100%,
          border[0].color: c.colors.borderSoft,
          border[0].sides: .bottom,
          connections[0].label: "View offline device",
          connections[0].target: devicesOfflineView
        }

        macDetail = frame {
          width: 100%,
          display: .none,
          layout: {direction: .column, item-gap: 12px},
          border: {color: c.colors.borderSoft, sides: .bottom},
          padding: [12px, s.space.lg, 20px, 44px],
          children: [macNotice, macActions],

          macNotice = frame : feedback.deviceNotice {
            width: 100%,

            heading {
              display: .none
            }
          }

          macActions = frame {
            width: 100%,
            layout: {
              justify-content: .space-between,
              align-items: .center,
              item-gap: s.space.sm
            },
            overflow: .visible,
            children: [macMain, macRevoke],

            macMain = frame {
              layout: {align-items: .center, item-gap: s.space.sm},
              overflow: .visible,
              children: macDefault,

              macDefault = frame : buttons.smallSecondary {
                display: .none,

                label {
                  contents: "Default device"
                }
              }
            }

            macRevoke = frame : buttons.smallDanger {
              connections[0].target: devicesDisconnect,

              label {
                contents: "Disconnect device"
              }
            }
          }
        }

        windows = frame : rows.deviceRow {
          width: 100%,
          border[0].color: c.colors.borderSoft,
          border[0].sides: .bottom
        }

        ubuntu = frame : rows.deviceRuntime {
          width: 100%,
          fill[0].color: c.colors.selected
        }

        ubuntuDetail = frame {
          width: 100%,
          layout: {direction: .column, item-gap: 20px},
          border: {color: c.colors.borderSoft, sides: .bottom},
          padding: [s.space.lg, s.space.lg, 20px, 44px],
          children: [columns, exec, detailActions],

          // Agent list appears only when an Agent is missing or needs sign-in; the row already lists working Agents
          columns = frame {
            width: 100%,
            display: .none,
            layout: {item-gap: s.space.xxl},
            border: {color: c.colors.borderSoft, sides: .bottom},
            padding: [0px, 0px, s.space.lg],
            children: agentsCol,

            agentsCol = frame {
              width: 100%,
              layout: {direction: .column, item-gap: s.space.sm},
              children: [
                agentsLabel,
                agentLine1,
                agentLine2,
                agentLine3,
                capabilityNote
              ],

              capabilityNote = text : t.caption {
                width: 100%,
                display: .none,
                contents: "",
                fill[0].color: c.colors.muted
              }

              agentsLabel = text : t.captionMedium {
                contents: "Agents & subscriptions",
                fill[0].color: c.colors.faint
              }

              agentLine1 = frame : rows.capabilityLine {}

              agentLine2 = frame : rows.capabilityLine {
                name {
                  contents: "Pi"
                }
              }

              agentLine3 = frame : rows.capabilityLine {
                width: 100%,

                name {
                  contents: "Project assistant"
                }
              }
            }
          }

          exec = frame {
            width: 100%,
            layout: {direction: .column, item-gap: 6px},
            children: [execToggle, permissionFeedback],

            permissionFeedback = text : t.caption {
              width: 100%,
              display: .none,
              contents: "Saving command permission…",
              fill[0].color: c.colors.muted
            }

            execToggle = frame : toggles.on {
              width: 100%,
              connections[0].label: "Change command permission",
              connections[0].target: devicesPermissionSaving,

              copy {
                helper {
                  contents: "Shell commands the project assistant runs itself. Threads set their own access."
                }
              }
            }
          }

          detailActions = frame {
            width: 100%,
            layout: {
              justify-content: .space-between,
              align-items: .center,
              item-gap: s.space.sm
            },
            overflow: .visible,
            children: [detailMain, revoke],

            detailMain = frame {
              layout: {align-items: .center, item-gap: s.space.sm},
              overflow: .visible,
              children: [makeDefault, folders],

              makeDefault = frame : buttons.smallSecondary {
                connections[0].target: devicesDefaultSaved,

                label {
                  contents: "Set as default"
                }
              }

              folders = frame : buttons.smallSecondary {
                connections[0].target: devicesFolders,

                label {
                  contents: "Folders…"
                }
              }
            }

            revoke = frame : buttons.smallDanger {
              connections[0].target: devicesDisconnect,

              label {
                contents: "Disconnect device"
              }
            }
          }
        }
      }
    }
  }
}

export devicesEnroll = frame : devices {
  title: "Devices · Connect device",
  caption: "Choose a system, run the command, and paste the setup code.",
  left: 1728px,
  top: 0px,
  overrides: [insert(scrim, after = devices.main)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : enroll.enrollDialog {
      footer {
        actions {
          cancel {
            connections[0].target: devices
          }
        }
      }
    }
  }
}

devicesDisconnect = frame : devices {
  title: "Devices · Disconnect device",
  caption: "Confirm removal after reviewing what happens to local work and saved records.",
  left: 3456px,
  top: 0px,
  overrides: [insert(scrim, after = devices.main)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      footer {
        actions {
          confirm {
            connections[0].target: devicesDisconnecting,

            label {
              contents: "Disconnect device"
            }
          }

          cancel {
            connections[0].target: devices
          }
        }
      }

      content {
        message {
          contents: "Agents already running on it keep running locally."
        }
      }

      heading {
        contents: "Disconnect “Ubuntu Dev”?"
      }
    }
  }
}

export devicesEmpty = frame : devices {
  title: "Devices / No devices",
  caption: "Connect a computer, then open Threads to start a chat.",
  left: 0px,
  top: 1080px,

  main {
    content {
      intro {
        enroll {
          display: .none
        }

        introCopy {
          introTitle {
            contents: "Your devices"
          }
        }
      }

      list {
        display: .none
      }

      empty {
        display: .visible
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "0 devices"
            }
          }
        }
      }
    }
  }
}

devicesSyncing = frame : devices {
  title: "Devices / Syncing",
  caption: "Connection is restored. Wait for device information before starting work.",
  left: 1728px,
  top: 1080px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            display: .none
          }
        }

        ubuntu {
          agents {
            contents: "Checking availability…"
          }

          @with-variant(status.labelQueued)
          state {
            caption {
              contents: "Syncing…"
            }
          }
        }
      }

      intro {
        introCopy {
          introTitle {
            contents: "3 devices, 1 online, 1 syncing"
          }
        }
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "1 online · 1 syncing"
            }
          }
        }
      }
    }
  }
}

devicesMissing = frame : devices {
  title: "Devices / Missing programs and sign-ins",
  caption: "Check setup on Ubuntu Dev; availability updates after the device reports again.",
  left: 3456px,
  top: 1080px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            display: .none
          }

          columns {
            display: .visible,
            padding-bottom: 0px,
            border[0].color: c.colors.transparent,

            agentsCol {
              @with-variant(rows.capabilityMissing)
              agentLine3 {
                note {
                  contents: "Not installed"
                }

                left: .nil
              }

              @with-variant(rows.capabilityMissing)
              agentLine2 {
                note {
                  contents: "Not installed"
                }

                left: .nil
              }

              @with-variant(rows.capabilityMissing)
              agentLine1 {
                note {
                  contents: "ChatGPT sign-in expired"
                }

                left: .nil
              }
            }
          }
        }

        ubuntu {
          agents {
            fill[0].color: c.colors.attentionText,
            contents: "Setup needed"
          }

          @with-variant(status.labelOnline)
          state {}
        }
      }
    }
  }
}

devicesDefaultOffline = frame : devicesDisconnect {
  title: "Devices / Choose offline default",
  caption: "Save an offline default after reviewing how new work waits or uses another device.",
  left: 0px,
  top: 2160px,

  scrim {
    form {
      footer {
        actions {
          @with-variant(buttons.button)
          confirm {
            connections[0].target: devicesOfflineDefaultSaved,

            label {
              contents: "Save default device"
            }
          }

          cancel {
            connections[0].target: devicesOfflineSelect
          }
        }
      }

      content {
        message {
          contents: "It's offline. New threads on it wait until it's back."
        }
      }

      heading {
        contents: "Use MacBook Pro as default?"
      }
    }
  }

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesOfflineDefaultSaved = frame : devicesOfflineView {
  title: "Devices / Offline default saved",
  caption: "MacBook Pro stays the default even while offline. The Default label moves in place; no banner.",
  left: 1728px,
  top: 2160px
}

devicesDefaultSaved = frame : devices {
  title: "Devices / Default saved",
  caption: "The Default label moves to Ubuntu Dev in place; no banner.",
  left: 3456px,
  top: 2160px,

  main {
    content {
      list {
        ubuntuDetail {
          detailActions {
            revoke {
              connections[0].target: devicesDefaultDisconnect
            }

            detailMain {
              makeDefault {
                display: .none
              }
            }
          }
        }

        mac {
          connections[0].target: devicesOfflineSelect,

          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }

      notice {
        display: .none
      }
    }
  }
}

devicesPermissionSaving = frame : devices {
  title: "Devices / Saving permission",
  caption: "Keep the last saved setting visible until the change is saved.",
  left: 0px,
  top: 3240px,
  connections[0].label: "Saved",
  connections[0].target: devicesPermissionSaved,
  connections[1].label: "Couldn't save",
  connections[1].target: devicesPermissionFailed,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              display: .visible
            }
          }
        }
      }
    }
  }
}

devicesPermissionSaved = frame : devices {
  title: "Devices / Commands turned off",
  caption: "The switch changes after the permission is saved.",
  left: 1728px,
  top: 3240px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              display: .visible,
              contents: "Saved"
            }

            @with-variant(toggles.toggle)
            execToggle {
              connections[0].target: devicesPermissionConfirm
            }
          }
        }
      }
    }
  }
}

devicesPermissionFailed = frame : devices {
  title: "Devices / Permission not saved",
  caption: "The previous setting stays active. Retry the change.",
  left: 3456px,
  top: 3240px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            @with-variant(t.captionAttention)
            permissionFeedback {
              connections[0].target: devicesPermissionSaving,
              left: .nil,
              display: .visible,
              contents: "Couldn't save. Commands are still allowed."
            }
          }
        }
      }
    }
  }
}

devicesDisconnecting = frame : devicesDisconnect {
  title: "Devices / Disconnecting",
  caption: "Wait until new connections are blocked and the current connection is closed.",
  left: 0px,
  top: 4320px,
  connections[0].label: "Disconnected",
  connections[0].target: devicesDisconnected,
  connections[1].label: "Couldn't disconnect",
  connections[1].target: devicesDisconnectFailed,

  scrim {
    form {
      footer {
        actions {
          cancel {
            display: .none
          }

          confirm {
            label {
              contents: "Disconnecting…"
            }
          }
        }
      }

      content {
        message {
          display: .none
        }
      }

      heading {
        contents: "Disconnecting Ubuntu Dev…"
      }
    }
  }
}

devicesDisconnectFailed = frame : devicesDisconnect {
  title: "Devices / Disconnect not confirmed",
  caption: "Keep the device listed until disconnection can be confirmed.",
  left: 1728px,
  top: 4320px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            connections[0].target: devicesDisconnecting,

            label {
              contents: "Try again"
            }
          }
        }
      }

      heading {
        contents: "Couldn't confirm disconnection"
      }

      content {
        message {
          contents: "Ubuntu Dev may still be connected."
        }
      }
    }
  }
}

devicesDisconnected = frame : devices {
  title: "Devices / Device disconnected",
  caption: "The removed device is gone from the list. Saved chats and records remain.",
  left: 3456px,
  top: 4320px,

  main {
    content {
      notice {
        action {
          display: .none
        }

        heading {
          contents: "Ubuntu Dev disconnected"
        }

        detail {
          contents: "Its agents may still be running locally.",
          display: .visible
        }

        display: .visible
      }

      list {
        ubuntu {
          display: .none
        }

        ubuntuDetail {
          display: .none
        }
      }

      intro {
        introCopy {
          introTitle {
            contents: "2 devices, 1 online"
          }
        }
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "1/2 online"
            }
          }
        }
      }
    }
  }
}

