  }
}

devicesPermissionEnableFailed = frame : devicesPermissionSaved {
  title: "Devices / Commands remain off",
  caption: "A failed change leaves the previous setting active. Retry the switch.",
  left: 3456px,
  top: 7560px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            @with-variant(t.captionAttention)
            permissionFeedback {
              connections[0].target: devicesPermissionEnabling,
              left: .nil,
              contents: "Couldn't save. Commands are still off."
            }
          }
        }
      }
    }
  }
}

devicesDefaultDisconnectFailed = frame : devicesDisconnectFailed {
  title: "Devices / Default disconnect not confirmed",
  caption: "Keep the saved default until disconnection is confirmed.",
  left: 0px,
  top: 8640px,

  scrim {
    form {
      footer {
        actions {
          cancel {
            connections[0].target: devicesDefaultSaved
          }

          confirm {
            connections[0].target: devicesDefaultDisconnecting
          }
        }
      }
    }
  }

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesFolders = frame : devices {
  title: "Devices · Folders",
  caption: "Folders… lists the folders added on this device. Remove stops new chats and file previews there; running chats keep going.",
  left: 1728px,
  top: 8640px,
  overrides: [insert(scrim, after = devices.main)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      footer {
        actions {
          overrides: [remove(dialogs.dialog.footer.actions.confirm)],

          cancel {
            connections[0].target: devices,

            label {
              contents: "Done"
            }
          }
        }
      }

      content {
        overrides: [
          insert(folder1, after = .nil),
          insert(folder2, after = folder1),
          remove(dialogs.dialog.content.message)
        ]
      }

      heading {
        contents: "Folders on Ubuntu Dev"
      }
    }
  }

  folder1 = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    border: {color: c.colors.borderSoft, sides: .bottom},
    padding: [0px, 0px, s.space.sm],
    children: [path, remove],

    path = text : t.mono {
      contents: "~/work/baton"
    }

    remove = frame : buttons.smallGhostDanger {
      label {
        contents: "Remove"
      }
    }
  }

  folder2 = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    padding: [0px, 0px, s.space.sm],
    children: [path, remove],

    path = text : t.mono {
      contents: "~/work/docs"
    }

    remove = frame : buttons.smallGhostDanger {
      label {
        contents: "Remove"
      }
    }
  }
}

devicesPermissionConfirm = frame : devicesPermissionSaved {
  title: "Devices / Allow commands",
  caption: "Turning commands on states the effect once. Threads keep their own access.",
  left: 3456px,
  top: 8640px,
  overrides: [insert(scrim, after = devices.main)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      footer {
        actions {
          @with-variant(buttons.button)
          confirm {
            connections[0].target: devicesPermissionEnabling,

            label {
              contents: "Allow commands"
            }
          }

          cancel {
            connections[0].target: devicesPermissionSaved
          }
        }
      }

      content {
        message {
          contents: "Commands run directly as kaken and can reach files outside your folders."
        }
      }

      heading {
        contents: "Let the project assistant run commands on Ubuntu Dev?"
      }
    }
  }
}
