              }
            }
          }
        }
      }

      notice {
        heading {
          contents: "Default device saved"
        }

        detail {
          contents: "Windows Desktop is your default for new chats and projects."
        }
      }
    }
  }
}

devicesDefaultDisconnect = frame : devicesDisconnect {
  title: "Devices / Disconnect default device",
  caption: "Removing the default leaves no replacement until you choose one.",
  left: 3456px,
  top: 5400px,

  scrim {
    form {
      footer {
        actions {
          cancel {
            connections[0].target: devicesDefaultSaved
          }

          confirm {
            connections[0].target: devicesDefaultDisconnecting
          }
        }
      }

      content {
        message {
          contents: "Ubuntu Dev is your default device. Removing it leaves no default until you choose another. Offline agents may keep running locally. Past chats and records are kept; file changes and commands already run are not undone."
        }
      }
    }
  }

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesDefaultDisconnecting = frame : devicesDisconnecting {
  title: "Devices / Disconnecting default device",
  caption: "Show the choose-default prompt only after disconnection is confirmed.",
  left: 0px,
  top: 6480px,
  connections[0].label: "Default device disconnected",
  connections[0].target: devicesDefaultRemoved,
  connections[1].target: devicesDefaultDisconnectFailed,

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesOfflineView = frame : devices {
  title: "Devices / Offline details",
  caption: "Last contact stays visible. New chats wait for the same device.",
  left: 1728px,
  top: 6480px,

  main {
    content {
      list {
        ubuntu {
          fill[0].color: c.colors.surface,

          @with-variant(icons.chevronRight)
          chevron {}
        }

        ubuntuDetail {
          display: .none
        }

        mac {
          fill[0].color: c.colors.panel,

          @with-variant(icons.chevronDown)
          chevron {}
        }

        macDetail {
          display: .visible
        }
      }
    }
  }
}

devicesOfflineSelect = frame : devicesOfflineView {
  title: "Devices / Select offline default",
  caption: "Set an offline device as default from its details.",
  left: 3456px,
  top: 6480px,

  main {
    content {
      list {
        macDetail {
          macActions {
            macDefault {
              connections[0].target: devicesDefaultOffline,

              label {
                contents: "Set as default"
              }
            }
          }
        }

        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}

devicesPermissionEnabling = frame : devicesPermissionSaved {
  title: "Devices / Enabling commands",
  caption: "Keep permission off until the new setting is saved.",
  left: 0px,
  top: 7560px,
  connections[0].label: "Saved",
  connections[0].target: devicesPermissionEnabled,
  connections[1].label: "Could not save",
  connections[1].target: devicesPermissionEnableFailed,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              contents: "Saving command permission…"
            }
          }
        }
      }
    }
  }
}

devicesPermissionEnabled = frame : devices {
  title: "Devices / Commands turned on",
  caption: "Permission is on after it has been saved.",
  left: 1728px,
  top: 7560px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              display: .visible,
              contents: "Saved · command permission is on"
            }
          }
        }
      }
    }
  }
}

devicesPermissionEnableFailed = frame : devicesPermissionSaved {
  title: "Devices / Commands remain off",
  caption: "A failed change leaves the previous setting active. Retry the switch.",
  left: 3456px,
  top: 7560px,

  main {
    content {
      list {
        ubuntuDetail {
          exec {
            permissionFeedback {
              fill[0].color: c.colors.attentionText,
              connections[0].target: devicesPermissionEnabling,
              contents: "Baton could not be reached. Command permission is still off. Click the switch to try again."
            }
          }
        }
      }
    }
  }
}

devicesDefaultDisconnectFailed = frame : devicesDisconnectFailed {
  title: "Devices / Default disconnect not confirmed",
  caption: "Keep the saved default until disconnection is confirmed.",
  left: 0px,
  top: 8640px,

  scrim {
    form {
      footer {
        actions {
          cancel {
            connections[0].target: devicesDefaultSaved
          }

          confirm {
            connections[0].target: devicesDefaultDisconnecting
          }
        }
      }
    }
  }

  main {
    content {
      list {
        mac {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .none
                }
              }
            }
          }
        }

        ubuntu {
          identity {
            copy {
              nameLine {
                defaultTag {
                  display: .visible
                }
              }
            }
          }
        }
      }
    }
  }
}
