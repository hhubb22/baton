threadsFolderWindowsBrowse = frame : lists.threadsPage {
  title: "Threads · Browse Windows folder",
  caption: "Keep Windows Desktop selected while navigating within its allowed folder.",
  left: 0px,
  top: 16520px,
  overrides: [insert(scrim, after = lists.threadsPage.main)],

  main {
    compose {
      composer {
        prompt {
          fill[0].color: c.colors.text,
          contents: "Run the reconnect tests."
        }

        toolbar {
          send {
            fill[0].color: c.colors.subtle,

            sendGlyph {
              fill[0].color: c.colors.text
            }
          }
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: picker,

    picker = frame : newThread.folderPickerBrowse {
      footer {
        actions {
          confirm {
            connections[0].target: threadsFolderWindowsApplied,
            connections[0].label: "Select Windows folder"
          }

          cancel {
            connections[0].target: threadsDraft,
            connections[0].label: "Cancel; keep previous location and draft"
          }
        }

        note {
          contents: "D:\\src"
        }
      }

      content {
        browser {
          second {
            connections[0]: .nil,

            name {
              contents: "tools"
            }
          }

          parent {
            connections[0].target: threadsFolderWindows,
            connections[0].label: "Back to allowed folders"
          }

          rootsHead {
            contents: "D:\\src"
          }
        }

        device {
          value {
            contents: "Windows Desktop"
          }
        }
      }
    }
  }
}

