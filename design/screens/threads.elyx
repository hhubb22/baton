import "tokens/colors.elyx" as c
import "blocks/thread-list.elyx" as lists
import "blocks/thread-detail.elyx" as details
import "blocks/new-thread.elyx" as newThread
import "blocks/dialog.elyx" as dialogs
import "blocks/file-preview.elyx" as previews
import "blocks/thread-actions.elyx" as actions

threads = frame : lists.threadsPage {
  title: "Threads",
  caption: "Send a first message to start a chat. Location and model use your recent choices.",
  left: 0px,
  top: 0px
}

threadsOpen = frame : lists.threadsPageSplit {
  title: "Threads · Detail open",
  caption: "Chat details open beside the list. Project and folder columns collapse.",
  left: 1728px,
  top: 0px,

  detail {
    footer {
      composer {
        toolbar {
          actions {
            stop {
              connections[0].target: threadsStopConfirm,
              connections[0].label: "Stop current reply"
            }
          }
        }
      }
    }

    head {
      tools {
        more {
          connections[0].target: threadsActions,
          connections[0].label: "Chat actions"
        }
      }
    }
  }
}

threadsUnknown = frame : lists.threadsPageSplit {
  title: "Threads · Status unknown",
  caption: "Delivery is uncertain after Codex restarted. Check activity before sending again.",
  left: 3456px,
  top: 0px,

  @with-variant(details.threadDetailUnknown)
  detail {
    top: .nil
  }

  main {
    list {
      overrides: [
        insert(reconnectRow, after = lists.threadsPage.main.list.needsHead)
      ],

      unknownRow {
        fill[0].color: c.colors.transparent
      }

      runningRow {
        display: .none
      }

      runningHead {
        lead {
          count {
            contents: "1"
          }
        }
      }

      needsHead {
        lead {
          count {
            contents: "3"
          }
        }
      }
    }
  }

  reconnectRow = frame : lists.threadListRowUnknown {
    width: 100%,
    fill[0].color: c.colors.selected,

    project {
      display: .none
    }

    dir {
      display: .none
    }

    time {
      contents: "Just now"
    }
  }
}

threadsWaiting = frame : lists.threadsPageSplit {
  title: "Threads · Waiting for device",
  caption: "Messages wait for MacBook Pro. Cancel a message before it sends.",
  left: 0px,
  top: 1180px,

  @with-variant(details.threadDetailWaiting)
  detail {
    top: .nil
  }

  main {
    list {
      waitingRow {
        fill[0].color: c.colors.selected
      }

      runningRow {
        fill[0].color: c.colors.transparent
      }
    }
  }
}

threadsNew = frame : lists.threadsPage {
  title: "Threads · Location menu",
  caption: "Choose a folder and computer. Offline computers remain selectable.",
  left: 1728px,
  top: 1180px,
  overrides: [insert(menu, after = lists.threadsPage.main)],

  menu = frame : newThread.locationMenu {
    left: 286px,
    top: 164px,
    ignore-stack: .true,

    other {
      connections[0].target: threadsFolderRoots,
      connections[0].label: "Replace location menu; keep draft"
    }
  }
}

threadsModel = frame : lists.threadsPage {
  title: "Threads · Model menu",
  caption: "Choose a model from the assistants available on this computer.",
  left: 0px,
  top: 2360px,
  overrides: [insert(menu, after = lists.threadsPage.main)],

  menu = frame : newThread.modelMenu {
    left: 476px,
    top: 164px,
    ignore-stack: .true
  }
}

threadsSwitchModel = frame : lists.threadsPageSplit {
  title: "Threads · Switch model",
  caption: "The selected model applies to the next reply. Unsupported changes show a reason.",
  left: 1728px,
  top: 2360px,
  overrides: [insert(menu, after = lists.threadsPageSplit.detail)],

  menu = frame : newThread.threadModelMenu {
    left: 1040px,
    top: 706px,
    ignore-stack: .true
  }
}

threadsFile = frame : lists.threadsPageSplit {
  title: "Threads · File preview",
  caption: "Files load from the computer. Large files show the first 64 KB.",
  left: 3456px,
  top: 1180px,
  overrides: [insert(scrim, after = lists.threadsPageSplit.detail)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: preview,

    preview = frame : previews.filePreviewTruncated {}
  }
}

threadsEmpty = frame : lists.threadsPageEmpty {
  title: "Threads · Empty",
  caption: "Focus the composer to start the first independent chat.",
  left: 0px,
  top: 3540px,

  main {
    feedback {
      action {
        connections[0].target: threadsEmpty,
        connections[0].label: "Focus first message"
      }
    }
  }
}

threadsNoResults = frame : lists.threadsPageNoResults {
  title: "Threads · No results",
  caption: "Clear filters and keep the new chat draft.",
  left: 1728px,
  top: 3540px,

  main {
    feedback {
      action {
        connections[0].target: threads,
        connections[0].label: "Clear filters"
      }
    }
  }
}

threadsLoadFailed = frame : lists.threadsPageFailed {
  title: "Threads · List unavailable",
  caption: "Retry the list request with the same filters and draft.",
  left: 3456px,
  top: 3540px,

  main {
    feedback {
      action {
        connections[0].target: threadsLoading,
        connections[0].label: "Retry list"
      }
    }
  }
}

threadsLoading = frame : lists.threadsPageLoading {
  title: "Threads · Loading",
  caption: "Wait for the chat list. The composer stays available.",
  left: 0px,
  top: 4720px
}

threadsFolderRoots = frame : lists.threadsPage {
  title: "Threads · Choose another folder",
  caption: "Replace the location menu. Browse allowed folders without changing the draft.",
  left: 1728px,
  top: 4720px,
  overrides: [insert(scrim, after = lists.threadsPage.main)],

  main {
    compose {
      composer {
        prompt {
          fill[0].color: c.colors.text,
          contents: "Run the reconnect tests."
        }

        toolbar {
          send {
            fill[0].color: c.colors.subtle,

            sendGlyph {
              fill[0].color: c.colors.text
            }
          }
        }
      }
    }
  }

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: picker,

    picker = frame : newThread.folderPicker {
      footer {
        actions {
          confirm {
            connections[0].target: threadsFolderBrowse,
            connections[0].label: "Choose an allowed folder first"
          }

          cancel {
            connections[0].target: threadsDraft,
            connections[0].label: "Return to draft"
          }
        }
      }

      content {
        browser {
          first {
            connections[0].target: threadsFolderBrowse
          }
        }

        device {
          connections[0].target: threadsFolderDevices,
          connections[0].label: "Choose device"
        }
      }
    }
  }
}

