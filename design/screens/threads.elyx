import "tokens/colors.elyx" as c
import "blocks/thread-list.elyx" as lists
import "blocks/thread-detail.elyx" as details
import "blocks/new-thread.elyx" as newThread
import "blocks/file-preview.elyx" as previews

threads = frame : lists.threadsPage {
  title: "Thread",
  caption: "顶部输入区新建 Thread：位置预填默认设备上次用的目录，模型预填这个位置上次用的 Agent 和模型，发出即新建。下面是本人所有 Thread，按需要处理、执行中、等待设备、空闲分组，可以按设备、Project 和是否归档筛选。",
  left: 0px,
  top: 0px
}

threadsOpen = frame : lists.threadsPageSplit {
  title: "Thread · 详情",
  caption: "点一行在右侧打开详情，列表收起 Project 和目录两列。",
  left: 1728px,
  top: 0px
}

threadsUnknown = frame : lists.threadsPageSplit {
  title: "Thread · 状态未知",
  caption: "Worker 重启后没能确认 Agent 是否收到消息。Baton 不自动重发，由你看过过程记录后决定是否再发一次。",
  left: 3456px,
  top: 0px,

  @with-variant(details.threadDetailUnknown)
  detail {
    top: .nil
  }

  main {
    list {
      runningRow {
        fill[0].color: c.colors.transparent
      }

      unknownRow {
        fill[0].color: c.colors.selected
      }
    }
  }
}

threadsWaiting = frame : lists.threadsPageSplit {
  title: "Thread · 等待设备",
  caption: "设备离线时新建的 Thread 等这台设备上线，不改派到其他设备；第一条消息在发出前可以撤回。",
  left: 0px,
  top: 1180px,

  @with-variant(details.threadDetailWaiting)
  detail {
    top: .nil
  }

  main {
    list {
      waitingRow {
        fill[0].color: c.colors.selected
      }

      runningRow {
        fill[0].color: c.colors.transparent
      }
    }
  }
}

threadsNew = frame : lists.threadsPage {
  title: "Thread · 选位置",
  caption: "位置是目录加设备。先列最近用过的，再按设备列出发现的仓库，其他目录在登记目录里选。离线设备照样可选，Thread 等它上线后开始。",
  left: 1728px,
  top: 1180px,
  overrides: [insert(menu, after = lists.threadsPage.main)],

  menu = frame : newThread.locationMenu {
    left: 286px,
    top: 164px,
    ignore-stack: .true
  }
}

threadsModel = frame : lists.threadsPage {
  title: "Thread · 选模型",
  caption: "模型按 Agent 分组，只列这个位置的设备上已接入的 Agent。选了模型就定了 Agent，提示文字跟着变。",
  left: 0px,
  top: 2360px,
  overrides: [insert(menu, after = lists.threadsPage.main)],

  menu = frame : newThread.modelMenu {
    left: 476px,
    top: 164px,
    ignore-stack: .true
  }
}

threadsSwitchModel = frame : lists.threadsPageSplit {
  title: "Thread · 换模型",
  caption: "Thread 输入区的模型只列这个 Agent 的模型，新的一轮从选中的模型开始；Agent 新建后不能换。Agent 不支持换模型时，菜单只显示当前模型和原因。",
  left: 1728px,
  top: 2360px,
  overrides: [insert(menu, after = lists.threadsPageSplit.detail)],

  menu = frame : newThread.threadModelMenu {
    left: 1040px,
    top: 706px,
    ignore-stack: .true
  }
}

threadsFile = frame : lists.threadsPageSplit {
  title: "Thread · 文件预览",
  caption: "点附件或在设备的登记目录里浏览，预览从设备实时读取，超过 64 KiB 只显示开头。",
  left: 3456px,
  top: 1180px,
  overrides: [insert(scrim, after = lists.threadsPageSplit.detail)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: preview,

    preview = frame : previews.filePreviewTruncated {}
  }
}
