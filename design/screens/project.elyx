import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "blocks/project-page.elyx" as page
import "controls/icons.elyx" as icons
import "controls/status.elyx" as status
import "blocks/project-header.elyx" as headers
import "blocks/conversation.elyx" as conv
import "blocks/overview.elyx" as overviews
import "blocks/banner.elyx" as banners

@with-context()
file {}

running = frame : page.projectPage {
  title: "Project · 运行中",
  caption: "Project Agent 在 Ubuntu 开发机上处理 Thread 刚发回的回复。标题栏写明运行位置，可以停止这次运行；它开的 Thread 不受影响。",
  left: 0px,
  top: 0px
}

offline = frame : page.projectPage {
  title: "Project · 所有设备离线",
  caption: "消息照常保存，不显示「正在运行」。横幅说明在等什么；设备离线时，执行中的 Thread 显示最后一次报告的时间，不当成仍在执行。",
  left: 1728px,
  top: 0px,

  overview {
    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.muted,
                contents: "等待设备"
              }

              @with-variant(status.dotQueued)
              runtimeDot {}
            }

            runtimeDevice {
              runtimeName {
                contents: "没有运行实例"
              }
            }
          }

          runtimeNote {
            contents: "3 台设备都离线。设备在线、已同步、装有 Runtime 且订阅可用时启动。"
          }
        }
      }
    }

    body {
      activeRow2 {
        line {
          time {
            contents: "14:19 后无报告"
          }
        }
      }

      activeRow1 {
        line {
          time {
            contents: "14:18 后无报告"
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [insert(waitBanner, after = .nil)]
    }

    transcript {
      overrides: [
        insert(offlineNote, after = page.projectPage.main.transcript.agent1),
        insert(pendingMessage, after = offlineNote),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day)
      ],

      agent1 {
        work {
          cardRows {
            row1 {
              lineTrail {
                lineState {
                  fill[0].color: c.colors.faint,
                  width: .auto,
                  contents: "14:18 后无报告",
                  font-size: 13,
                  font-family: "PingFang SC"
                }
              }

              lineLead {
                lineMark {
                  @with-variant(status.dotQueued)
                  lineDot {
                    left: .nil
                  }
                }
              }
            }
          }

          cardHead {
            cardState {
              cardStateText {
                fill[0].color: c.colors.muted,
                contents: "设备离线"
              }

              @with-variant(status.dotQueued)
              cardDot {
                left: .nil
              }
            }
          }
        }
      }
    }

    @with-variant(headers.headerWaiting)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }

            note {
              display: .visible
            }
          }
        }
      }

      nav {
        navDevices {
          trail {
            note {
              contents: "0/3 在线"
            }
          }
        }
      }
    }
  }

  offlineNote = frame : conv.systemNote {
    width: 100%,
    max-width: s.size.measure,

    label {
      contents: "14:20 Ubuntu 开发机离线，Project Agent 这一轮已处理完，没有新的运行实例"
    }

    @with-variant(icons.offline)
    glyph {}
  }

  pendingMessage = frame : conv.userMessagePending {
    width: 100%,
    max-width: s.size.measure
  }

  waitBanner = frame : banners.banner {}
}

attention = frame : page.projectPage {
  title: "Project · 需要处理",
  caption: "模型请求达到重试上限后主对话暂停，Inbox 里同时出现一个系统事项。之后的消息继续保存，重试后从原位置继续。",
  left: 3456px,
  top: 0px,

  overview {
    body {
      overrides: [insert(systemRow, after = overviews.overview.body.needsHead)],

      needsHead {
        lead {
          count {
            contents: "2"
          }
        }
      }
    }

    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.attentionText,
                contents: "需要处理"
              }

              @with-variant(status.dotAttention)
              runtimeDot {}
            }
          }

          runtimeNote {
            contents: "ChatGPT 订阅返回 401，需要在 Ubuntu 开发机上重新登录。"
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [insert(failBanner, after = .nil)]
    }

    transcript {
      overrides: [
        insert(failNote, after = page.projectPage.main.transcript.agent1),
        insert(laterMessage, after = failNote),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day)
      ]
    }

    @with-variant(headers.headerAttention)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }

            count {
              value {
                contents: "1"
              }

              display: .visible
            }
          }
        }
      }

      nav {
        navInbox {
          trail {
            count {
              value {
                contents: "4"
              }
            }
          }
        }
      }
    }
  }

  failNote = frame : conv.systemNote {
    width: 100%,
    max-width: s.size.measure,

    label {
      fill[0].color: c.colors.attentionText,
      contents: "15:20 模型请求连续失败 5 次，主对话暂停。最后一次错误：401 Unauthorized"
    }

    @with-variant(icons.alert)
    glyph {
      fill[0].color: c.colors.attention
    }
  }

  laterMessage = frame : conv.userMessagePending {
    width: 100%,
    max-width: s.size.measure,

    bubble {
      content {
        contents: "先把 Windows 上的测试日志贴给我。"
      }
    }

    meta {
      metaText {
        contents: "已保存，重试后处理"
      }
    }
  }

  failBanner = frame : banners.bannerAttention {}

  systemRow = frame : overviews.threadRow {
    width: 100%,

    sub {
      place {
        contents: "系统事项 · Baton 创建"
      }
    }

    line {
      time {
        contents: "15:20"
      }

      lead {
        name {
          contents: "Project Agent 暂停：模型请求失败"
        }

        @with-variant(status.dotAttention)
        mark {
          left: .nil
        }
      }
    }
  }
}

paused = frame : page.projectPage {
  title: "Project · 已暂停",
  caption: "暂停后 Project Agent 不再启动，Thread 照常可用。用户仍可以直接给 Thread 发消息；主对话里的消息先保存，恢复后再处理。",
  left: 5184px,
  top: 0px,

  overview {
    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.muted,
                contents: "已暂停"
              }

              @with-variant(status.dotIdle)
              runtimeDot {}
            }

            runtimeDevice {
              runtimeName {
                contents: "没有运行实例"
              }
            }
          }

          runtimeNote {
            contents: "恢复后处理暂停期间的 3 条输入。"
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [insert(pauseBanner, after = .nil)]
    }

    transcript {
      overrides: [
        insert(pauseNote, after = page.projectPage.main.transcript.agent1),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day)
      ]
    }

    @with-variant(headers.headerPaused)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          lead {
            name {
              fill[0].color: c.colors.muted
            }
          }

          trail {
            live {
              display: .none
            }

            paused {
              display: .visible
            }
          }
        }
      }
    }
  }

  pauseNote = frame : conv.systemNote {
    width: 100%,
    max-width: s.size.measure,

    label {
      contents: "15:02 何家健暂停了 Project"
    }

    @with-variant(icons.pause)
    glyph {}
  }

  pauseBanner = frame : banners.bannerPaused {}
}
