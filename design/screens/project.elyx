import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "blocks/project-page.elyx" as page
import "controls/icons.elyx" as icons
import "controls/status.elyx" as status
import "blocks/project-header.elyx" as headers
import "blocks/conversation.elyx" as conv
import "blocks/overview.elyx" as overviews
import "blocks/banner.elyx" as banners

@with-context()
file {}

running = frame : page.projectPage {
  title: "Project · Running",
  caption: "The assistant is reading a reply from Ubuntu Dev. Stop run stops only the project assistant.",
  left: 0px,
  top: 0px
}

offline = frame : page.projectPage {
  title: "Project · All devices offline",
  caption: "Messages wait for an available computer. Offline chats show when they were last seen.",
  left: 1728px,
  top: 0px,

  overview {
    body {
      activeRow2 {
        line {
          time {
            contents: "14:19"
          }

          lead {
            @with-variant(status.dotIdle)
            mark {
              left: .nil
            }
          }
        }
      }

      activeRow1 {
        line {
          time {
            contents: "14:18"
          }

          lead {
            @with-variant(status.dotIdle)
            mark {
              left: .nil
            }
          }
        }
      }

      activeHead {
        lead {
          label {
            contents: "Last seen running"
          }
        }
      }
    }

    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.muted,
                contents: "Waiting for device"
              }

              @with-variant(status.dotQueued)
              runtimeDot {}
            }

            runtimeDevice {
              display: .none,

              runtimeName {
                contents: "Idle"
              }
            }
          }

          runtimeNote {
            contents: "All 3 devices are offline. Waiting for a computer with ChatGPT signed in."
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [insert(waitBanner, after = .nil)]
    }

    transcript {
      overrides: [
        insert(offlineNote, after = page.projectPage.main.transcript.agent1),
        insert(pendingMessage, after = offlineNote),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day)
      ],

      agent1 {
        work {
          cardRows {
            row1 {
              lineTrail {
                lineState {
                  fill[0].color: c.colors.faint,
                  width: .auto,
                  contents: "No report since 14:18",
                  font-size: 13,
                  font-family: "PingFang SC"
                }
              }

              lineLead {
                lineMark {
                  @with-variant(status.dotQueued)
                  lineDot {
                    left: .nil
                  }
                }
              }
            }
          }

          cardHead {
            cardState {
              cardStateText {
                fill[0].color: c.colors.muted,
                contents: "Device offline"
              }

              @with-variant(status.dotQueued)
              cardDot {
                left: .nil
              }
            }
          }
        }
      }
    }

    @with-variant(headers.headerWaiting)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }

            note {
              display: .visible
            }
          }
        }
      }

      nav {
        navDevices {
          trail {
            note {
              contents: "0/3 online"
            }
          }
        }
      }
    }
  }

  offlineNote = frame : conv.systemNote {
    width: 100%,
    max-width: s.size.measure,

    label {
      contents: "14:20 · Ubuntu Dev went offline after finishing its reply"
    }

    @with-variant(icons.offline)
    glyph {}
  }

  pendingMessage = frame : conv.userMessagePending {
    width: 100%,
    max-width: s.size.measure
  }

  waitBanner = frame : banners.banner {}
}

attention = frame : page.projectPage {
  title: "Project · Needs attention",
  caption: "ChatGPT sign-in expired. Messages stay saved until you sign in and retry.",
  left: 3456px,
  top: 0px,

  overview {
    body {
      overrides: [insert(systemRow, after = overviews.overview.body.needsHead)],

      needsHead {
        lead {
          count {
            contents: "2"
          }
        }
      }
    }

    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.attentionText,
                contents: "Needs attention"
              }

              @with-variant(status.dotAttention)
              runtimeDot {}
            }
          }

          runtimeNote {
            contents: "Sign in to ChatGPT on Ubuntu Dev, then retry in the main chat."
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [insert(failBanner, after = .nil)]
    }

    transcript {
      overrides: [
        insert(failNote, after = page.projectPage.main.transcript.agent1),
        insert(laterMessage, after = failNote),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day)
      ]
    }

    @with-variant(headers.headerAttention)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }

            count {
              value {
                contents: "1"
              }

              display: .visible
            }
          }
        }
      }

      nav {
        navInbox {
          trail {
            count {
              value {
                contents: "4"
              }
            }
          }
        }
      }
    }
  }

  failNote = frame : conv.systemNote {
    width: 100%,
    max-width: s.size.measure,

    label {
      fill[0].color: c.colors.attentionText,
      contents: "15:20 · ChatGPT sign-in expired on Ubuntu Dev"
    }

    @with-variant(icons.alert)
    glyph {
      fill[0].color: c.colors.attention
    }
  }

  laterMessage = frame : conv.userMessagePending {
    width: 100%,
    max-width: s.size.measure,

    bubble {
      content {
        contents: "Send me the test log from Windows first."
      }
    }

    meta {
      metaText {
        contents: "Saved · sends after you sign in and retry"
      }
    }
  }

  failBanner = frame : banners.bannerAttention {}

  systemRow = frame : overviews.threadRow {
    width: 100%,

    sub {
      dir {
        display: .none
      }

      place {
        contents: "Ubuntu Dev"
      }
    }

    line {
      time {
        contents: "15:20"
      }

      lead {
        name {
          contents: "ChatGPT sign-in expired"
        }

        @with-variant(status.dotAttention)
        mark {
          left: .nil
        }
      }
    }
  }
}

paused = frame : page.projectPage {
  title: "Project · Paused",
  caption: "Automatic replies are paused. Individual chats remain available.",
  left: 5184px,
  top: 0px,

  overview {
    summary {
      runtime {
        runtimeCard {
          runtimeLine {
            runtimeState {
              runtimeStateText {
                fill[0].color: c.colors.muted,
                contents: "Paused"
              }

              @with-variant(status.dotIdle)
              runtimeDot {}
            }

            runtimeDevice {
              display: .none,

              runtimeName {
                contents: "Idle"
              }
            }
          }

          runtimeNote {
            contents: "3 messages waiting until you resume."
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [insert(pauseBanner, after = .nil)]
    }

    transcript {
      overrides: [
        insert(pauseNote, after = page.projectPage.main.transcript.agent1),
        remove(page.projectPage.main.transcript.typing),
        remove(page.projectPage.main.transcript.day)
      ]
    }

    @with-variant(headers.headerPaused)
    header {
      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          lead {
            name {
              fill[0].color: c.colors.muted
            }
          }

          trail {
            live {
              display: .none
            }

            paused {
              display: .visible
            }
          }
        }
      }
    }
  }

  pauseNote = frame : conv.systemNote {
    width: 100%,
    max-width: s.size.measure,

    label {
      contents: "15:02 · Kaken He paused the project"
    }

    @with-variant(icons.pause)
    glyph {}
  }

  pauseBanner = frame : banners.bannerPaused {}
}
