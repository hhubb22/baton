use "resources/fonts/Inter-Regular.otf"
use "resources/fonts/Inter-Medium.otf"
use "resources/fonts/Inter-SemiBold.otf"

import "controls/status.elyx" as status
import "tokens/colors.elyx" as c
import "foundations/typography.elyx" as t
import "blocks/project-page.elyx" as page
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "blocks/project-header.elyx" as headers
import "blocks/overview.elyx" as overviews
import "blocks/dialog.elyx" as dialogs
import "blocks/banner.elyx" as banners
import "controls/input.elyx" as inputs

memory = frame : page.projectPage {
  title: "Project / Memory",
  caption: "Open Memory in Overview or the project menu. Choose a note to edit it, or add a new note.",
  left: 0px,
  top: 0px,

  @with-variant(overviews.overviewMemory)
  overview {
    body {
      overviews.overviewMemory.addMemory {
        connections[0].target: addMemory
      }

      overviews.overviewMemory.mem2 {
        connections[0].target: editMemory
      }

      overviews.overviewMemory.mem1 {
        connections[0].target: editMemory
      }
    }
  }
}

emptyMemory = frame : memory {
  title: "Project / Empty memory",
  caption: "With no notes, Add memory opens the first note editor.",
  left: 1728px,
  top: 0px,

  overview {
    body {
      overrides: [
        insert(empty, after = .nil),
        remove(overviews.overviewMemory.mem3),
        remove(overviews.overviewMemory.mem2),
        remove(overviews.overviewMemory.mem4),
        remove(overviews.overviewMemory.mem1)
      ]
    }

    tabBar {
      memoryTab {
        count {
          contents: "0"
        }
      }
    }
  }

  empty = text : t.small {
    width: 100%,
    contents: "No memory yet",
    fill[0].color: c.colors.muted
  }
}

addMemory = frame : memory {
  title: "Project memory / Add",
  caption: "Add memory opens a note editor. Save adds the note; Cancel returns without saving.",
  left: 3456px,
  top: 0px,
  overrides: [insert(scrim, after = page.projectPage.overview)],

  scrim = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.overlay,
    children: form,

    form = frame : dialogs.dialog {
      width: 560px,

      footer {
        actions {
          @with-variant(buttons.button)
          confirm {
            connections[0].target: addingMemory,

            label {
              contents: "Save memory"
            }
          }

          cancel {
            connections[0].target: memory
          }
        }
      }

      content {
        overrides: [
          insert(editor, after = .nil),
          insert(helper, after = editor),
          remove(dialogs.dialog.content.message)
        ]
      }

      heading {
        contents: "Add memory"
      }

      editor = frame : inputs.textarea {
        width: 100%,
        height: 112px,

        @with-variant(t.small)
        value {
          contents: "Release verification runs on Windows and Ubuntu before merging."
        }
      }

      helper = text : t.caption {
        width: 100%,
        contents: "Read with your next message.",
        fill[0].color: c.colors.muted
      }
    }
  }
}

editMemory = frame : addMemory {
  title: "Project memory / Edit",
  caption: "Choose a note in Memory to correct it or stop using it. Source and history open on demand.",
  left: 0px,
  top: 1080px,

  scrim {
    form {
      footer {
        overrides: [insert(stopUsing, after = .nil)],

        actions {
          confirm {
            connections[0].target: savingMemory
          }
        }
      }

      content {
        overrides: [insert(source, after = addMemory.scrim.form.helper)],

        helper {
          display: .none
        }

        editor {
          value {
            contents: "Baton repo path is ~/src/baton on MacBook Pro and ~/work/baton on Ubuntu Dev."
          }
        }
      }

      heading {
        contents: "Edit memory"
      }
    }
  }

  stopUsing = text : t.caption {
    contents: "Stop using",
    connections[0].target: stoppedMemory,
    fill[0].color: c.colors.danger
  }

  source = text : t.caption {
    contents: "View source and history",
    fill[0].color: c.colors.accentText
  }
}

savingMemory = frame : editMemory {
  title: "Project memory / Saving",
  caption: "Save keeps the note visible until the change is stored.",
  left: 1728px,
  top: 1080px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            connections[0].target: savedMemory,

            label {
              contents: "Saving…"
            }
          }
        }
      }
    }
  }
}

saveFailedMemory = frame : editMemory {
  title: "Project memory / Save failed",
  caption: "If saving fails, keep the edited text and retry from the same editor.",
  left: 3456px,
  top: 1080px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            label {
              contents: "Try again"
            }
          }
        }
      }

      content {
        @with-variant(t.captionDanger)
        helper {
          display: .visible,
          contents: "Not saved. Your draft is kept."
        }
      }
    }
  }
}

conflictMemory = frame : editMemory {
  title: "Project memory / Save conflict",
  caption: "The note changed while you edited. Your draft is kept; review the latest text before saving.",
  left: 0px,
  top: 2160px,

  scrim {
    form {
      footer {
        actions {
          @with-variant(buttons.secondary)
          confirm {
            connections[0].target: reviewMemory,

            label {
              contents: "Review latest"
            }

            left: .nil
          }
        }
      }

      content {
        overrides: [insert(latest, after = addMemory.scrim.form.helper)],

        source {
          display: .none
        }

        @with-variant(t.captionAttention)
        helper {
          left: .nil,
          display: .visible,
          contents: "Updated while you edited. Your draft is kept."
        }
      }
    }
  }

  latest = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 4px},
    border: {color: c.colors.borderSoft, sides: .left},
    padding: [0px, 0px, 0px, 12px],
    children: [meta, note],

    meta = text : t.caption {
      width: 100%,
      contents: "Latest",
      fill[0].color: c.colors.muted
    }

    note = text : t.small {
      width: 100%,
      contents: "Baton repo is ~/src/baton on MacBook Pro and ~/work/baton-release on Ubuntu Dev."
    }
  }
}

reviewMemory = frame : conflictMemory {
  title: "Project memory / Review latest",
  caption: "Compare the latest text with your draft, then save.",
  left: 1728px,
  top: 2160px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            connections[0].target: savedMemory,

            label {
              contents: "Save memory"
            }
          }
        }
      }

      content {
        helper {
          display: .none
        }

        editor {
          value {
            contents: "Baton repo is ~/src/baton on MacBook Pro and ~/work/baton-release on Ubuntu Dev. Verify both before merging."
          }
        }
      }
    }
  }
}

savedMemory = frame : memory {
  title: "Project memory / Saved",
  caption: "The editor closes after saving and the note shows the new text.",
  left: 3456px,
  top: 2160px,

  overview {
    body {
      overviews.overviewMemory.mem1 {
        content {
          contents: "Baton repo is ~/src/baton on MacBook Pro and ~/work/baton-release on Ubuntu Dev. Verify both before merging."
        }
      }
    }
  }
}

archivedMemory = frame : memory {
  title: "Archived project / Memory",
  caption: "Read retained notes. Archived projects have no memory editor.",
  left: 0px,
  top: 3240px,

  overview {
    body {
      overrides: [remove(overviews.overviewMemory.addMemory)],

      overviews.overviewMemory.mem2 {
        connections[0]: .nil
      }

      overviews.overviewMemory.mem1 {
        connections[0]: .nil
      }
    }

    summary {
      runtime {
        runtimeCard {
          runtimeNote {
            display: .none
          }

          runtimeLine {
            @with-variant(status.labelIdle)
            runtimeState {
              caption {
                contents: "Archived"
              }
            }

            runtimeDevice {
              display: .none
            }
          }
        }
      }

      goal {
        goalHead {
          goalEdit {
            display: .none
          }
        }
      }
    }
  }

  main {
    dock {
      overrides: [
        insert(archiveBanner, after = .nil),
        remove(page.projectPage.main.dock.composer)
      ]
    }

    transcript {
      overrides: [remove(page.projectPage.main.transcript.typing)]
    }

    @with-variant(headers.headerIdle)
    header {
      lead {
        state {
          caption {
            contents: "Archived"
          }
        }
      }

      top: .nil
    }
  }

  sidebar {
    top {
      projects {
        projBaton {
          trail {
            live {
              display: .none
            }
          }
        }
      }

      nav {
        navInbox {
          trail {
            count {
              value {
                contents: "2"
              }
            }
          }
        }
      }
    }
  }

  archiveBanner = frame : banners.banner {
    action {
      display: .none
    }

    copy {
      heading {
        contents: "Project archived"
      }

      detail {
        display: .visible,
        contents: "Read-only. Threads keep running."
      }
    }
  }
}

addingMemory = frame : addMemory {
  title: "Project memory / Adding",
  caption: "Saving a new note keeps the draft visible until it is stored.",
  left: 1728px,
  top: 3240px,

  scrim {
    form {
      footer {
        actions {
          confirm {
            connections[0].target: addedMemory,

            label {
              contents: "Saving…"
            }
          }
        }
      }
    }
  }
}

addedMemory = frame : memory {
  title: "Project memory / Added",
  caption: "The new note joins the list. The assistant reads it with the next message.",
  left: 3456px,
  top: 3240px,

  overview {
    tabBar {
      memoryTab {
        count {
          contents: "5"
        }
      }
    }

    body {
      overrides: [insert(newNote, after = overviews.overviewMemory.mem4)]
    }
  }

  newNote = frame : overviews.memoryRow {
    width: 100%,
    connections[0].target: editMemory,

    content {
      contents: "Release verification runs on Windows and Ubuntu before merging."
    }
  }
}

stoppedMemory = frame : memory {
  title: "Project memory / Stopped using",
  caption: "A stopped note leaves the list and the assistant no longer reads it. Open Not in use to restore it.",
  left: 0px,
  top: 4320px,

  overview {
    body {
      overrides: [
        insert(stoppedHead, after = overviews.overviewMemory.addMemory),
        remove(overviews.overviewMemory.mem1)
      ]
    }

    tabBar {
      memoryTab {
        count {
          contents: "3"
        }
      }
    }
  }

  stoppedHead = frame : overviews.groupHead {
    width: 100%,
    padding-top: 6px,
    padding-left: 8px,
    padding-right: 8px,

    @with-variant(icons.chevronRight)
    extra {}

    lead {
      count {
        contents: "1"
      }

      label {
        contents: "Not in use"
      }
    }
  }
}
