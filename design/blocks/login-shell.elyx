import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/input.elyx" as inputs
import "controls/field.elyx" as fields
import "controls/brand.elyx" as logos
import "resources/assets/backdrop-day.jpg" as scene
import "resources/assets/backdrop-day-frost.jpg" as frost
import "resources/assets/backdrop-night.jpg" as nightScene
import "resources/assets/backdrop-night-frost.jpg" as nightFrost

export loginPage = frame {
  title: "Sign in",
  caption: "Sign in with the account provided by your administrator.",
  left: 0px,
  top: 0px,
  width: s.size.screenWidth,
  height: s.size.screenHeight,
  layout: {justify-content: .center, align-items: .center},
  fill: {image: {ref: scene}},
  children: column,

  // Glass panel centered on the page, so the blurred copy lines up with zero offset.
  column = frame {
    width: 400px,
    layout: {direction: .column, align-items: .center, item-gap: s.space.xl},
    fill: [
      {image: {ref: frost, sizing: {scale: 0.75, offset: [0px, 0px]}}},
      c.colors.glass
    ],
    border: c.colors.glassEdge,
    shadow: {
      drop-shadow: {
        color: c.colors.shadowFar,
        offset: point(0px, 24px),
        blur-radius: 64px
      }
    },
    corner-radius: 24px,
    padding: [36px, 32px, 28px],
    children: [brand, notice, card, note],

    brand = frame {
      layout: {direction: .column, align-items: .center, item-gap: s.space.md},
      children: [mark, heading],

      mark = asset : logos.colorMark {
        width: 36px,
        height: 36px
      }

      heading = text : t.title {
        contents: "Sign in to Baton"
      }
    }

    notice = frame {
      width: 100%,
      display: .none,
      layout: {direction: .column, item-gap: s.space.xxs},
      fill: c.colors.panel,
      border: c.colors.borderSoft,
      corner-radius: 10px,
      padding: [10px, 14px],
      children: [noticeHeading, noticeDetail],

      noticeHeading = text : t.label {
        contents: "Password reset by administrator"
      }

      noticeDetail = text : t.caption {
        width: 100%,
        contents: "Previous sessions have been signed out. Sign in with your new password.",
        fill[0].color: c.colors.muted
      }
    }

    card = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [account, secret, submit],

      account = frame : fields.field {
        width: 100%,

        helper {
          display: .none
        }

        @with-variant(inputs.filled)
        input {
          value {
            contents: "chen.lin"
          }

          top: .nil
        }

        label {
          labelText {
            contents: "Username"
          }
        }
      }

      secret = frame : fields.field {
        width: 100%,

        helper {
          display: .none
        }

        @with-variant(inputs.filled)
        input {
          value {
            contents: "••••••••••••"
          }

          top: .nil
        }

        label {
          labelText {
            contents: "Password"
          }
        }
      }

      submit = frame : buttons.button {
        width: 100%,

        label {
          contents: "Sign in"
        }
      }
    }

    note = text : t.caption {
      width: 100%,
      contents: "Contact your administrator if you need an account or password reset.",
      fill[0].color: c.colors.muted
    }
  }
}

@context(theme="dark")
export loginPageDark = frame : loginPage {
  title: "Sign in / Dark",
  left: 1728px,
  top: 0px,
  fill[0].image.ref: nightScene,

  column {
    fill[0].image.ref: nightFrost,

    brand {
      @with-variant(logos.colorMarkDark)
      mark {}
    }
  }
}

export signedOutPage = frame : loginPage {
  title: "Sign in / Signed out",
  caption: "The account session has ended. Sign in to open the workspace.",
  left: 0px,
  top: 1080px,

  column {
    card {
      secret {
        input {
          value {
            contents: "Password"
          }
        }
      }
    }

    notice {
      noticeHeading {
        contents: "You are signed out"
      }

      noticeDetail {
        contents: "Sign in to view your devices, chats, and projects."
      }

      display: .visible
    }
  }
}

@context(theme="dark")
export signedOutPageDark = frame : signedOutPage {
  title: "Signed out / Dark",
  left: 1728px,
  top: 1080px,
  fill[0].image.ref: nightScene,

  column {
    fill[0].image.ref: nightFrost,

    brand {
      @with-variant(logos.colorMarkDark)
      mark {}
    }
  }
}
