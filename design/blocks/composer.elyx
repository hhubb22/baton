import "tokens/colors.elyx" as c
import "controls/button.elyx" as buttons
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/tabs.elyx" as tabs
import "controls/chip.elyx" as chips

// Composer: messages the Project Agent.
// Same width as the conversation column, white surface, hairline border, two soft shadows. Remains available when all devices are offline or the Project is paused.
export composer = frame {
  title: "Composer / Message",
  width: s.size.measure,
  layout: {direction: .column, item-gap: 18px},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: [
    {
      drop-shadow: {
        color: c.colors.shadowSoft,
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    {
      drop-shadow: {
        color: c.colors.shadowNear,
        offset: point(0px, 8px),
        blur-radius: 24px
      }
    }
  ],
  corner-radius: 20px,
  padding: [16px, 12px, 12px, 18px],
  children: [prompt, toolbar],

  prompt = text : t.placeholder {
    width: 100%,
    contents: "Ask the project assistant…"
  }

  toolbar = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [lead, send],

    lead = frame {
      width: 100%,
      layout: {
        align-items: .center,
        item-gap: s.space.xxs,
        wrap: .true,
        line-gap: 8px
      },
      children: [location, model, access, hint],

      location = frame : chips.chip {
        display: .none
      }

      model = frame : chips.chipModel {
        display: .none
      }

      access = frame : chips.chipAccess {
        display: .none
      }

      hint = text : t.caption {
        display: .none,
        contents: "Sends when online",
        fill[0].color: c.colors.faint
      }
    }

    send = frame : buttons.sendButtonIdle {}
  }
}

@variant
export composerFilled = frame : composer {
  title: "Composer / Filled",
  top: 160px,

  toolbar {
    @with-variant(buttons.sendButton)
    send {
      top: .nil
    }
  }

  @with-variant(t.body)
  prompt {
    contents: "Also run the unit test suite on Ubuntu."
  }
}

// New Thread: top composer on the Threads page. Location prefills the last directory on the default device, model prefills the last Agent and model at that location;
// the Agent follows the model and is shown in the placeholder. Access lists what that Agent supports. Sending the first message creates the Thread
@variant
export composerNewThread = frame : composer {
  title: "Composer / New thread",
  top: 320px,

  prompt {
    contents: "Message Codex…"
  }

  toolbar {
    lead {
      location {
        display: .visible
      }

      model {
        display: .visible
      }

      access {
        display: .visible
      }
    }
  }
}

// Selected a location on an offline device: can still send; the Thread starts once the device comes online
@variant
export composerNewThreadOffline = frame : composerNewThread {
  title: "Composer / New thread / Offline device",
  top: 500px,

  toolbar {
    lead {
      location {
        label {
          contents: "baton · Ubuntu Dev"
        }
      }

      model {
        label {
          contents: "claude-opus-5.5"
        }
      }

      access {
        label {
          contents: "No sandbox"
        }
      }

      hint {
        display: .visible
      }
    }
  }

  prompt {
    contents: "Message Pi…"
  }
}

// Thread composer: messages the Thread's Agent directly. The Agent is named in the placeholder and fixed for the life of the Thread.
// The model chip lists only models for that Agent; the next turn starts with the selected model.
// While running, messages queue by default and can be withdrawn before delivery; Steer is available when the Agent supports it.
export threadComposer = frame {
  title: "Thread composer / Idle",
  top: 700px,
  width: 480px,
  layout: {direction: .column, item-gap: 14px},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: [
    {
      drop-shadow: {
        color: c.colors.shadowSoft,
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    {
      drop-shadow: {
        color: c.colors.shadowNear,
        offset: point(0px, 8px),
        blur-radius: 24px
      }
    }
  ],
  corner-radius: 20px,
  padding: [14px, 10px, 10px, 16px],
  children: [prompt, toolbar],

  prompt = text : t.placeholder {
    width: 100%,
    contents: "Message Codex…"
  }

  toolbar = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [delivery, actions],

    delivery = frame {
      width: 100%,
      layout: {direction: .column, item-gap: 6px},
      children: [picks, hint],

      picks = frame {
        width: 100%,
        layout: {
          align-items: .center,
          item-gap: s.space.xs,
          wrap: .true,
          line-gap: 8px
        },
        children: [model, access, mode],

        model = frame : chips.chipModel {}

        // Set when the Thread is created; opens a menu that shows the current access and what it means
        access = frame : chips.chipAccess {}

        mode = frame : tabs.segmented {
          display: .none
        }
      }

      hint = text : t.caption {
        width: 100%,
        display: .none,
        contents: "Sends after current reply",
        fill[0].color: c.colors.faint
      }
    }

    actions = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [stop, send],

      stop = frame {
        width: s.size.control,
        height: s.size.control,
        display: .none,
        layout: {justify-content: .center, align-items: .center},
        fill: c.colors.subtle,
        corner-radius: s.radius.pill,
        children: stopGlyph,

        stopGlyph = asset : icons.stop {
          width: 14px,
          height: 14px,
          fill[0].color: c.colors.text
        }
      }

      send = frame : buttons.sendButtonIdle {}
    }
  }
}

// Agent running: choose Queue or Steer, or stop the current turn
@variant
export threadComposerRunning = frame : threadComposer {
  title: "Thread composer / Running",
  top: 840px,

  toolbar {
    delivery {
      picks {
        mode {
          display: .visible
        }
      }
    }

    actions {
      stop {
        display: .visible
      }
    }
  }
}

// Kiro does not support steering; only Queue is offered while running
@variant
export threadComposerQueueOnly = frame : threadComposer {
  title: "Thread composer / Send next only",
  top: 1020px,

  toolbar {
    delivery {
      picks {
        model {
          label {
            contents: "claude-sonnet-5.5"
          }
        }

        access {
          label {
            contents: "No sandbox"
          }
        }
      }

      hint {
        display: .visible
      }
    }

    actions {
      stop {
        display: .visible
      }
    }
  }

  prompt {
    contents: "Message Kiro…"
  }
}

// Stop requested: if the Agent does not stop within 1 minute, the device terminates its process
@variant
export threadComposerStopping = frame : threadComposer {
  title: "Thread composer / Stopping",
  top: 1200px,

  toolbar {
    actions {
      stop {
        fill[0].color: c.colors.selected,

        stopGlyph {
          fill[0].color: c.colors.muted
        }

        display: .visible
      }
    }

    delivery {
      hint {
        contents: "Stopping…",
        display: .visible
      }
    }
  }
}
