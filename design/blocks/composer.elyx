import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/tabs.elyx" as tabs
import "controls/chip.elyx" as chips

// 输入区：给 Project Agent 发消息。
// 和对话列同宽，白底、发丝线外框、两层浅阴影。所有设备离线或 Project 暂停时仍然可以发消息。
export composer = frame {
  title: "输入区 / 发消息",
  width: s.size.measure,
  layout: {direction: .column, item-gap: 18px},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: [
    {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 3%),
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 6%),
        offset: point(0px, 8px),
        blur-radius: 24px
      }
    }
  ],
  corner-radius: 20px,
  padding: [16px, 12px, 12px, 18px],
  children: [prompt, toolbar],

  prompt = text : t.body {
    width: 100%,
    contents: "给 Project Agent 发消息",
    fill[0].color: c.colors.faint
  }

  toolbar = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [lead, send],

    lead = frame {
      layout: {align-items: .center, item-gap: s.space.xxs},
      children: [location, model, hint],

      location = frame : chips.chip {
        display: .none
      }

      model = frame : chips.chipModel {
        display: .none
      }

      hint = text : t.caption {
        display: .none,
        contents: "离线，上线后开始",
        fill[0].color: c.colors.faint
      }
    }

    send = frame {
      width: s.size.control,
      height: s.size.control,
      layout: {justify-content: .center, align-items: .center},
      fill: c.colors.accent,
      corner-radius: s.radius.pill,
      children: sendGlyph,

      sendGlyph = asset : icons.arrowUp {
        width: 16px,
        height: 16px,
        fill[0].color: c.colors.onAccent
      }
    }
  }
}

@variant
export composerFilled = frame : composer {
  title: "输入区 / 已输入",
  top: 160px,

  prompt {
    fill[0].color: c.colors.text,
    contents: "Ubuntu 上也顺便跑一遍单元测试。"
  }
}

// 新建 Thread：Thread 页顶部的输入区。位置预填默认设备上次用的目录，模型预填这个位置上次用的 Agent 和模型；
// Agent 跟着模型走，只写在提示文字里。发出第一条消息即新建
@variant
export composerNewThread = frame : composer {
  title: "输入区 / 新建 Thread",
  top: 320px,

  prompt {
    contents: "给 Codex 发消息"
  }

  toolbar {
    lead {
      location {
        display: .visible
      }

      model {
        display: .visible
      }
    }
  }
}

// 选了离线设备上的位置：照样可以发，Thread 等设备上线后开始
@variant
export composerNewThreadOffline = frame : composerNewThread {
  title: "输入区 / 新建 Thread / 设备离线",
  top: 440px,

  toolbar {
    lead {
      location {
        label {
          contents: "baton · Ubuntu 开发机"
        }
      }

      model {
        label {
          contents: "claude-opus-5.5"
        }
      }

      hint {
        display: .visible
      }
    }
  }

  prompt {
    contents: "给 Pi 发消息"
  }
}

// Thread 输入区：消息直接发给这个 Thread 的 Agent，Agent 写在提示文字里，新建后不能换。
// 模型选择片只列这个 Agent 的模型，新的一轮从选中的模型开始。
// Agent 执行中时消息默认排队，发出前可以撤回；只有 Agent 支持时才能选「插入」。
export threadComposer = frame {
  title: "Thread 输入区 / 空闲",
  top: 600px,
  width: 480px,
  layout: {direction: .column, item-gap: 14px},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: [
    {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 3%),
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 6%),
        offset: point(0px, 8px),
        blur-radius: 24px
      }
    }
  ],
  corner-radius: 18px,
  padding: [14px, 10px, 10px, 16px],
  children: [prompt, toolbar],

  prompt = text : t.body {
    width: 100%,
    contents: "给 Codex 发消息",
    fill[0].color: c.colors.faint
  }

  toolbar = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [delivery, actions],

    delivery = frame {
      layout: {align-items: .center, item-gap: s.space.xs},
      children: [model, mode, hint],

      model = frame : chips.chipModel {}

      mode = frame : tabs.segmented {
        display: .none
      }

      hint = text : t.caption {
        display: .none,
        contents: "Kiro 不支持插入，消息会排队",
        fill[0].color: c.colors.faint
      }
    }

    actions = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [stop, send],

      stop = frame {
        width: s.size.control,
        height: s.size.control,
        display: .none,
        layout: {justify-content: .center, align-items: .center},
        fill: c.colors.subtle,
        corner-radius: s.radius.pill,
        children: stopGlyph,

        stopGlyph = asset : icons.stop {
          width: 14px,
          height: 14px,
          fill[0].color: c.colors.text
        }
      }

      send = frame {
        width: s.size.control,
        height: s.size.control,
        layout: {justify-content: .center, align-items: .center},
        fill: c.colors.accent,
        corner-radius: s.radius.pill,
        children: sendGlyph,

        sendGlyph = asset : icons.arrowUp {
          width: 16px,
          height: 16px,
          fill[0].color: c.colors.onAccent
        }
      }
    }
  }
}

// Agent 执行中：可以选排队或插入，也可以停止这一轮
@variant
export threadComposerRunning = frame : threadComposer {
  title: "Thread 输入区 / 执行中",
  top: 720px,

  toolbar {
    delivery {
      mode {
        display: .visible
      }
    }

    actions {
      stop {
        display: .visible
      }
    }
  }
}

// Kiro 不支持插入，执行中只提供排队
@variant
export threadComposerQueueOnly = frame : threadComposer {
  title: "Thread 输入区 / 只能排队",
  top: 840px,

  prompt {
    contents: "给 Kiro 发消息"
  }

  toolbar {
    delivery {
      model {
        label {
          contents: "claude-sonnet-5.5"
        }
      }

      hint {
        display: .visible
      }
    }

    actions {
      stop {
        display: .visible
      }
    }
  }
}

// 停止请求已发出：Agent 1 分钟内没停下，设备会结束它的进程
@variant
export threadComposerStopping = frame : threadComposer {
  title: "Thread 输入区 / 正在停止",
  top: 960px,

  toolbar {
    actions {
      stop {
        fill[0].color: c.colors.selected,

        stopGlyph {
          fill[0].color: c.colors.muted
        }

        display: .visible
      }
    }

    delivery {
      hint {
        contents: "已请求停止，1 分钟内没停下会结束进程",
        display: .visible
      }
    }
  }
}
