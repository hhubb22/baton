import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "resources/assets/backdrop-day-frost.jpg" as backdrop
import "foundations/typography.elyx" as t
import "controls/status.elyx" as status
import "controls/avatar.elyx" as avatars
import "controls/input.elyx" as inputs
import "blocks/sidebar.elyx" as sidebars
import "controls/button.elyx" as buttons
import "blocks/overview.elyx" as overviews
import "blocks/thread-detail.elyx" as details
import "blocks/composer.elyx" as composers

// Thread list row: status dot, title, parent Project, device · Agent, working directory, state, and last activity time.
// State column: running shows the current turn's elapsed timer; Needs attention rows name the reason; Waiting and Idle rows leave it blank because the group heading already says it. Standalone Threads leave the Project column blank
export threadListRow = frame {
  title: "Thread list row / Running",
  width: 1192px,
  height: 40px,
  layout: {align-items: .center, item-gap: s.space.md},
  padding: [0px, 20px],
  children: [lead, project, place, dir, state, time],

  lead = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: 10px},
    children: [mark, name],

    mark = frame {
      width: 16px,
      height: 16px,
      layout: {justify-content: .center, align-items: .center},
      children: dot,

      dot = shape : status.dot {}
    }

    name = text : t.small {
      contents: "Run reconnect tests on Windows",
      line-height: 1
    }
  }

  project = frame {
    width: 144px,
    layout: {align-items: .center, item-gap: 6px},
    children: [projectMark, projectName],

    projectMark = frame : avatars.avatar {
      width: 16px,
      height: 16px,
      corner-radius: 4px,

      initial {
        font-size: 9
      }
    }

    projectName = text : t.caption {
      contents: "Baton Dev",
      line-height: 1,
      fill[0].color: c.colors.muted
    }
  }

  place = text : t.caption {
    width: 156px,
    contents: "Windows Desktop · Codex",
    line-height: 1,
    fill[0].color: c.colors.muted
  }

  dir = text : t.mono {
    width: 168px,
    contents: "D:\\src\\baton-ps160",
    line-height: 1,
    fill[0].color: c.colors.faint
  }

  state = text : t.caption {
    width: 108px,
    contents: "03:12",
    font-family: "Paper Mono",
    line-height: 1,
    fill[0].color: c.colors.accentText
  }

  time = text : t.caption {
    width: 64px,
    contents: "Just now",
    line-height: 1,
    align: .right,
    fill[0].color: c.colors.faint
  }
}

@variant
export threadListRowIdle = frame : threadListRow {
  title: "Thread list row / Idle",
  top: 64px,

  state {
    fill[0].color: c.colors.muted,
    contents: "",
    font-family: "Inter"
  }

  time {
    contents: "2h ago"
  }

  lead {
    mark {
      @with-variant(status.dotIdle)
      dot {
        left: .nil
      }
    }
  }
}

@variant
export threadListRowWaiting = frame : threadListRow {
  title: "Thread list row / Waiting for device",
  top: 128px,

  state {
    fill[0].color: c.colors.muted,
    contents: "",
    font-family: "Inter"
  }

  time {
    contents: "5m ago"
  }

  lead {
    mark {
      @with-variant(status.dotQueued)
      dot {
        left: .nil
      }
    }
  }
}

@variant
export threadListRowStopped = frame : threadListRow {
  title: "Thread list row / Stopped",
  top: 192px,

  state {
    fill[0].color: c.colors.danger,
    contents: "Stopped",
    font-family: "Inter"
  }

  time {
    contents: "20m ago"
  }

  lead {
    mark {
      @with-variant(status.dotStopped)
      dot {
        left: .nil
      }
    }
  }
}

@variant
export threadListRowUnknown = frame : threadListRow {
  title: "Thread list row / Status unknown",
  top: 256px,

  state {
    fill[0].color: c.colors.attentionText,
    contents: "Status unknown",
    font-family: "Inter"
  }

  time {
    contents: "8m ago"
  }

  lead {
    mark {
      @with-variant(status.dotAttention)
      dot {
        left: .nil
      }
    }
  }
}

@variant
export threadListRowArchived = frame : threadListRowIdle {
  title: "Thread list row / Archived",
  top: 320px,

  lead {
    name {
      fill[0].color: c.colors.muted
    }
  }

  state {
    fill[0].color: c.colors.muted,
    contents: "Archived",
    font-family: "Inter"
  }

  time {
    contents: "Last week"
  }
}

// Selected when its detail panel is open on the right
@variant
export threadListRowSelected = frame : threadListRow {
  title: "Thread list row / Selected",
  top: 384px,
  fill[0].color: c.colors.selected
}

// Threads page: filters by device, Project, and archive state. Groups Needs attention first, then Running, Waiting for device, and Idle;
// archived Threads are hidden by default and selectable via the state filter. Clicking a row opens its detail panel on the right
export threadsPage = frame {
  title: "Threads page",
  left: 0px,
  top: 520px,
  width: s.size.screenWidth,
  height: s.size.screenHeight,
  layout: {item-gap: s.size.gutter},
  fill: [{image: {ref: backdrop}}, c.colors.glass],
  padding: [s.size.gutter, s.size.gutter, s.size.gutter, 0px],
  children: [sidebar, main],

  sidebar = frame : sidebars.sidebar {
    height: 100%,

    top {
      projects {
        @with-variant(sidebars.projectRowLive)
        projBaton {}
      }

      nav {
        @with-variant(sidebars.navRowActive)
        navThreads {
          top: .nil
        }
      }
    }
  }

  main = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column},
    fill: c.colors.canvas,
    border: c.colors.hairline,
    shadow: [
      {
        drop-shadow: {
          color: c.colors.shadowNear,
          offset: point(0px, 1px),
          blur-radius: 3px
        }
      },
      {
        drop-shadow: {
          color: c.colors.shadowFar,
          offset: point(0px, 12px),
          blur-radius: 40px
        }
      }
    ],
    corner-radius: s.radius.lg,
    children: [head, compose, filters, list],

    head = frame {
      width: 100%,
      height: s.size.header,
      layout: {justify-content: .space-between, align-items: .center},
      border: {color: c.colors.borderSoft, sides: .bottom},
      padding: [0px, s.space.md, 0px, 20px],
      children: headTitle,

      headTitle = text : t.label {
        contents: "Threads",
        font-size: 14,
        font-style: "SemiBold"
      }
    }

    // New Thread composer: pick location and model; sending the first message creates the Thread
    compose = frame {
      width: 100%,
      layout: {direction: .column},
      padding: [20px, 20px, s.space.xs],
      children: composer,

      composer = frame : composers.composerNewThread {
        width: 100%
      }
    }

    filters = frame {
      width: 100%,
      height: 44px,
      layout: {justify-content: .space-between, align-items: .center},
      padding: [0px, 20px, 0px, 14px],
      children: [pickers, total],

      pickers = frame {
        layout: {align-items: .center, item-gap: s.space.xs},
        children: [byDevice, byProject, byState],

        byDevice = frame : inputs.selectCompact {
          value {
            contents: "All devices"
          }
        }

        byProject = frame : inputs.selectCompact {
          value {
            contents: "All projects"
          }
        }

        byState = frame : inputs.selectCompact {
          value {
            contents: "Active"
          }
        }
      }

      total = text : t.caption {
        contents: "9 threads",
        fill[0].color: c.colors.faint
      }
    }

    list = frame {
      width: 100%,
      height: 100%,
      layout: {direction: .column},
      padding: [0px, 0px, s.space.xl],
      children: [
        needsHead,
        unknownRow,
        stoppedRow,
        runningHead,
        runningRow,
        kiroRow,
        waitingHead,
        waitingRow,
        idleHead,
        idleRow1,
        idleRow2,
        idleRow3,
        idleRow4
      ],

      needsHead = frame : overviews.groupHead {
        width: 100%,
        height: 36px,
        padding-top: s.space.sm,
        padding-left: 20px,
        padding-bottom: 0px,
        padding-right: 20px,

        extra {
          display: .none
        }

        lead {
          label {
            contents: "Needs attention"
          }
        }
      }

      unknownRow = frame : threadListRowUnknown {
        width: 100%,

        lead {
          name {
            contents: "Upgrade batond on Windows"
          }
        }

        dir {
          contents: "D:\\src\\baton"
        }
      }

      stoppedRow = frame : threadListRowStopped {
        width: 100%,

        project {
          projectMark {
            display: .none
          }

          projectName {
            display: .none
          }
        }

        place {
          contents: "Ubuntu Dev · Codex"
        }

        lead {
          name {
            contents: "Run unit tests on Ubuntu"
          }
        }

        dir {
          contents: "~/src/baton-old"
        }
      }

      runningHead = frame : overviews.groupHead {
        width: 100%,
        height: 44px,
        padding-top: 16px,
        padding-left: 20px,
        padding-bottom: 0px,
        padding-right: 20px,

        extra {
          display: .none
        }
      }

      runningRow = frame : threadListRow {
        width: 100%
      }

      kiroRow = frame : threadListRow {
        width: 100%,

        project {
          projectMark {
            fill[0].color: c.hues.green,

            initial {
              contents: "S"
            }
          }

          projectName {
            contents: "Switch Patrol"
          }
        }

        state {
          contents: "18:40"
        }

        place {
          contents: "Ubuntu Dev · Kiro"
        }

        lead {
          name {
            contents: "Organize switch patrol scripts"
          }
        }

        dir {
          contents: "~/src/netops"
        }

        time {
          contents: "1m ago"
        }
      }

      waitingHead = frame : overviews.groupHead {
        width: 100%,
        height: 44px,
        padding-top: 16px,
        padding-left: 20px,
        padding-bottom: 0px,
        padding-right: 20px,

        extra {
          display: .none
        }

        lead {
          label {
            contents: "Waiting for device"
          }

          count {
            contents: "1"
          }
        }
      }

      waitingRow = frame : threadListRowWaiting {
        width: 100%,

        place {
          contents: "MacBook Pro · Codex"
        }

        lead {
          name {
            contents: "Run reconnect tests on MacBook"
          }
        }

        dir {
          contents: "~/src/baton"
        }
      }

      idleHead = frame : overviews.groupHead {
        width: 100%,
        height: 44px,
        padding-top: 16px,
        padding-left: 20px,
        padding-bottom: 0px,
        padding-right: 20px,

        extra {
          display: .none
        }

        lead {
          label {
            contents: "Idle"
          }

          count {
            contents: "4"
          }
        }
      }

      idleRow1 = frame : threadListRowIdle {
        width: 100%,

        project {
          projectMark {
            display: .none
          }

          projectName {
            display: .none
          }
        }

        place {
          contents: "MacBook Pro · Codex"
        }

        lead {
          name {
            contents: "Fix web build warnings"
          }
        }

        dir {
          contents: "~/src/baton"
        }
      }

      idleRow2 = frame : threadListRowIdle {
        width: 100%,

        lead {
          name {
            contents: "Add reconnect logging to gateway"
          }
        }

        dir {
          contents: "D:\\src\\baton"
        }

        time {
          contents: "Yesterday"
        }
      }

      idleRow3 = frame : threadListRowIdle {
        width: 100%,

        project {
          projectMark {
            fill[0].color: c.hues.green,

            initial {
              contents: "S"
            }
          }

          projectName {
            contents: "Switch Patrol"
          }
        }

        place {
          contents: "Ubuntu Dev · Kiro"
        }

        lead {
          name {
            contents: "Verify PICOS versions"
          }
        }

        dir {
          contents: "~/src/netops"
        }

        time {
          contents: "Yesterday"
        }
      }

      idleRow4 = frame : threadListRowIdle {
        width: 100%,

        project {
          projectMark {
            display: .none
          }

          projectName {
            display: .none
          }
        }

        place {
          contents: "MacBook Pro · Pi"
        }

        lead {
          name {
            contents: "Write batond setup guide"
          }
        }

        dir {
          contents: "~/src/baton"
        }

        time {
          contents: "3d ago"
        }
      }
    }
  }
}

// Detail open: shows Thread detail panel on the right and collapses the Project and directory columns in the list
@variant
export threadsPageSplit = frame : threadsPage {
  title: "Threads page / Detail open",
  left: 0px,
  top: 1520px,
  overrides: [insert(detail, after = threadsPage.main)],

  main {
    list {
      runningRow {
        fill[0].color: c.colors.selected,

        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      unknownRow {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      stoppedRow {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      kiroRow {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      waitingRow {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      idleRow1 {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      idleRow2 {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      idleRow3 {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }

      idleRow4 {
        project {
          display: .none
        }

        dir {
          display: .none
        }
      }
    }
  }

  // Threads page has no Overview panel to return to, so Back is hidden
  detail = frame : details.threadDetailRunning {
    height: 100%,

    head {
      lead {
        back {
          display: .none
        }
      }
    }
  }
}

export listFeedback = frame {
  title: "Thread list feedback",
  left: 0px,
  top: 2600px,
  width: 600px,
  height: 300px,
  layout: {
    direction: .column,
    justify-content: .center,
    align-items: .center,
    item-gap: 8px
  },
  children: [heading, description, action],

  heading = text : t.label {
    contents: "No chats yet"
  }

  description = text : t.small {
    width: 380px,
    contents: "Choose a folder and model above, then send your first message.",
    align: .center,
    fill[0].color: c.colors.muted
  }

  action = frame : buttons.smallSecondary {
    label {
      contents: "Write first message"
    }
  }
}

@variant
export threadsPageEmpty = frame : threadsPage {
  title: "Threads / Empty",
  caption: "Write first message focuses the new chat input above.",
  left: 0px,
  top: 3100px,

  main {
    overrides: [insert(feedback, after = threadsPage.main.list)],

    list {
      display: .none
    }

    filters {
      total {
        contents: "0 threads"
      }
    }
  }

  feedback = frame : listFeedback {
    width: 100%,
    height: 100%
  }
}

@variant
export threadsPageNoResults = frame : threadsPageEmpty {
  title: "Threads / No filter results",
  caption: "Clear filters restores the full list and keeps the draft.",
  left: 1728px,
  top: 3100px,

  main {
    filters {
      pickers {
        byDevice {
          value {
            contents: "MacBook Pro"
          }
        }

        byProject {
          value {
            contents: "Switch Patrol"
          }
        }

        byState {
          value {
            contents: "Archived"
          }
        }
      }
    }

    feedback {
      heading {
        contents: "No chats match these filters"
      }

      description {
        contents: "Try another device, project, or archive filter."
      }

      action {
        label {
          contents: "Clear filters"
        }
      }
    }
  }
}

@variant
export threadsPageLoading = frame : threadsPageEmpty {
  title: "Threads / Loading",
  caption: "Fetch the list while keeping the new chat input available.",
  left: 3456px,
  top: 3100px,

  main {
    feedback {
      action {
        display: .none
      }

      heading {
        contents: "Loading chats…"
      }

      description {
        contents: "Your list will appear here."
      }
    }

    filters {
      total {
        contents: "Loading…"
      }
    }
  }
}

@variant
export threadsPageFailed = frame : threadsPageEmpty {
  title: "Threads / Loading failed",
  caption: "Retry keeps the current filters and new chat draft.",
  left: 0px,
  top: 4280px,

  main {
    filters {
      total {
        contents: "List unavailable"
      }
    }

    feedback {
      heading {
        contents: "Could not load chats"
      }

      description {
        contents: "Check your connection and try again."
      }

      action {
        label {
          contents: "Retry"
        }
      }
    }
  }
}
