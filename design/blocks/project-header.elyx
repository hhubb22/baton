import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/avatar.elyx" as avatars
import "controls/status.elyx" as status

// Project header: Project title and current Project Agent state. State copy explains which device it is running on or why it is not running.
export projectHeader = frame {
  title: "Project header / Running",
  width: 872px,
  height: s.size.header,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: s.space.lg
  },
  border: {color: c.colors.borderSoft, sides: .bottom},
  padding: [0px, s.space.md, 0px, 20px],
  children: [lead, trail],

  lead = frame {
    layout: {align-items: .center, item-gap: s.space.md},
    children: [identity, state],

    identity = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [avatar, name],

      avatar = frame : avatars.avatar {}

      name = text : t.label {
        contents: "Baton Dev",
        font-size: 14,
        font-style: "SemiBold"
      }
    }

    state = frame : status.labelAgent {
      overrides: [insert(stop, after = status.label.caption)],

      caption {
        contents: "Running on Ubuntu Dev"
      }

      stop = frame : buttons.smallGhost {
        height: 24px,
        padding-left: 6px,
        padding-right: 6px,

        label {
          contents: "Stop run"
        }

        @with-variant(icons.stop)
        lead {
          width: 12px,
          height: 12px,
          display: .visible
        }
      }
    }
  }

  trail = frame {
    layout: {align-items: .center, item-gap: s.space.xxs},
    children: [overview, more],

    overview = frame : buttons.iconButtonOn {
      @with-variant(icons.panelRight)
      glyph {}
    }

    more = frame : buttons.iconButton {}
  }
}

@variant
export headerIdle = frame : projectHeader {
  title: "Project header / Idle",
  top: 80px,

  lead {
    @with-variant(status.labelIdle)
    state {
      stop {
        display: .none
      }

      caption {
        contents: "Idle on Ubuntu Dev"
      }
    }
  }
}

@variant
export headerWaiting = frame : projectHeader {
  title: "Project header / Waiting for device",
  top: 160px,

  lead {
    @with-variant(status.labelQueued)
    state {
      stop {
        display: .none
      }

      caption {
        contents: "Waiting for a device"
      }
    }
  }
}

@variant
export headerAttention = frame : projectHeader {
  title: "Project header / Needs attention",
  top: 240px,

  lead {
    @with-variant(status.labelAttention)
    state {
      stop {
        display: .none
      }

      caption {
        contents: "Sign-in expired"
      }
    }
  }
}

@variant
export headerPaused = frame : projectHeader {
  title: "Project header / Paused",
  top: 320px,

  lead {
    @with-variant(status.labelIdle)
    state {
      stop {
        display: .none
      }

      caption {
        contents: "Paused"
      }
    }
  }
}
