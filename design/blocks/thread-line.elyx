import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/status.elyx" as status

// Thread row: each Thread opened or messaged by the Project Agent occupies one row in the main conversation and opens its detail on the right when clicked.
// Status dot, title, directory name in faint mono, trailing device · Agent, and state: running shows the current turn's elapsed timer; other states show only the state name.
export threadLine = frame {
  title: "Thread row / Running",
  width: s.size.measure,
  height: 36px,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: s.space.lg
  },
  corner-radius: s.radius.md,
  padding: [0px, s.space.sm],
  children: [lineLead, lineTrail],

  lineLead = frame {
    layout: {align-items: .center, item-gap: 10px},
    children: [lineMark, lineName, lineTag],

    lineMark = frame {
      width: 16px,
      height: 16px,
      layout: {justify-content: .center, align-items: .center},
      children: lineDot,

      lineDot = shape : status.dot {
        width: 7px,
        height: 7px
      }
    }

    lineName = text : t.body {
      contents: "Run reconnect tests on Windows",
      line-height: 1
    }

    lineTag = frame {
      height: 20px,
      layout: {align-items: .center},
      children: lineTagText,

      lineTagText = text : t.mono {
        contents: "baton-ps160",
        line-height: 1,
        fill[0].color: c.colors.faint
      }
    }
  }

  lineTrail = frame {
    layout: {align-items: .center, item-gap: s.space.md},
    children: [lineMeta, lineState],

    lineMeta = text : t.small {
      contents: "Windows Desktop · Codex",
      line-height: 1,
      fill[0].color: c.colors.faint
    }

    lineState = text : t.mono {
      width: 56px,
      contents: "03:12",
      line-height: 1,
      align: .right,
      fill[0].color: c.colors.accentText
    }
  }
}

@variant
export threadLineIdle = frame : threadLine {
  title: "Thread row / Idle",
  top: 56px,

  lineTrail {
    lineState {
      fill[0].color: c.colors.muted,
      contents: "Idle",
      font-size: 13,
      font-family: "Inter"
    }

    lineMeta {
      contents: "Ubuntu Dev · Codex"
    }
  }

  lineLead {
    lineTag {
      lineTagText {
        contents: "baton"
      }
    }

    lineName {
      contents: "Run unit tests on Ubuntu"
    }

    lineMark {
      @with-variant(status.dotIdle)
      lineDot {
        left: .nil
      }
    }
  }
}

@variant
export threadLineQueued = frame : threadLine {
  title: "Thread row / Waiting for device",
  top: 112px,

  lineTrail {
    lineState {
      fill[0].color: c.colors.muted,
      width: .auto,
      contents: "Waiting for device",
      font-size: 13,
      font-family: "Inter"
    }

    lineMeta {
      contents: "MacBook Pro · Codex"
    }
  }

  lineLead {
    lineTag {
      lineTagText {
        contents: "baton"
      }
    }

    lineName {
      contents: "Push PS-160 branch"
    }

    lineMark {
      @with-variant(status.dotQueued)
      lineDot {
        left: .nil
      }
    }
  }
}

@variant
export threadLineStopped = frame : threadLine {
  title: "Thread row / Stopped",
  top: 168px,

  lineTrail {
    lineState {
      fill[0].color: c.colors.muted,
      contents: "Stopped",
      font-size: 13,
      font-family: "Inter"
    }
  }

  lineLead {
    lineMark {
      @with-variant(status.dotStopped)
      lineDot {
        left: .nil
      }
    }
  }
}

// Selected when its detail panel is open on the right
@variant
export threadLineSelected = frame : threadLineIdle {
  title: "Thread row / Selected",
  top: 224px,
  fill[0].color: c.colors.selected,

  lineLead {
    lineTag {
      lineTagText {
        contents: "baton-ps160"
      }
    }

    lineName {
      contents: "Run reconnect tests on Windows"
    }
  }

  lineTrail {
    lineMeta {
      contents: "Windows Desktop · Codex"
    }
  }
}

// Thread group: Threads opened or messaged in a single Project Agent turn, one row per Thread on a branch rail. No card surface.
// Card heading summarizes the turn's action; top-right shows the most notable state among them.
export threadCard = frame {
  title: "Thread card / Running",
  top: 320px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: s.space.xs},
  children: [cardHead, cardRows],

  cardHead = frame {
    width: 100%,
    height: 24px,
    layout: {justify-content: .space-between, align-items: .center},
    children: [cardTitle, cardState],

    cardTitle = frame {
      layout: {align-items: .center, item-gap: 6px},
      children: cardName,

      cardName = text : t.label {
        contents: "Opened 2 threads",
        line-height: 1,
        fill[0].color: c.colors.muted
      }
    }

    cardState = frame : status.label {
      caption {
        contents: "1 running",
        line-height: 1
      }
    }
  }

  cardRows = frame {
    width: 100%,
    layout: {direction: .column},
    border: {color: c.colors.borderSoft, sides: .left},
    padding: [0px, 0px, 0px, 6px],
    children: [row1, row2],

    row1 = frame : threadLine {
      width: 100%
    }

    row2 = frame : threadLineIdle {
      width: 100%
    }
  }
}

// All Threads in this turn have replied
@variant
export threadCardIdle = frame : threadCard {
  title: "Thread card / All replied",
  top: 480px,

  cardRows {
    @with-variant(threadLineIdle)
    row1 {
      lineTrail {
        lineMeta {
          contents: "Windows Desktop · Codex"
        }
      }

      lineLead {
        lineTag {
          lineTagText {
            contents: "baton-ps160"
          }
        }

        lineName {
          contents: "Run reconnect tests on Windows"
        }
      }

      top: .nil
    }
  }

  cardHead {
    @with-variant(status.labelIdle)
    cardState {
      caption {
        contents: "All replied"
      }

      left: .nil
    }
  }
}

// Sent a message to an existing Thread
@variant
export threadCardSent = frame : threadCard {
  title: "Thread card / Messaged",
  top: 640px,

  cardRows {
    overrides: [remove(threadCard.cardRows.row2)]
  }

  cardHead {
    cardTitle {
      cardName {
        contents: "Messaged 1 thread"
      }
    }
  }
}
