import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "controls/badge.elyx" as badges
import "controls/avatar.elyx" as avatars
import "blocks/attention-reply.elyx" as replies

// Option row: one choice offered by the Project Agent. Subtle background, no border, leading number, and Recommended tag when suggested
export option = frame {
  title: "Attention option",
  left: 0px,
  top: 0px,
  width: 480px,
  min-height: 36px,
  layout: {align-items: .center, item-gap: 10px},
  fill: c.colors.subtle,
  corner-radius: 10px,
  padding: [8px, s.space.md],
  children: [index, label, suggested],

  index = text : t.mono {
    contents: "1",
    line-height: 1,
    fill[0].color: c.colors.faint
  }

  label = text : t.small {
    width: 100%,
    contents: "Find the cause and fix it",
    line-height: 1.4
  }

  suggested = frame : badges.tagAgent {
    display: .none
  }
}

@variant
export optionSuggested = frame : option {
  title: "Attention option / Recommended",
  left: 640px,
  top: 0px,

  suggested {
    display: .visible
  }
}

// Attention card: a decision requested by the Project Agent. Shown in the main conversation, linked Thread, and Inbox.
// Matches Thread card styling: hairline border, 14px radius, two soft shadows.
export attentionCard = frame {
  title: "Attention card / Open",
  caption: "Details start collapsed in Inbox, the main chat, and linked threads. Option clicks select a reply; Send reply submits it to the project assistant.",
  left: 0px,
  top: 160px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: 10px},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: [
    {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 3%),
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 4%),
        offset: point(0px, 4px),
        blur-radius: 16px
      }
    }
  ],
  corner-radius: 14px,
  padding: [s.space.lg, s.space.lg, s.space.md],
  children: [
    head,
    heading,
    details,
    summary,
    threadRef,
    options,
    footer,
    response,
    answer,
    resultNote
  ],

  head = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [kind, time],

    kind = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [project, mark, kindLabel, system],

      project = frame {
        display: .none,
        layout: {align-items: .center, item-gap: 6px},
        padding: [0px, 6px, 0px, 0px],
        children: [projectAvatar, projectName],

        projectAvatar = frame : avatars.amber {}

        projectName = text : t.label {
          contents: "Compatibility"
        }
      }

      mark = shape : status.dotAttention {}

      kindLabel = text : t.captionMedium {
        contents: "Waiting for your reply",
        fill[0].color: c.colors.attentionText
      }

      system = frame : badges.tag {
        display: .none,

        value {
          contents: "Sign-in required"
        }
      }
    }

    time = text : t.caption {
      contents: "14:33",
      fill[0].color: c.colors.faint
    }
  }

  heading = text : t.heading {
    width: 100%,
    contents: "1 reconnect test failed on Windows. What next?"
  }

  details = frame : buttons.smallGhost {
    connections[0].label: "Show details",
    connections[0].target: attentionExpanded,

    label {
      fill[0].color: c.colors.muted,
      contents: "Show details"
    }

    @with-variant(icons.chevronDown)
    lead {
      width: 14px,
      height: 14px,
      display: .visible
    }
  }

  summary = text : t.small {
    width: 100%,
    display: .none,
    contents: "TestReconnectAfterSleep did not reconnect within 30s after waking from sleep on Windows; the other 47 tests passed. Logs show the first TLS handshake after wake timed out.",
    fill[0].color: c.colors.muted
  }

  threadRef = frame {
    height: 26px,
    layout: {align-items: .center, item-gap: 6px},
    border: c.colors.hairline,
    corner-radius: s.radius.pill,
    padding: [0px, 10px],
    children: [threadDot, threadName, threadState],

    threadDot = shape : status.dotIdle {}

    threadName = text : t.caption {
      contents: "Run reconnect tests on Windows",
      fill[0].color: c.colors.text
    }

    threadState = text : t.caption {
      contents: "Idle",
      fill[0].color: c.colors.faint
    }
  }

  options = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xxs},
    padding: [s.space.xxs, 0px, 0px],
    children: [first, second, third],

    first = frame : optionSuggested {
      width: 100%,
      connections[0].label: "Select option and add note",
      connections[0].target: attentionReply
    }

    second = frame : option {
      width: 100%,

      index {
        contents: "2"
      }

      label {
        contents: "Skip for now"
      }
    }

    third = frame : option {
      width: 100%,

      index {
        contents: "3"
      }

      label {
        contents: "Run the test once more"
      }
    }
  }

  footer = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [reply, close],

    reply = frame : buttons.smallGhost {
      padding-left: 6px,
      padding-right: 6px,
      connections[0].label: "Write a reply",
      connections[0].target: attentionTextReply,

      label {
        fill[0].color: c.colors.muted,
        contents: "Add a note or reply"
      }

      @with-variant(icons.message)
      lead {
        width: 14px,
        height: 14px,
        display: .visible
      }
    }

    close = frame : buttons.smallGhost {
      padding-left: 6px,
      padding-right: 6px,
      connections[0].label: "Close question",
      connections[0].target: attentionClosed,

      label {
        fill[0].color: c.colors.muted,
        contents: "Close question"
      }
    }
  }

  response = frame : replies.replyForm {
    width: 100%,
    display: .none
  }

  resultNote = text : t.small {
    width: 100%,
    display: .none,
    contents: "Your reply is saved. The project assistant will read it next.",
    fill[0].color: c.colors.muted
  }

  answer = frame {
    width: 100%,
    display: .none,
    layout: {align-items: .center, item-gap: 6px},
    children: [answerGlyph, answerText],

    answerGlyph = asset : icons.check {
      width: 14px,
      height: 14px,
      fill[0].color: c.colors.muted
    }

    answerText = text : t.small {
      width: 100%,
      contents: "Find the cause and fix it · Kaken He 14:51",
      fill[0].color: c.colors.muted
    }
  }
}

// Answered: collapses options and keeps the heading and resolution
@variant
export attentionAnswered = frame : attentionCard {
  title: "Attention card / Answered",
  caption: "Removed from Inbox; retained in the main chat and linked thread. Open pages update within 5 seconds.",
  left: 0px,
  top: 820px,

  footer {
    display: .none
  }

  options {
    display: .none
  }

  answer {
    display: .visible
  }

  details {
    connections[0]: .nil
  }

  head {
    kind {
      kindLabel {
        fill[0].color: c.colors.muted,
        contents: "Answered"
      }

      @with-variant(status.dotIdle)
      mark {}
    }
  }
}

// Attention item in Inbox: shows its parent Project at the start of the header
@variant
export inboxItem = frame : attentionCard {
  title: "Attention card / Inbox",
  left: 880px,
  top: 160px,

  head {
    kind {
      project {
        display: .visible
      }
    }
  }
}

// System item: created directly by Baton with no options; links to the Project or can be dismissed
@variant
export systemItem = frame : attentionCard {
  title: "Attention card / System",
  caption: "Created by Baton. Go to the project to confirm a retry, or close the notice. No option or text reply.",
  left: 1760px,
  top: 160px,

  footer {
    close {
      connections[0].target: systemClosed,
      connections[0].label: "Close notice",

      label {
        contents: "Close notice"
      }
    }

    reply {
      connections[0].target: systemRetry,

      label {
        fill[0].color: c.colors.link,
        contents: "Go to project"
      }

      connections[0].label: "Go to project to retry",

      lead {
        display: .none
      }
    }
  }

  options {
    display: .none
  }

  threadRef {
    display: .none
  }

  details {
    display: .none
  }

  summary {
    contents: "Sign in to ChatGPT on Ubuntu Dev, then retry in the project. Your messages and replies are saved.",
    display: .visible
  }

  heading {
    contents: "ChatGPT sign-in expired on Ubuntu Dev"
  }

  head {
    time {
      contents: "15:20"
    }

    kind {
      system {
        value {
          contents: "Baton"
        }

        display: .visible
      }

      kindLabel {
        contents: "Needs attention"
      }

      project {
        projectName {
          contents: "Baton Dev"
        }

        display: .visible,

        @with-variant(avatars.avatar)
        projectAvatar {}
      }
    }
  }
}

@variant
export attentionClosed = frame : attentionAnswered {
  title: "Attention card / Closed",
  caption: "Close question saves one decision for the project assistant. Removed from Inbox; kept in the main chat, linked thread, and handled items.",
  left: 880px,
  top: 820px,

  head {
    kind {
      kindLabel {
        contents: "Closed"
      }
    }
  }

  answer {
    answerText {
      contents: "Closed by Kaken He · 14:52"
    }
  }
}

@variant
export attentionWithdrawn = frame : attentionAnswered {
  title: "Attention card / Withdrawn",
  caption: "Removed from Inbox; the reason stays in both chats and handled items. Withdrawal creates no reply.",
  left: 1760px,
  top: 820px,

  head {
    kind {
      kindLabel {
        contents: "Withdrawn"
      }
    }
  }

  answer {
    answerText {
      contents: "Withdrawn by the project assistant · 14:52\nThe test was rerun and the reconnect issue no longer occurs."
    }
  }
}

@variant
export attentionReply = frame : attentionCard {
  title: "Attention card / Option and note",
  caption: "Select an option, optionally add a note, then Send reply. Options send a decision to the project assistant; they do not run device actions.",
  left: 0px,
  top: 1480px,

  response {
    actions {
      submit {
        connections[0].target: attentionSending,
        connections[0].label: "Send reply"
      }

      cancel {
        connections[0].target: attentionCard,
        connections[0].label: "Cancel reply"
      }
    }

    display: .visible
  }

  options {
    first {
      border[0].color: c.colors.focus,
      fill[0].color: c.colors.accentSoft
    }
  }

  footer {
    reply {
      display: .none
    }
  }
}

@variant
export attentionTextReply = frame : attentionReply {
  title: "Attention card / Text answer",
  caption: "No options are offered; this question accepts a text reply. Send reply saves the text for the project assistant.",
  left: 880px,
  top: 1480px,

  options {
    display: .none
  }

  heading {
    contents: "What should the reconnect report include?"
  }

  response {
    noteLabel {
      contents: "Your reply"
    }

    note {
      value {
        contents: "Include the Windows wake-up logs and compare the first handshake with Ubuntu."
      }
    }
  }
}

@variant
export attentionSending = frame : attentionReply {
  title: "Attention card / Sending reply",
  caption: "The selection and note remain visible. Repeated Send reply or Close question clicks explain that saving is in progress.",
  left: 1760px,
  top: 1480px,
  connections[0].label: "Saved",
  connections[0].target: attentionAnswered,
  connections[1].label: "Saved while paused",
  connections[1].target: attentionAnsweredPaused,
  connections[2].label: "Saved while offline",
  connections[2].target: attentionAnsweredOffline,
  connections[3].label: "Save failed",
  connections[3].target: attentionReplyFailed,
  connections[4].label: "Another reply saved first",
  connections[4].target: attentionConflict,
  connections[5].label: "Withdrawal saved first",
  connections[5].target: attentionWithdrawalWins,
  connections[6].label: "Reply saved first",
  connections[6].target: attentionAnswerWins,
  connections[7].label: "Closed first",
  connections[7].target: attentionClosedConflict,

  @with-variant(replies.sending)
  response {}
}

@variant
export attentionReplyFailed = frame : attentionReply {
  title: "Attention card / Reply not saved",
  caption: "The connection failed before saving. Retry preserves the selected option and full note; the question remains pending.",
  left: 0px,
  top: 2140px,

  @with-variant(replies.failed)
  response {}
}

@variant
export attentionAnsweredPaused = frame : attentionAnswered {
  title: "Attention card / Answer saved while paused",
  caption: "Removed from Inbox; retained in the main chat and linked thread. Resume the project to let its assistant process the saved reply.",
  left: 880px,
  top: 2140px,

  answer {
    answerText {
      contents: "Find the cause and fix it · Kaken He · 14:51\nCheck the wake-up handshake first. Keep the logs from this run."
    }
  }

  resultNote {
    display: .visible,
    contents: "Reply saved. The project is paused; the assistant will read it after you resume."
  }
}

@variant
export attentionAnsweredOffline = frame : attentionAnsweredPaused {
  title: "Attention card / Answer saved while offline",
  caption: "Removed from Inbox; retained in both chats. The reply waits for an available device; answering does not start device work immediately.",
  left: 1760px,
  top: 2140px,

  resultNote {
    contents: "Reply saved. All devices are offline; the assistant will read it when a device is available."
  }
}

@variant
export attentionConflict = frame : attentionAnswered {
  title: "Attention card / Another reply saved first",
  caption: "The earlier reply is the effective result. Removed from Inbox; both chats show this same answer. Only one reply reaches the project assistant.",
  left: 0px,
  top: 2800px,

  answer {
    answerText {
      contents: "Run the Windows test once more · Kaken He · 14:50\nKeep the current logs for comparison."
    }
  }

  resultNote {
    display: .visible,
    contents: "This question was already answered in another window. The saved reply is shown above."
  }
}

@variant
export attentionWithdrawalWins = frame : attentionWithdrawn {
  title: "Attention card / Withdrawal saved first",
  caption: "A reply submitted during withdrawal is rejected. Show the effective withdrawal and reason in both chats; remove the item from Inbox.",
  left: 880px,
  top: 2800px,

  resultNote {
    display: .visible,
    contents: "The question was withdrawn before your reply was saved. You can continue in the linked chat."
  }
}

@variant
export attentionAnswerWins = frame : attentionAnswered {
  title: "Attention card / Reply saved before withdrawal",
  caption: "A later withdrawal has no effect. Keep the saved answer in both chats and handled items; remove the item from Inbox.",
  left: 1760px,
  top: 2800px,

  answer {
    answerText {
      contents: "Find the cause and fix it · Kaken He · 14:51\nCheck the wake-up handshake first. Keep the logs from this run."
    }
  }

  resultNote {
    display: .visible,
    contents: "Your reply was saved before the question could be withdrawn. The assistant will read this reply."
  }
}

@variant
export systemRetry = frame : systemItem {
  title: "System notice / Retry in project",
  caption: "Go to project opens this notice above its input. Confirm Retry project after signing in; no option or text reply is offered.",
  left: 0px,
  top: 3460px,

  footer {
    reply {
      connections[0].target: systemRetrying,
      connections[0].label: "Confirm Retry project",

      label {
        contents: "Retry project"
      }
    }
  }
}

@variant
export systemRetrying = frame : systemRetry {
  title: "System notice / Saving retry",
  caption: "Keep the notice pending until the retry request is saved. Repeated clicks explain that the request is in progress.",
  left: 880px,
  top: 3460px,
  connections[0].label: "Retry saved",
  connections[0].target: systemResolved,
  connections[1].label: "Save failed",
  connections[1].target: systemRetryFailed,

  resultNote {
    contents: "Saving your retry request. Wait for this to finish.",
    display: .visible
  }

  footer {
    reply {
      label {
        contents: "Retrying…"
      }
    }
  }
}

@variant
export systemRetryFailed = frame : systemRetry {
  title: "System notice / Retry not saved",
  caption: "The notice stays pending. Try Retry project again after the connection returns.",
  left: 1760px,
  top: 3460px,

  resultNote {
    display: .visible,
    contents: "The retry request could not be saved. Check your connection and retry."
  }
}

@variant
export systemResolved = frame : systemItem {
  title: "System notice / Resolved",
  caption: "Retry confirmation resolves the notice without waiting for a model reply. Removed from Inbox; kept in the main chat and handled items. No assistant message is created.",
  left: 0px,
  top: 4120px,

  footer {
    close {
      display: .none
    }

    reply {
      connections[0]: .nil
    }
  }

  resultNote {
    contents: "Retry requested. Go to the project to check progress.",
    display: .visible
  }

  answer {
    answerText {
      contents: "Retry requested by Kaken He · 15:24"
    }

    display: .visible
  }

  head {
    kind {
      kindLabel {
        fill[0].color: c.colors.muted,
        contents: "Resolved"
      }

      @with-variant(status.dotIdle)
      mark {}
    }
  }
}

@variant
export systemClosed = frame : systemResolved {
  title: "System notice / Closed",
  caption: "Close notice removes it from Inbox without retrying or creating an assistant message. The same fault does not immediately create a replacement notice.",
  left: 880px,
  top: 4120px,

  head {
    kind {
      kindLabel {
        contents: "Closed"
      }
    }
  }

  answer {
    answerText {
      contents: "Notice closed by Kaken He · 15:24"
    }
  }

  resultNote {
    contents: "The project still needs attention. Go to the project when you are ready to retry."
  }
}

@variant
export attentionExpanded = frame : attentionCard {
  title: "Attention card / Details expanded",
  caption: "Show details expands the saved Markdown in place; Hide details collapses it. Allowed formatting and https links render; HTML and images do not.",
  left: 1760px,
  top: 4120px,

  details {
    connections[0].target: attentionCard,
    connections[0].label: "Hide details",

    label {
      contents: "Hide details"
    }
  }

  summary {
    display: .visible
  }
}

@variant
export attentionClosedConflict = frame : attentionClosed {
  title: "Attention card / Closed in another window",
  caption: "A competing reply cannot replace the earlier close. Show the effective person and time; remove from Inbox and retain both chat cards.",
  left: 0px,
  top: 4780px,

  resultNote {
    display: .visible,
    contents: "This question was already closed in another window. You can continue in the linked chat."
  }
}

@variant
export attentionCloseFailed = frame : attentionCard {
  title: "Attention card / Close not saved",
  caption: "Keep the question pending and preserve any draft reply. Close question retries the failed close.",
  left: 880px,
  top: 4780px,

  resultNote {
    display: .visible,
    contents: "The question could not be closed. Check your connection and try Close question again."
  }
}

@variant
export systemCloseFailed = frame : systemItem {
  title: "System notice / Close not saved",
  caption: "Keep the system notice pending. Close notice retries without creating an assistant reply.",
  left: 1760px,
  top: 4780px,

  resultNote {
    display: .visible,
    contents: "The notice could not be closed. Check your connection and try Close notice again."
  }
}
