import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/status.elyx" as status

// Device row: name and OS, connection state, installed Agents. Shows last contact time when offline.
export deviceRow = frame {
  title: "Device row / Online",
  width: 800px,
  height: 60px,
  layout: {align-items: .center, item-gap: s.space.lg},
  padding: [0px, s.space.lg],
  children: [identity, state, agents, chevron],

  identity = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.md},
    children: [tile, copy],

    tile = frame {
      width: 16px,
      height: 32px,
      layout: {justify-content: .center, align-items: .center},
      children: glyph,

      glyph = asset : icons.device {
        width: 16px,
        height: 16px,
        fill[0].color: c.colors.muted
      }
    }

    copy = frame {
      layout: {direction: .column, item-gap: 1px},
      children: [nameLine, system],

      nameLine = frame {
        layout: {align-items: .center, item-gap: s.space.sm},
        children: [name, defaultTag],

        name = text : t.label {
          contents: "Windows Desktop"
        }

        defaultTag = text : t.caption {
          display: .none,
          contents: "Default",
          fill[0].color: c.colors.faint
        }
      }

      system = text : t.caption {
        contents: "Windows 11",
        fill[0].color: c.colors.faint
      }
    }
  }

  state = frame : status.labelOnline {
    width: 200px,

    caption {
      font-size: 13,
      letter-spacing: -0.3%
    }
  }

  agents = text : t.small {
    width: 160px,
    contents: "Codex",
    fill[0].color: c.colors.muted
  }

  chevron = asset : icons.chevronRight {
    width: 14px,
    height: 14px,
    fill[0].color: c.colors.faint
  }
}

@variant
export deviceOffline = frame : deviceRow {
  title: "Device row / Offline",
  top: 80px,

  agents {
    contents: "Codex · Pi · Kiro"
  }

  @with-variant(status.labelIdle)
  state {
    caption {
      contents: "Offline · last seen 13:52"
    }
  }

  identity {
    copy {
      system {
        contents: "macOS"
      }

      nameLine {
        name {
          contents: "MacBook Pro"
        }

        defaultTag {
          display: .visible
        }
      }
    }
  }
}

// Device currently running a Project Agent
@variant
export deviceRuntime = frame : deviceRow {
  title: "Device row / Running project assistant",
  top: 160px,

  @with-variant(icons.chevronDown)
  chevron {}

  agents {
    contents: "Codex · Pi"
  }

  @with-variant(status.labelAgent)
  state {
    caption {
      contents: "Running Baton Dev"
    }
  }

  identity {
    copy {
      system {
        contents: "Ubuntu"
      }

      nameLine {
        name {
          contents: "Ubuntu Dev"
        }
      }
    }
  }
}

// Capability row: Agent, Runtime, and subscription status on the device
export capabilityLine = frame {
  title: "Capability row",
  top: 240px,
  width: 320px,
  layout: {align-items: .center, item-gap: s.space.sm},
  children: [check, name, note],

  check = asset : icons.check {
    width: 13px,
    height: 13px,
    fill[0].color: c.colors.success
  }

  name = text : t.small {
    contents: "Codex"
  }

  note = text : t.caption {
    display: .none,
    contents: "",
    fill[0].color: c.colors.faint
  }
}

// Agent that is missing or needs sign-in: no check mark, the note names what to fix
@variant
export capabilityMissing = frame : capabilityLine {
  title: "Capability row / Needs setup",
  left: 400px,

  note {
    fill[0].color: c.colors.attentionText,
    display: .visible,
    contents: "Needs setup"
  }

  check {
    display: .none
  }
}

@variant
export deviceSyncing = frame : deviceRow {
  title: "Device row / Syncing",
  caption: "Connected; chats wait until device information is up to date.",
  left: 0px,
  top: 360px,

  agents {
    contents: "Checking availability…"
  }

  @with-variant(status.labelQueued)
  state {
    caption {
      contents: "Syncing…"
    }
  }
}

@variant
export deviceMissing = frame : deviceRow {
  title: "Device row / Setup needed",
  caption: "Open details to check missing programs and sign-ins.",
  left: 0px,
  top: 480px,

  agents {
    fill[0].color: c.colors.attentionText,
    contents: "Codex needs sign-in"
  }
}
