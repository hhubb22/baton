import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons

// Status banner above the composer: one heading, one explanation, one action
export banner = frame {
  title: "Banner / Waiting for device",
  width: s.size.measure,
  layout: {align-items: .center, item-gap: s.space.md},
  fill: c.colors.panel,
  border: c.colors.borderSoft,
  corner-radius: 10px,
  padding: [10px, s.space.md, 10px, 14px],
  children: [glyph, copy, action],

  glyph = asset : icons.offline {
    width: 16px,
    height: 16px,
    fill[0].color: c.colors.muted
  }

  copy = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xxs},
    children: [heading, detail],

    heading = text : t.label {
      width: 100%,
      contents: "Waiting for a device to come online"
    }

    detail = text : t.caption {
      width: 100%,
      contents: "All 3 devices are offline. Your messages are saved and will send when a device with ChatGPT signed in is available.",
      fill[0].color: c.colors.muted
    }
  }

  action = frame : buttons.smallSecondary {
    label {
      contents: "View devices"
    }
  }
}

@variant
export bannerPaused = frame : banner {
  title: "Banner / Paused",
  top: 96px,

  action {
    label {
      contents: "Resume"
    }
  }

  copy {
    detail {
      contents: "Automatic replies are paused. You can still chat in individual threads. Messages and replies here are saved until you resume."
    }

    heading {
      contents: "Project is paused"
    }
  }

  @with-variant(icons.pause)
  glyph {}
}

@variant
export bannerAttention = frame : banner {
  title: "Banner / Needs attention",
  top: 192px,
  border[0].color: rgb(91%, 41%, 12%, 18%),
  fill[0].color: c.colors.attentionSoft,

  action {
    label {
      contents: "Retry"
    }
  }

  copy {
    detail {
      contents: "Sign in to ChatGPT on Ubuntu Dev, then retry. Your messages and replies are saved."
    }

    heading {
      contents: "ChatGPT sign-in expired on Ubuntu Dev"
    }
  }

  @with-variant(icons.alert)
  glyph {
    fill[0].color: c.colors.attention
  }
}
