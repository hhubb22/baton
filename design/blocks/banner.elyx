import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons

// Status banner above the composer: one heading and one action. The detail line stays hidden unless messages or changes are kept or lost.
export banner = frame {
  title: "Banner / Waiting for device",
  width: s.size.measure,
  layout: {align-items: .center, item-gap: s.space.md},
  fill: c.colors.panel,
  border: c.colors.borderSoft,
  corner-radius: 10px,
  padding: [10px, s.space.md, 10px, 14px],
  children: [glyph, copy, action],

  glyph = asset : icons.offline {
    width: 16px,
    height: 16px,
    fill[0].color: c.colors.muted
  }

  copy = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xxs},
    children: [heading, detail],

    heading = text : t.label {
      width: 100%,
      contents: "All devices offline"
    }

    detail = text : t.caption {
      width: 100%,
      display: .none,
      contents: "Messages send when a device is back.",
      fill[0].color: c.colors.muted
    }
  }

  action = frame : buttons.smallSecondary {
    label {
      contents: "View devices"
    }
  }
}

@variant
export bannerPaused = frame : banner {
  title: "Banner / Paused",
  top: 96px,

  action {
    label {
      contents: "Resume"
    }
  }

  copy {
    detail {
      contents: "New messages wait until you resume.",
      display: .visible
    }

    heading {
      contents: "Project paused"
    }
  }

  @with-variant(icons.pause)
  glyph {}
}

// The one problem on the page that needs you: an inverted floating notice instead of a tinted box
@variant
export bannerAttention = frame : banner {
  title: "Banner / Needs attention",
  top: 192px,
  corner-radius: 16px,
  padding-top: 14px,
  padding-left: 18px,
  padding-bottom: 14px,
  padding-right: 14px,
  border[0].color: c.colors.transparent,
  fill[0].color: c.colors.inverse,
  shadow[0].drop-shadow.blur-radius: 3px,
  shadow[0].drop-shadow.color: c.colors.shadowNear,
  shadow[0].drop-shadow.offset: [0px, 1px],
  shadow[1].drop-shadow.blur-radius: 32px,
  shadow[1].drop-shadow.color: c.colors.shadowFar,
  shadow[1].drop-shadow.offset: [0px, 12px],

  copy {
    detail {
      fill[0].color: c.colors.onInverseMuted
    }

    heading {
      fill[0].color: c.colors.onInverse,
      contents: "ChatGPT sign-in expired on Ubuntu Dev"
    }
  }

  action {
    label {
      contents: "Retry"
    }
  }

  @with-variant(icons.alert)
  glyph {
    fill[0].color: c.colors.attention
  }
}
