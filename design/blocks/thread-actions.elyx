import "blocks/dialog.elyx" as dialogs
import "tokens/colors.elyx" as c
import "blocks/new-thread.elyx" as menus

export threadActions = frame : menus.menu {
  title: "Thread actions",
  caption: "Open the menu to stop or archive this chat.",
  left: 0px,
  top: 0px,
  width: 224px,
  overrides: [
    insert(stopAction, after = .nil),
    insert(archiveAction, after = stopAction)
  ],

  stopAction = frame : menus.menuOption {
    width: 100%,
    connections[0].label: "Confirm stop",
    connections[0].target: stopThread,

    note {
      display: .none
    }

    name {
      contents: "Stop current reply"
    }
  }

  archiveAction = frame : menus.menuOption {
    width: 100%,
    connections[0].label: "Confirm archive",
    connections[0].target: archiveThread,

    note {
      display: .none
    }

    name {
      contents: "Archive thread"
    }
  }
}

export stopThread = frame : dialogs.dialog {
  title: "Stop current reply",
  caption: "Stop the reply and cancel the waiting message. File changes stay on the device.",
  left: 0px,
  top: 240px,

  heading {
    contents: "Stop current reply?"
  }

  content {
    message {
      contents: "Stops Codex on Windows Desktop and cancels 1 message waiting to send. File changes and commands already run will not be undone. If Codex does not stop within 1 minute, Baton ends its process."
    }
  }

  footer {
    actions {
      cancel {
        label {
          contents: "Keep running"
        }
      }

      confirm {
        label {
          contents: "Stop reply"
        }
      }
    }
  }
}

@variant
export archiveThread = frame : stopThread {
  title: "Archive running chat",
  caption: "Wait for the device to confirm stopping before closing this chat to new messages.",
  left: 600px,
  top: 240px,

  heading {
    contents: "Archive this thread?"
  }

  content {
    message {
      contents: "Stops the current reply and cancels 1 message waiting to send. Once stopping is confirmed, this thread will no longer accept messages. Past replies and attachment links stay available. File changes and commands already run will not be undone."
    }
  }

  footer {
    actions {
      cancel {
        label {
          contents: "Keep thread"
        }
      }

      confirm {
        label {
          contents: "Stop and archive"
        }
      }
    }
  }
}

@variant
export archiveIdleThread = frame : archiveThread {
  title: "Archive idle chat",
  caption: "Close the chat to new messages and keep its records.",
  left: 1200px,
  top: 240px,

  content {
    message {
      contents: "This thread will no longer accept messages. Past replies and attachment links stay available. Files on Windows Desktop are kept."
    }
  }

  footer {
    actions {
      confirm {
        label {
          contents: "Archive thread"
        }
      }
    }
  }
}

@variant
export stopUnavailable = frame : stopThread {
  title: "Stop unavailable",
  caption: "Show the reported capability reason after clicking Stop.",
  left: 0px,
  top: 720px,

  footer {
    actions {
      confirm {
        fill[0].color: c.colors.subtle,

        label {
          fill[0].color: c.colors.text,
          contents: "Back to thread"
        }
      }

      cancel {
        display: .none
      }
    }
  }

  heading {
    contents: "Stopping is unavailable"
  }

  content {
    message {
      contents: "This agent on Windows Desktop does not support stopping from Baton. Stop it on Windows Desktop, or wait for the reply to finish."
    }
  }
}

@variant
export archiveUnavailable = frame : stopUnavailable {
  title: "Archive unavailable while running",
  caption: "Finish or stop the current reply on the device, then archive again.",
  left: 600px,
  top: 720px,

  heading {
    contents: "Current reply must stop first"
  }

  content {
    message {
      contents: "This agent cannot be stopped from Baton, so the running thread cannot be archived yet. Stop it on Windows Desktop, or wait for the reply to finish, then archive again."
    }
  }
}
