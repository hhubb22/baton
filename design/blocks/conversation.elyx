import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/avatar.elyx" as avatars
import "blocks/thread-line.elyx" as lines

// 主对话里的条目。组件默认宽 720px，放进对话列时改成 100%，和输入区左右对齐。
// 用户消息：右对齐，浅灰圆角气泡，最宽 560px。设计稿里超过一行的消息要给正文写明宽度
export userMessage = frame {
  title: "用户消息",
  top: 0px,
  width: s.size.measure,
  layout: {direction: .column, align-items: .end, item-gap: 6px},
  children: [bubble, meta],

  bubble = frame {
    width: .auto,
    max-width: 560px,
    layout: {direction: .row},
    fill: c.colors.subtle,
    shadow: {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 4%),
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    corner-radius: 18px,
    padding: [10px, 16px],
    children: content,

    content = text : t.body {
      contents: "PS-160 的验收要在三台设备上跑。先在 Windows 上跑重连测试，结果出来告诉我。"
    }
  }

  meta = frame {
    display: .none,
    layout: {align-items: .center, item-gap: s.space.xs},
    padding: [0px, s.space.xs],
    children: [metaIcon, metaText],

    metaIcon = asset : icons.clock {
      width: 13px,
      height: 13px,
      fill[0].color: c.colors.faint
    }

    metaText = text : t.caption {
      contents: "已保存，等设备上线后处理",
      fill[0].color: c.colors.faint
    }
  }
}

// 所有设备离线时发出的消息
@variant
export userMessagePending = frame : userMessage {
  title: "用户消息 / 等待设备",
  top: 72px,

  bubble {
    content {
      contents: "MacBook 上线后先把 PS-160 的分支推上去。"
    }
  }

  meta {
    display: .visible
  }
}

// Project Agent 的一段回复：没有头像和名字，靠左对齐的正文就是它说的话。
// 这一轮执行过命令或改过记忆时，开头是一行可展开的过程记录；开过或发过消息的 Thread 收在正文前的卡片里。
export agentTurn = frame {
  title: "Project Agent 回复",
  top: 168px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: s.space.md},
  children: [log, work, content],

  log = frame : activityLog {
    width: 100%,
    display: .none
  }

  work = frame : lines.threadCard {
    width: 100%,
    display: .none
  }

  content = text : t.body {
    width: 100%,
    contents: "Windows 台式机在线，worktree 建在 D:\\src\\baton-ps160，重连测试已经在跑，结果出来告诉你。"
  }
}

// 带过程记录和 Thread 卡片的回复
@variant
export agentTurnWork = frame : agentTurn {
  title: "Project Agent 回复 / 开了 Thread",
  top: 240px,

  log {
    display: .visible
  }

  work {
    display: .visible
  }
}

// 运行中：Project Agent 正在处理这一轮
export typing = frame {
  title: "Project Agent 正在处理",
  top: 600px,
  width: s.size.measure,
  layout: {align-items: .center, item-gap: s.space.sm},
  children: [mark, label],

  mark = frame : avatars.agentMark {}

  label = text : t.small {
    contents: "正在处理 2 条输入…",
    fill[0].color: c.colors.agentText
  }
}

// 日期分隔
export dayDivider = frame {
  title: "日期分隔",
  top: 648px,
  width: s.size.measure,
  layout: {justify-content: .center, align-items: .center},
  children: label,

  label = text : t.caption {
    contents: "今天",
    fill[0].color: c.colors.faint
  }
}

// 系统记录：运行实例换设备、Project 暂停或恢复等
export systemNote = frame {
  title: "系统记录",
  top: 688px,
  width: s.size.measure,
  layout: {justify-content: .center, align-items: .center, item-gap: 6px},
  children: [glyph, label],

  glyph = asset : icons.device {
    width: 13px,
    height: 13px,
    fill[0].color: c.colors.faint
  }

  label = text : t.caption {
    contents: "Project Agent 在 Ubuntu 开发机上启动：默认设备 MacBook Pro 离线",
    fill[0].color: c.colors.faint
  }
}

// 过程记录里的一步：图标、内容、右侧说明。命令点开后在下方显示输出。
export activityStep = frame {
  title: "过程步骤 / 命令",
  top: 736px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: s.space.xs},
  children: [stepRow, stepOutput],

  stepRow = frame {
    width: 100%,
    height: s.size.row,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: s.space.md
    },
    children: [stepLead, stepNote],

    stepLead = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [stepGlyph, stepLabel],

      stepGlyph = asset : icons.terminal {
        width: 14px,
        height: 14px,
        fill[0].color: c.colors.faint
      }

      stepLabel = text : t.mono {
        contents: "git worktree add D:\\src\\baton-ps160 origin/main",
        line-height: 1
      }
    }

    stepNote = text : t.small {
      contents: "Windows 台式机 · 3.8 秒",
      line-height: 1,
      fill[0].color: c.colors.faint
    }
  }

  stepOutput = frame {
    width: 100%,
    display: .none,
    layout: {direction: .column},
    fill: c.colors.code,
    border: c.colors.codeBorder,
    corner-radius: 10px,
    padding: [10px, s.space.md],
    children: stepResult,

    stepResult = text : t.monoCN {
      width: 100%,
      contents: "Preparing worktree (detached HEAD 4c1e9a2)\nHEAD is now at 4c1e9a2 build: 统一前后端构建",
      fill[0].color: c.colors.muted
    }
  }
}

// 展开的命令步骤：显示输出
@variant
export activityStepOpen = frame : activityStep {
  title: "过程步骤 / 命令展开",
  top: 784px,

  stepOutput {
    display: .visible
  }
}

// 记忆修改步骤：点开在原位显示修改前后
@variant
export activityStepMemory = frame : activityStep {
  title: "过程步骤 / 记忆",
  top: 896px,

  stepRow {
    stepNote {
      contents: "项目记忆 v1"
    }

    stepLead {
      stepLabel {
        contents: "记下：Windows 上的 worktree 在 D:\\src\\baton-ps160",
        font-size: 13,
        font-family: "PingFang SC"
      }

      @with-variant(icons.memory)
      stepGlyph {}
    }
  }
}

// 过程记录：Project Agent 一轮里执行的命令和修改的记忆。默认收起成一行，点开在原位逐条查看，每条命令或记忆占一行。
// 时间在悬停时显示；命令在哪台设备上执行写在展开后的每一步里。
export activityLog = frame {
  title: "过程记录 / 收起",
  top: 944px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: 6px},
  children: [logHead, logBody],

  logHead = frame {
    height: 24px,
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [logChevron, logLabel],

    logChevron = asset : icons.chevronRight {
      width: 13px,
      height: 13px,
      fill[0].color: c.colors.faint
    }

    logLabel = text : t.small {
      contents: "执行了 1 条命令，改了 1 处记忆",
      line-height: 1,
      fill[0].color: c.colors.muted
    }
  }

  logBody = frame {
    width: 100%,
    display: .none,
    layout: {direction: .column},
    padding: [0px, 0px, 0px, 6px],
    children: logSteps,

    logSteps = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.xxs},
      border: {color: c.colors.borderSoft, width: 1.5px, sides: .left},
      padding: [0px, 0px, 0px, 15px],
      children: [stepCommand, stepMemory],

      stepCommand = frame : activityStepOpen {
        width: 100%
      }

      stepMemory = frame : activityStepMemory {
        width: 100%
      }
    }
  }
}

// 展开：逐条列出步骤，命令可以继续展开看输出
@variant
export activityLogOpen = frame : activityLog {
  title: "过程记录 / 展开",
  top: 992px,

  logBody {
    display: .visible
  }

  logHead {
    @with-variant(icons.chevronDown)
    logChevron {}
  }
}
