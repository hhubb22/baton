import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/avatar.elyx" as avatars
import "blocks/thread-line.elyx" as lines

// Entries in the main conversation. Default width is 720px; set to 100% inside the conversation column so edges align with the composer.
// User message: right-aligned subtle bubble, max-width 560px. Specify an explicit width on multiline text in design files
export userMessage = frame {
  title: "User message",
  top: 0px,
  width: s.size.measure,
  layout: {direction: .column, align-items: .end, item-gap: 6px},
  children: [bubble, meta],

  bubble = frame {
    width: .auto,
    max-width: 560px,
    layout: {direction: .row},
    fill: c.colors.subtle,
    shadow: {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 4%),
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    corner-radius: 18px,
    padding: [10px, 16px],
    children: content,

    content = text : t.body {
      contents: "Run PS-160 reconnect tests on Windows first and let me know when they finish."
    }
  }

  meta = frame {
    display: .none,
    layout: {align-items: .center, item-gap: s.space.xs},
    padding: [0px, s.space.xs],
    children: [metaIcon, metaText],

    metaIcon = asset : icons.clock {
      width: 13px,
      height: 13px,
      fill[0].color: c.colors.faint
    }

    metaText = text : t.caption {
      contents: "Saved · sends when a device is available",
      fill[0].color: c.colors.faint
    }
  }
}

// Message sent while all devices are offline
@variant
export userMessagePending = frame : userMessage {
  title: "User message / Waiting for device",
  top: 72px,

  bubble {
    content {
      contents: "Push the PS-160 branch as soon as the MacBook is back online."
    }
  }

  meta {
    display: .visible
  }
}

// Project Agent turn: left-aligned body text without an avatar or name.
// When commands or memory edits ran in the turn, an expandable activity log sits at the top; Threads opened or messaged in the turn appear in a card before the text.
export agentTurn = frame {
  title: "Project assistant reply",
  top: 168px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: s.space.md},
  children: [log, work, content],

  log = frame : activityLog {
    width: 100%,
    display: .none
  }

  work = frame : lines.threadCard {
    width: 100%,
    display: .none
  }

  content = text : t.body {
    width: 100%,
    contents: "Windows Desktop is online. Created a worktree at D:\\src\\baton-ps160 and started the reconnect tests; I'll report back when they finish."
  }
}

// Turn with an activity log and Thread card
@variant
export agentTurnWork = frame : agentTurn {
  title: "Project assistant reply / Opened threads",
  top: 240px,

  log {
    display: .visible
  }

  work {
    display: .visible
  }
}

// Active run: Project Agent is processing the current turn
export typing = frame {
  title: "Project assistant working",
  top: 600px,
  width: s.size.measure,
  layout: {align-items: .center, item-gap: s.space.sm},
  children: [mark, label],

  mark = frame : avatars.agentMark {}

  label = text : t.small {
    contents: "Reading 2 messages…",
    fill[0].color: c.colors.agentText
  }
}

// Day divider
export dayDivider = frame {
  title: "Day divider",
  top: 648px,
  width: s.size.measure,
  layout: {justify-content: .center, align-items: .center},
  children: label,

  label = text : t.caption {
    contents: "Today",
    fill[0].color: c.colors.faint
  }
}

// System note: runtime device handoff, Project pause or resume
export systemNote = frame {
  title: "System note",
  top: 688px,
  width: s.size.measure,
  layout: {justify-content: .center, align-items: .center, item-gap: 6px},
  children: [glyph, label],

  glyph = asset : icons.device {
    width: 13px,
    height: 13px,
    fill[0].color: c.colors.faint
  }

  label = text : t.caption {
    contents: "Switched to Ubuntu Dev because MacBook Pro is offline",
    fill[0].color: c.colors.faint
  }
}

// Activity step: icon, summary, and trailing note. Expanding a command step shows its output below.
export activityStep = frame {
  title: "Activity step / Command",
  top: 736px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: s.space.xs},
  children: [stepRow, stepOutput],

  stepRow = frame {
    width: 100%,
    height: s.size.row,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: s.space.md
    },
    children: [stepLead, stepNote],

    stepLead = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [stepGlyph, stepLabel],

      stepGlyph = asset : icons.terminal {
        width: 14px,
        height: 14px,
        fill[0].color: c.colors.faint
      }

      stepLabel = text : t.mono {
        contents: "git worktree add D:\\src\\baton-ps160 origin/main",
        line-height: 1
      }
    }

    stepNote = text : t.small {
      contents: "Windows Desktop · 3.8s",
      line-height: 1,
      fill[0].color: c.colors.faint
    }
  }

  stepOutput = frame {
    width: 100%,
    display: .none,
    layout: {direction: .column},
    fill: c.colors.code,
    border: c.colors.codeBorder,
    corner-radius: 10px,
    padding: [10px, s.space.md],
    children: stepResult,

    stepResult = text : t.mono {
      width: 100%,
      contents: "Preparing worktree (detached HEAD 4c1e9a2)\nHEAD is now at 4c1e9a2 build: unify frontend and backend build",
      fill[0].color: c.colors.muted
    }
  }
}

// Expanded command step showing output
@variant
export activityStepOpen = frame : activityStep {
  title: "Activity step / Command open",
  top: 784px,

  stepOutput {
    display: .visible
  }
}

// Memory edit step: expands in place to show the change
@variant
export activityStepMemory = frame : activityStep {
  title: "Activity step / Memory",
  top: 896px,

  stepRow {
    stepNote {
      contents: "Memory v1"
    }

    stepLead {
      stepLabel {
        contents: "Saved: Windows worktree is at D:\\src\\baton-ps160",
        font-size: 13,
        font-family: "PingFang SC"
      }

      @with-variant(icons.memory)
      stepGlyph {}
    }
  }
}

// Activity log: commands and memory edits in a Project Agent turn. Collapsed into one line by default; expands in place with one row per step.
// Timestamps appear on hover; the device that ran each command appears on its expanded step row.
export activityLog = frame {
  title: "Activity log / Collapsed",
  top: 944px,
  width: s.size.measure,
  layout: {direction: .column, item-gap: 6px},
  children: [logHead, logBody],

  logHead = frame {
    height: 24px,
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [logChevron, logLabel],

    logChevron = asset : icons.chevronRight {
      width: 13px,
      height: 13px,
      fill[0].color: c.colors.faint
    }

    logLabel = text : t.small {
      contents: "Ran 1 command, saved 1 note",
      line-height: 1,
      fill[0].color: c.colors.muted
    }
  }

  logBody = frame {
    width: 100%,
    display: .none,
    layout: {direction: .column},
    padding: [0px, 0px, 0px, 6px],
    children: logSteps,

    logSteps = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.xxs},
      border: {color: c.colors.borderSoft, width: 1.5px, sides: .left},
      padding: [0px, 0px, 0px, 15px],
      children: [stepCommand, stepMemory],

      stepCommand = frame : activityStepOpen {
        width: 100%
      }

      stepMemory = frame : activityStepMemory {
        width: 100%
      }
    }
  }
}

// Expanded: lists each step in order, with command outputs expandable inline
@variant
export activityLogOpen = frame : activityLog {
  title: "Activity log / Expanded",
  top: 992px,

  logBody {
    display: .visible
  }

  logHead {
    @with-variant(icons.chevronDown)
    logChevron {}
  }
}
