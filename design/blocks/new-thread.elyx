import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/status.elyx" as status
import "controls/button.elyx" as buttons
import "controls/input.elyx" as inputs
import "blocks/dialog.elyx" as dialogs
import "blocks/file-preview.elyx" as files

// Menu option: optional status dot, label, trailing faint note, and selected checkmark
export menuOption = frame {
  title: "Menu option",
  left: 0px,
  top: 0px,
  width: 288px,
  height: s.size.control,
  layout: {align-items: .center, item-gap: s.space.sm},
  corner-radius: s.radius.sm,
  padding: [0px, s.space.sm],
  children: [mark, name, note, picked],

  mark = shape : status.dotOnline {
    display: .none
  }

  name = text : t.small {
    width: 100%,
    contents: "baton",
    line-height: 1
  }

  note = text : t.caption {
    contents: "MacBook Pro",
    line-height: 1,
    fill[0].color: c.colors.faint
  }

  picked = asset : icons.check {
    width: 14px,
    height: 14px,
    display: .none,
    fill[0].color: c.colors.text
  }
}

// Repository discovered on a device: shows path on the right
@variant
export menuOptionRepo = frame : menuOption {
  title: "Menu option / Repository",
  left: 0px,
  top: 48px,

  note {
    contents: "~/src/elyx",
    font-size: 11,
    font-family: "Paper Mono"
  }

  name {
    contents: "elyx"
  }
}

// Menu group heading: Recent, device name, or Agent name. Device groups show connection status and note when offline
export menuHeading = frame {
  title: "Menu group heading",
  left: 0px,
  top: 96px,
  width: 288px,
  height: 28px,
  layout: {align-items: .center, item-gap: s.space.sm},
  padding: [6px, s.space.sm, 0px],
  children: [mark, label, note],

  mark = shape : status.dotOnline {
    display: .none
  }

  label = text : t.captionMedium {
    width: 100%,
    contents: "Recent",
    line-height: 1,
    fill[0].color: c.colors.faint
  }

  note = text : t.caption {
    display: .none,
    contents: "Offline",
    line-height: 1,
    fill[0].color: c.colors.faint
  }
}

// Menu panel: white surface, border, and soft shadow
export menu = frame {
  title: "Menu",
  left: 0px,
  top: 144px,
  width: 304px,
  layout: {direction: .column, item-gap: 1px},
  fill: c.colors.surface,
  border: c.colors.border,
  shadow: {
    drop-shadow: {
      color: c.colors.shadowFar,
      offset: point(0px, 8px),
      blur-radius: 24px
    }
  },
  corner-radius: s.radius.md,
  padding: s.space.xs
}

// Thin rule between menu groups
export menuRule = frame {
  title: "Menu divider",
  left: 0px,
  top: 216px,
  width: 288px,
  layout: {direction: .column},
  padding: [s.space.xs, 0px],
  children: line,

  line = frame {
    width: 100%,
    height: 1px,
    fill: c.colors.borderSoft
  }
}

// Location menu: lists recent locations first, then discovered repositories by device, and finally other directories inside registered roots.
// Offline devices remain selectable; the Thread waits until that device comes online
export locationMenu = frame : menu {
  title: "Location menu",
  left: 0px,
  top: 280px,
  overrides: [
    insert(recentHead, after = .nil),
    insert(recent1, after = recentHead),
    insert(recent2, after = recent1),
    insert(rule1, after = recent2),
    insert(macHead, after = rule1),
    insert(mac1, after = macHead),
    insert(mac2, after = mac1),
    insert(windowsHead, after = mac2),
    insert(windows1, after = windowsHead),
    insert(ubuntuHead, after = windows1),
    insert(ubuntu1, after = ubuntuHead),
    insert(rule2, after = ubuntu1),
    insert(other, after = rule2)
  ],

  recentHead = frame : menuHeading {
    width: 100%
  }

  recent1 = frame : menuOption {
    width: 100%,
    fill[0].color: c.colors.hover,

    mark {
      display: .visible
    }

    picked {
      display: .visible
    }
  }

  recent2 = frame : menuOption {
    width: 100%,

    note {
      contents: "Windows Desktop"
    }

    name {
      contents: "baton-ps160"
    }

    mark {
      display: .visible
    }
  }

  rule1 = frame : menuRule {
    width: 100%
  }

  macHead = frame : menuHeading {
    width: 100%,

    label {
      contents: "MacBook Pro"
    }

    mark {
      display: .visible
    }
  }

  mac1 = frame : menuOptionRepo {
    width: 100%
  }

  mac2 = frame : menuOptionRepo {
    width: 100%,

    name {
      contents: "dotfiles"
    }

    note {
      contents: "~/dotfiles"
    }
  }

  windowsHead = frame : menuHeading {
    width: 100%,

    label {
      contents: "Windows Desktop"
    }

    mark {
      display: .visible
    }
  }

  windows1 = frame : menuOptionRepo {
    width: 100%,

    name {
      contents: "baton"
    }

    note {
      contents: "D:\\src\\baton"
    }
  }

  ubuntuHead = frame : menuHeading {
    width: 100%,

    label {
      contents: "Ubuntu Dev"
    }

    note {
      display: .visible
    }

    @with-variant(status.dotIdle)
    mark {
      display: .visible
    }
  }

  ubuntu1 = frame : menuOptionRepo {
    width: 100%,

    name {
      contents: "baton"
    }

    note {
      contents: "~/work/baton"
    }
  }

  rule2 = frame : menuRule {
    width: 100%
  }

  other = frame : menuOption {
    width: 100%,
    connections[0].label: "Replace menu with folder picker; keep draft",
    connections[0].target: folderPicker,

    name {
      fill[0].color: c.colors.muted,
      contents: "Choose another folder…"
    }

    note {
      display: .none
    }
  }
}

// Model menu: grouped by Agent, listing only Agents available on the selected location's device. Choosing a model selects its Agent
export modelMenu = frame : menu {
  title: "Model menu",
  left: 400px,
  top: 280px,
  width: 240px,
  overrides: [
    insert(codexHead, after = .nil),
    insert(codex1, after = codexHead),
    insert(codex2, after = codex1),
    insert(kiroHead, after = codex2),
    insert(kiro1, after = kiroHead),
    insert(kiro2, after = kiro1),
    insert(piHead, after = kiro2),
    insert(pi1, after = piHead),
    insert(pi2, after = pi1)
  ],

  codexHead = frame : menuHeading {
    width: 100%,

    label {
      contents: "Codex"
    }
  }

  codex1 = frame : menuOption {
    width: 100%,
    fill[0].color: c.colors.hover,

    note {
      display: .none
    }

    name {
      contents: "gpt-6.1-sol"
    }

    picked {
      display: .visible
    }
  }

  codex2 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "gpt-6.1-mini"
    }
  }

  kiroHead = frame : menuHeading {
    width: 100%,

    label {
      contents: "Kiro"
    }
  }

  kiro1 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "auto"
    }
  }

  kiro2 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "claude-sonnet-5.5"
    }
  }

  piHead = frame : menuHeading {
    width: 100%,

    label {
      contents: "Pi"
    }
  }

  pi1 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "claude-opus-5.5"
    }
  }

  pi2 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "gpt-6.1-sol"
    }
  }
}

// Thread model menu: lists only models for the Thread's Agent without grouping. The next turn uses the selected model
export threadModelMenu = frame : menu {
  title: "Thread model menu",
  left: 720px,
  top: 280px,
  width: 240px,
  overrides: [
    insert(option1, after = .nil),
    insert(option2, after = option1),
    insert(option3, after = option2)
  ],

  option1 = frame : menuOption {
    width: 100%,
    fill[0].color: c.colors.hover,

    note {
      display: .none
    }

    name {
      contents: "gpt-6.1-sol"
    }

    picked {
      display: .visible
    }
  }

  option2 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "gpt-6.1-mini"
    }
  }

  option3 = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "gpt-6.1"
    }
  }
}

// Agent does not support switching models mid-Thread: shows the current model and the reason below
export threadModelMenuFixed = frame : menu {
  title: "Thread model menu / Fixed",
  left: 1040px,
  top: 280px,
  width: 240px,
  overrides: [insert(current, after = .nil), insert(reason, after = current)],

  current = frame : menuOption {
    width: 100%,

    note {
      display: .none
    }

    name {
      contents: "claude-sonnet-5.5"
    }

    picked {
      display: .visible
    }
  }

  reason = frame {
    width: 100%,
    layout: {direction: .column},
    padding: [6px, s.space.sm, s.space.xs],
    children: reasonText,

    reasonText = text : t.caption {
      width: 100%,
      contents: "Kiro cannot switch models in this thread. Start a new thread to choose another.",
      fill[0].color: c.colors.muted
    }
  }
}

export folderPicker = frame : dialogs.dialog {
  title: "Choose another folder",
  caption: "Replaces the location menu. Cancel returns to the unchanged draft.",
  left: 0px,
  top: 1100px,
  width: 600px,

  footer {
    actions {
      @with-variant(buttons.secondary)
      confirm {
        label {
          contents: "Select folder"
        }
      }
    }

    note {
      contents: "Choose an allowed folder."
    }
  }

  content {
    overrides: [insert(device, after = .nil), insert(browser, after = device)],

    message {
      contents: "Folder access is managed on this device.",
      font-size: 12
    }
  }

  heading {
    contents: "Choose folder"
  }

  device = frame : inputs.select {
    width: 100%,

    value {
      contents: "MacBook Pro"
    }
  }

  browser = frame {
    width: 100%,
    height: 240px,
    layout: {direction: .column, item-gap: 8px},
    border: c.colors.borderSoft,
    corner-radius: s.radius.md,
    padding: s.space.md,
    children: [rootsHead, parent, first, second, feedback],

    rootsHead = text : t.captionMedium {
      width: 100%,
      contents: "Allowed folders",
      fill[0].color: c.colors.muted
    }

    parent = frame : files.entryFolder {
      width: 100%,
      display: .none,

      name {
        contents: "Back to allowed folders"
      }

      @with-variant(icons.chevronLeft)
      glyph {}
    }

    first = frame : files.entryFolder {
      width: 100%,
      connections[0].label: "Open allowed folder",
      connections[0].target: folderPickerBrowse,

      name {
        contents: "~/src"
      }
    }

    second = frame : files.entryFolder {
      width: 100%,

      name {
        contents: "~/Documents"
      }
    }

    feedback = text : t.small {
      width: 100%,
      display: .none,
      contents: "Choose a folder above.",
      fill[0].color: c.colors.muted
    }
  }
}

@variant
export folderPickerBrowse = frame : folderPicker {
  title: "Choose folder / Inside allowed folder",
  caption: "Open subfolders or select the current folder. The draft stays in place.",
  left: 760px,
  top: 1100px,

  footer {
    actions {
      @with-variant(buttons.button)
      confirm {}
    }

    note {
      contents: "~/src"
    }
  }

  content {
    browser {
      second {
        connections[0].target: folderPickerSelected,
        connections[0].label: "Open elyx",

        name {
          contents: "elyx"
        }
      }

      first {
        name {
          contents: "baton"
        }
      }

      rootsHead {
        contents: "~/src"
      }

      parent {
        display: .visible
      }
    }
  }
}

@variant
export folderPickerSelected = frame : folderPickerBrowse {
  title: "Choose folder / Selected folder",
  caption: "Select folder returns to the draft with this location and an available model.",
  left: 1520px,
  top: 1100px,

  content {
    browser {
      rootsHead {
        contents: "~/src/elyx"
      }

      parent {
        name {
          contents: "Back to ~/src"
        }
      }

      first {
        name {
          contents: "src"
        }
      }

      second {
        name {
          contents: "tests"
        }
      }
    }
  }

  footer {
    note {
      contents: "~/src/elyx"
    }
  }
}

export folderDeviceMenu = frame : menu {
  title: "Folder picker / Device menu",
  caption: "Switch devices within the picker. Draft text stays unchanged.",
  left: 2280px,
  top: 1100px,
  width: 280px,
  overrides: [
    insert(mac, after = .nil),
    insert(windows, after = mac),
    insert(ubuntu, after = windows)
  ],

  mac = frame : menuOption {
    width: 100%,

    name {
      contents: "MacBook Pro"
    }

    note {
      contents: "Online"
    }

    mark {
      display: .visible
    }

    picked {
      display: .visible
    }
  }

  windows = frame : menuOption {
    width: 100%,

    name {
      contents: "Windows Desktop"
    }

    note {
      contents: "Online"
    }

    mark {
      display: .visible
    }
  }

  ubuntu = frame : menuOption {
    width: 100%,

    note {
      contents: "Offline"
    }

    name {
      contents: "Ubuntu Dev"
    }

    @with-variant(status.dotIdle)
    mark {
      display: .visible
    }
  }
}

@variant
export folderPickerOffline = frame : folderPicker {
  title: "Choose folder / Offline device",
  caption: "Reconnect to browse. Cancel keeps the previous location and draft.",
  left: 0px,
  top: 1780px,

  content {
    browser {
      first {
        display: .none
      }

      second {
        display: .none
      }

      rootsHead {
        contents: "Ubuntu Dev is offline"
      }

      feedback {
        contents: "Reconnect Ubuntu Dev to browse its folders, or choose another device.",
        display: .visible
      }
    }

    device {
      value {
        contents: "Ubuntu Dev · Offline"
      }
    }
  }

  footer {
    note {
      contents: "Folders cannot be read yet."
    }

    actions {
      confirm {
        label {
          contents: "Retry"
        }
      }
    }
  }
}

@variant
export folderPickerFailed = frame : folderPickerOffline {
  title: "Choose folder / Read failed",
  caption: "Retry the folder read without losing the draft or selected device.",
  left: 760px,
  top: 1780px,

  content {
    device {
      value {
        contents: "MacBook Pro"
      }
    }

    browser {
      rootsHead {
        contents: "Could not read ~/src"
      }

      feedback {
        contents: "Could not read this folder on MacBook Pro."
      }

      parent {
        display: .visible
      }
    }
  }

  footer {
    note {
      contents: "Location is unchanged."
    }
  }
}

@variant
export folderPickerNoRoots = frame : folderPickerOffline {
  title: "Choose folder / No allowed folders",
  caption: "No folder is allowed on this device yet. Add one in Devices.",
  left: 1520px,
  top: 1780px,

  content {
    device {
      value {
        contents: "MacBook Pro"
      }
    }

    browser {
      rootsHead {
        contents: "No allowed folders on MacBook Pro"
      }

      feedback {
        contents: "Add a folder for MacBook Pro in Devices."
      }
    }
  }
}
