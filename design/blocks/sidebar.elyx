import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/avatar.elyx" as avatars
import "controls/badge.elyx" as badges
import "controls/status.elyx" as status
import "controls/brand.elyx" as logos

// Navigation row: icon, label, and trailing count or note
export navRow = frame {
  title: "Nav row",
  width: 232px,
  height: s.size.row,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: s.space.sm
  },
  corner-radius: s.radius.sm,
  padding: [0px, s.space.sm],
  children: [lead, trail],

  lead = frame {
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [glyph, label],

    glyph = asset : icons.inbox {
      width: 16px,
      height: 16px,
      fill[0].color: c.colors.muted
    }

    label = text : t.small {
      contents: "Inbox"
    }
  }

  trail = frame {
    layout: {align-items: .center},
    children: [count, note],

    count = frame : badges.count {
      value {
        contents: "3"
      }
    }

    note = text : t.caption {
      display: .none,
      contents: "2/3 online",
      fill[0].color: c.colors.faint
    }
  }
}

@variant
export navRowActive = frame : navRow {
  title: "Nav row / Active",
  top: 40px,
  fill[0].color: c.colors.selected,

  lead {
    glyph {
      fill[0].color: c.colors.text
    }

    label {
      font-style: "Medium"
    }
  }
}

// Project row: avatar, title, and trailing status. Shows status only when it needs user attention or is active.
export projectRow = frame {
  title: "Project row / Idle",
  top: 96px,
  width: 232px,
  height: 30px,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: s.space.sm
  },
  corner-radius: s.radius.sm,
  padding: [0px, s.space.sm, 0px, 6px],
  children: [lead, trail],

  lead = frame {
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [avatar, name],

    avatar = frame : avatars.avatar {}

    name = text : t.small {
      contents: "Docs Cleanup"
    }
  }

  trail = frame {
    layout: {align-items: .center, item-gap: 6px},
    children: [live, count, paused, note],

    live = shape : status.dotAgent {
      display: .none
    }

    count = frame : badges.count {
      display: .none
    }

    paused = asset : icons.pause {
      width: 14px,
      height: 14px,
      display: .none,
      fill[0].color: c.colors.faint
    }

    note = text : t.caption {
      display: .none,
      contents: "Waiting",
      fill[0].color: c.colors.faint
    }
  }
}

@variant
export projectRowActive = frame : projectRow {
  title: "Project row / Active",
  top: 136px,
  fill[0].color: c.colors.selected,

  lead {
    name {
      font-style: "Medium"
    }
  }
}

@variant
export projectRowLive = frame : projectRow {
  title: "Project row / Running",
  top: 176px,

  trail {
    live {
      display: .visible
    }
  }
}

@variant
export projectRowAttention = frame : projectRow {
  title: "Project row / Needs attention",
  top: 216px,

  trail {
    count {
      display: .visible
    }
  }
}

@variant
export projectRowPaused = frame : projectRow {
  title: "Project row / Paused",
  top: 256px,

  lead {
    name {
      fill[0].color: c.colors.muted
    }
  }

  trail {
    paused {
      display: .visible
    }
  }
}

@variant
export projectRowWaiting = frame : projectRow {
  title: "Project row / Waiting for device",
  top: 296px,

  trail {
    note {
      display: .visible
    }
  }
}

// Sidebar: global navigation, Project list, and employee account
export sidebar = frame {
  title: "Sidebar",
  caption: "Navigate between inbox, threads, devices, and projects.",
  left: 320px,
  width: s.size.sidebar,
  height: s.size.screenHeight,
  layout: {direction: .column, justify-content: .space-between},
  fill: c.colors.panel,
  border: {color: c.colors.borderSoft, sides: .right},
  padding: [0px, s.space.sm, s.space.sm],
  children: [top, footer],

  top = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xxs},
    children: [brand, nav, sectionHead, projects],

    brand = frame {
      width: 100%,
      height: s.size.header,
      layout: {justify-content: .space-between, align-items: .center},
      padding: [0px, s.space.xs, 0px, s.space.sm],
      children: [brandLead, newProject],

      brandLead = frame {
        layout: {align-items: .center, item-gap: s.space.sm},
        children: [mark, wordmark],

        mark = asset : logos.monoMark {
          width: 24px,
          height: 24px
        }

        wordmark = text : t.label {
          contents: "Baton",
          font-size: 14,
          font-style: "Semibold"
        }
      }

      newProject = frame : buttons.iconButton {
        @with-variant(icons.pen)
        glyph {}
      }
    }

    nav = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.xxs},
      children: [navInbox, navThreads, navDevices],

      navInbox = frame : navRow {
        width: 100%
      }

      navThreads = frame : navRow {
        width: 100%,

        trail {
          count {
            display: .none
          }
        }

        lead {
          label {
            contents: "Threads"
          }

          @with-variant(icons.terminal)
          glyph {}
        }
      }

      navDevices = frame : navRow {
        width: 100%,

        trail {
          count {
            display: .none
          }

          note {
            display: .visible
          }
        }

        lead {
          label {
            contents: "Devices"
          }

          @with-variant(icons.device)
          glyph {}
        }
      }
    }

    sectionHead = frame {
      width: 100%,
      height: 36px,
      layout: {justify-content: .space-between, align-items: .end},
      padding: [0px, s.space.sm, 6px],
      children: [sectionLabel, sectionAdd],

      sectionLabel = text : t.captionMedium {
        contents: "Projects",
        fill[0].color: c.colors.faint
      }

      sectionAdd = asset : icons.plus {
        width: 14px,
        height: 14px,
        fill[0].color: c.colors.faint
      }
    }

    projects = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.xxs},
      children: [projBaton, projCompat, projDocs, projSwitch],

      projBaton = frame : projectRowActive {
        width: 100%,

        lead {
          name {
            contents: "Baton Dev"
          }

          avatar {
            initial {
              contents: "B"
            }
          }
        }

        trail {
          live {
            display: .visible
          }
        }
      }

      projCompat = frame : projectRowAttention {
        width: 100%,

        lead {
          name {
            contents: "Compatibility"
          }

          @with-variant(avatars.amber)
          avatar {
            left: .nil
          }
        }
      }

      projDocs = frame : projectRow {
        width: 100%,

        lead {
          @with-variant(avatars.violet)
          avatar {
            left: .nil
          }
        }
      }

      projSwitch = frame : projectRowPaused {
        width: 100%,

        lead {
          name {
            contents: "Switch Patrol"
          }

          @with-variant(avatars.green)
          avatar {
            left: .nil
          }
        }
      }
    }
  }

  footer = frame {
    width: 100%,
    height: 40px,
    layout: {justify-content: .space-between, align-items: .center},
    border: {color: c.colors.borderSoft, sides: .top},
    padding: [s.space.sm, s.space.xs, 0px, s.space.sm],
    children: [account, settings],

    account = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [person, personName],

      person = frame : avatars.person {}

      personName = text : t.small {
        contents: "Kaken He"
      }
    }

    settings = frame : buttons.iconButton {
      @with-variant(icons.settings)
      glyph {}
    }
  }
}

@variant
export sidebarEmpty = frame : sidebar {
  title: "Sidebar / First visit",
  caption: "Open Threads to start a chat or connect a device first.",
  left: 640px,
  top: 0px,

  top {
    overrides: [insert(emptyProjects, after = sidebar.top.projects)],

    brand {
      newProject {
        title: "New chat"
      }
    }

    nav {
      navInbox {
        trail {
          count {
            display: .none
          }
        }
      }

      navDevices {
        trail {
          note {
            contents: "0 devices"
          }
        }
      }
    }

    projects {
      display: .none
    }
  }

  emptyProjects = text : t.caption {
    width: 100%,
    contents: "No projects yet",
    fill[0].color: c.colors.faint
  }
}

@variant
export sidebarCollapsed = frame : sidebar {
  title: "Sidebar / Collapsed",
  caption: "Keep navigation icons visible. Expand to see labels and projects.",
  left: 960px,
  top: 0px,
  width: 64px,

  top {
    brand {
      brandLead {
        wordmark {
          display: .none
        }
      }

      newProject {
        display: .none
      }
    }

    nav {
      overrides: [insert(newChat, after = .nil)],

      navInbox {
        lead {
          label {
            display: .none
          }
        }

        trail {
          display: .none
        }
      }

      navThreads {
        lead {
          label {
            display: .none
          }
        }

        trail {
          display: .none
        }
      }

      navDevices {
        lead {
          label {
            display: .none
          }
        }

        trail {
          display: .none
        }
      }
    }

    sectionHead {
      display: .none
    }

    projects {
      display: .none
    }
  }

  footer {
    account {
      personName {
        display: .none
      }
    }

    settings {
      display: .none
    }
  }

  newChat = frame : navRow {
    title: "New chat",
    width: 100%,

    trail {
      display: .none
    }

    lead {
      label {
        display: .none
      }

      @with-variant(icons.pen)
      glyph {}
    }
  }
}

export accountMenu = frame {
  title: "Account menu",
  caption: "Sign out of the current browser session.",
  left: 1100px,
  top: 0px,
  width: 232px,
  layout: {direction: .column, item-gap: 8px},
  fill: c.colors.surface,
  border: c.colors.border,
  corner-radius: s.radius.md,
  padding: 8px,
  children: [identity, signOut],

  identity = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 4px},
    padding: 8px,
    children: [personName, username],

    personName = text : t.label {
      contents: "Kaken He"
    }

    username = text : t.caption {
      contents: "kaken",
      fill[0].color: c.colors.faint
    }
  }

  signOut = frame : buttons.secondary {
    width: 100%,

    label {
      contents: "Sign out"
    }
  }
}
