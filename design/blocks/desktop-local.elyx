import "tokens/colors.elyx" as c
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/icons.elyx" as icons
import "controls/field.elyx" as fields
import "controls/input.elyx" as inputs
import "blocks/new-thread.elyx" as folders
import "blocks/dialog.elyx" as dialogs
import "blocks/thread-list.elyx" as lists
import "blocks/overview.elyx" as overviews
import "blocks/thread-detail.elyx" as details
import "blocks/project-page.elyx" as projects

// Icon labels are tooltips on hover and keyboard focus, and accessible names.
export folderTooltip = frame {
  title: "Local action tooltip",
  left: 600px,
  top: 0px,
  width: 136px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.inverse,
  corner-radius: 4px,
  padding: [5px, 8px],
  children: label,

  label = text : t.caption {
    contents: "Show in Explorer",
    fill[0].color: c.colors.onInverse
  }
}

export folderActions = frame {
  title: "Local folder icons / Windows",
  left: 0px,
  top: 0px,
  width: 44px,
  height: 20px,
  layout: {align-items: .center, item-gap: 4px},
  overflow: .visible,
  children: [reveal, editor],

  reveal = frame : buttons.iconButton {
    title: "Show in Explorer",
    caption: "Show this label on hover and keyboard focus.",
    width: 20px,
    height: 20px,
    overflow: .visible,
    overrides: [insert(tooltip, after = buttons.iconButton.glyph)],

    @with-variant(icons.folder)
    glyph {
      width: 13px,
      height: 13px
    }

    tooltip = frame : folderTooltip {
      left: -116px,
      top: -34px,
      display: .none,
      ignore-stack: .true
    }
  }

  editor = frame : buttons.iconButton {
    title: "Open in editor",
    caption: "Show this label on hover and keyboard focus.",
    width: 20px,
    height: 20px,
    overflow: .visible,
    overrides: [insert(tooltip, after = buttons.iconButton.glyph)],

    @with-variant(icons.editor)
    glyph {
      width: 13px,
      height: 13px
    }

    tooltip = frame : folderTooltip {
      left: -116px,
      top: -34px,
      display: .none,
      ignore-stack: .true,

      label {
        contents: "Open in editor"
      }
    }
  }
}

@variant
export folderActionsMac = frame : folderActions {
  title: "Local folder icons / macOS",
  left: 128px,
  top: 0px,

  reveal {
    title: "Show in Finder",

    tooltip {
      label {
        contents: "Show in Finder"
      }
    }
  }
}

// Only errors add a second line. Device, folder and actions share one metadata row.
export folderContext = frame {
  title: "Local device and folder",
  left: 0px,
  top: 80px,
  width: 392px,
  layout: {direction: .column, item-gap: 6px},
  overflow: .visible,
  children: [row, error],

  row = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: 4px},
    overflow: .visible,
    children: [device, separator, path, actions],

    device = text : t.caption {
      contents: "Windows Desktop",
      fill[0].color: c.colors.faint
    }

    separator = text : t.caption {
      contents: "·",
      fill[0].color: c.colors.faint
    }

    path = text : t.caption {
      contents: "D:\\src\\baton-ps160",
      font-family: "Paper Mono",
      fill[0].color: c.colors.faint
    }

    actions = frame : folderActions {}
  }

  error = text : t.captionDanger {
    width: 100%,
    display: .none,
    contents: "D:\\src\\baton-ps160 no longer exists."
  }
}

// Shared desktop compositions keep browser screens unchanged.
export localThread = frame : lists.threadsPageSplit {
  title: "Desktop thread",
  left: 0px,
  top: 160px,

  detail {
    footer {
      overrides: [
        insert(localFolder, after = details.threadDetail.footer.composer),
        remove(details.threadDetail.footer.context)
      ],
      overflow: .visible
    }

    head {
      lead {
        name {
          contents: "Review reconnect logs"
        }
      }
    }
  }

  main {
    list {
      runningRow {
        lead {
          name {
            contents: "Review reconnect logs"
          }
        }
      }
    }
  }

  localFolder = frame : folderContext {
    width: 100%
  }
}

@variant
export localThreadMac = frame : localThread {
  title: "Desktop thread / macOS",
  left: 3456px,
  top: 160px,

  detail {
    footer {
      localFolder {
        row {
          @with-variant(folderActionsMac)
          actions {}

          path {
            contents: "~/src/baton"
          }

          device {
            contents: "MacBook Pro"
          }
        }
      }
    }

    body {
      queued {
        line {
          bubble {
            content {
              contents: "Attach the full reconnect log as well."
            }
          }
        }
      }

      reply1 {
        attachments {
          first {
            copy {
              note {
                contents: "MacBook Pro · 48 KB"
              }
            }
          }
        }
      }

      message1 {
        line {
          bubble {
            content {
              contents: "Review the reconnect logs in ~/src/baton."
            }
          }
        }
      }
    }
  }

  main {
    list {
      waitingRow {
        place {
          contents: "Ubuntu Dev · Codex"
        }

        lead {
          name {
            contents: "Run reconnect tests on Ubuntu"
          }
        }
      }

      kiroRow {
        place {
          contents: "Windows Desktop · Kiro"
        }
      }

      runningRow {
        place {
          contents: "MacBook Pro · Codex"
        }
      }
    }
  }
}

export localProject = frame : projects.projectPage {
  title: "Desktop project",
  left: 1728px,
  top: 160px,

  overview {
    body {
      queuedRow {
        display: .none
      }

      queuedHead {
        display: .none
      }
    }

    summary {
      overflow: .visible,

      runtime {
        overflow: .visible,

        runtimeCard {
          overrides: [
            insert(localFolder, after = .nil),
            remove(overviews.overview.summary.runtime.runtimeCard.runtimeLine)
          ],
          overflow: .visible
        }
      }
    }
  }

  main {
    header {
      lead {
        state {
          caption {
            contents: "Running on MacBook Pro"
          }
        }
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "3/3 online"
            }
          }
        }
      }
    }
  }

  localFolder = frame : folderContext {
    width: 100%,

    row {
      @with-variant(folderActionsMac)
      actions {}

      path {
        contents: "~/src/baton"
      }

      device {
        contents: "MacBook Pro"
      }
    }
  }
}

// The native picker selects within the device's allowed folders; it never adds a new allowed root.
export localFolderPicker = frame : folders.folderPicker {
  title: "Desktop / Choose folder",
  left: 0px,
  top: 1320px,

  content {
    overrides: [
      insert(nativePicker, after = folders.folderPicker.device),
      insert(selectionError, after = folders.folderPicker.path)
    ],

    path {
      @with-variant(t.small)
      value {
        contents: "~/src/baton"
      }
    }
  }

  nativePicker = frame : buttons.smallSecondary {
    label {
      contents: "Choose local folder"
    }
  }

  selectionError = text : t.captionDanger {
    width: 100%,
    display: .none,
    contents: "~/Desktop/private is outside this device's allowed folders."
  }
}

export projectForm = frame : dialogs.dialog {
  title: "Desktop / New project",
  left: 760px,
  top: 1320px,
  width: 560px,

  footer {
    actions {
      @with-variant(buttons.button)
      confirm {
        label {
          contents: "Create project"
        }
      }
    }

    note {
      display: .none
    }
  }

  content {
    overrides: [
      insert(projectName, after = .nil),
      insert(goal, after = projectName),
      insert(model, after = goal),
      insert(location, after = model),
      remove(dialogs.dialog.content.message)
    ]
  }

  heading {
    contents: "New project"
  }

  projectName = frame : fields.field {
    width: 100%,

    helper {
      display: .none
    }

    input {
      @with-variant(t.small)
      value {
        contents: "Release checks"
      }
    }
  }

  goal = frame : fields.optionalText {
    width: 100%,

    helper {
      display: .none
    }

    input {
      @with-variant(t.small)
      value {
        contents: "Check reconnect behavior on both computers."
      }
    }
  }

  model = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 6px},
    children: [label, input],

    label = text : t.label {
      contents: "Project assistant model"
    }

    input = frame : inputs.select {
      width: 100%,

      value {
        contents: "ChatGPT · gpt-5.1"
      }
    }
  }

  location = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 8px},
    children: [label, device, path, choose, error],

    label = text : t.label {
      contents: "Working folder"
    }

    device = frame : inputs.select {
      width: 100%,

      value {
        contents: "MacBook Pro"
      }
    }

    path = text : t.mono {
      contents: "~/src/baton",
      fill[0].color: c.colors.faint
    }

    choose = frame : buttons.smallSecondary {
      label {
        contents: "Choose local folder"
      }
    }

    error = text : t.captionDanger {
      width: 100%,
      display: .none,
      contents: "~/Desktop/private is outside this device's allowed folders."
    }
  }
}
