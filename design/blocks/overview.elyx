import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "controls/tabs.elyx" as tabs

// Overview Thread row: status dot and title (opening of first message) on the first line; device and directory basename on the second line.
// Last activity time appears only on hover. The Agent name is left out; the detail panel shows it
export threadRow = frame {
  title: "Overview row / Running",
  width: 288px,
  layout: {direction: .column, item-gap: 1px},
  corner-radius: s.radius.sm,
  padding: [6px, s.space.sm],
  children: [line, sub],

  line = frame {
    width: 100%,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: s.space.sm
    },
    children: [lead, time],

    lead = frame {
      width: 100%,
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [mark, name],

      mark = shape : status.dot {}

      name = text : t.small {
        width: 100%,
        contents: "Run reconnect tests on Windows"
      }
    }

    time = text : t.caption {
      display: .none,
      contents: "12:00",
      fill[0].color: c.colors.faint
    }
  }

  sub = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: 6px},
    padding: [0px, 0px, 0px, 14px],
    children: [place, dir],

    place = text : t.caption {
      contents: "Windows Desktop ·",
      fill[0].color: c.colors.faint
    }

    dir = text : t.caption {
      contents: "baton-ps160",
      font-size: 11,
      font-family: "Paper Mono",
      fill[0].color: c.colors.faint
    }
  }
}

@variant
export threadRowSelected = frame : threadRow {
  title: "Overview row / Selected",
  top: 64px,
  fill[0].color: c.colors.selected
}

@variant
export threadRowHover = frame : threadRow {
  title: "Overview row / Hover",
  top: 296px,
  fill[0].color: c.colors.hover,

  line {
    time {
      display: .visible
    }
  }
}

// Memory entry: content, version, author, and timestamp
export memoryRow = frame {
  title: "Memory entry",
  top: 128px,
  width: 288px,
  layout: {direction: .column, item-gap: s.space.xxs},
  border: {color: c.colors.borderSoft, sides: .bottom},
  padding: [10px, s.space.sm],
  children: [content, meta],

  content = text : t.small {
    width: 100%,
    contents: "Baton repo path is ~/src/baton on MacBook and ~/work/baton on Ubuntu."
  }

  meta = text : t.caption {
    contents: "v2 · project assistant · today 14:05",
    fill[0].color: c.colors.faint
  }
}

// Group heading
export groupHead = frame {
  title: "Group heading",
  top: 224px,
  width: 288px,
  height: 28px,
  layout: {justify-content: .space-between, align-items: .center},
  padding: [0px, s.space.sm],
  children: [lead, extra],

  lead = frame {
    layout: {align-items: .center, item-gap: 6px},
    children: [label, count],

    label = text : t.captionMedium {
      contents: "Running",
      fill[0].color: c.colors.muted
    }

    count = text : t.caption {
      contents: "2",
      fill[0].color: c.colors.faint
    }
  }

  extra = asset : icons.chevronDown {
    width: 13px,
    height: 13px,
    fill[0].color: c.colors.faint
  }
}

// Overview panel: goal, runtime instance, Threads, and memory
export overview = frame {
  title: "Overview panel / Threads",
  caption: "Questions, running chats, and recent work. Commands show their exit code.",
  left: 360px,
  width: s.size.overview,
  height: s.size.screenHeight,
  layout: {direction: .column},
  fill: c.colors.glassLift,
  border: c.colors.glassEdge,
  corner-radius: s.radius.lg,
  children: [head, summary, tabBar, body],

  head = frame {
    width: 100%,
    height: s.size.header,
    layout: {justify-content: .space-between, align-items: .center},
    padding: [0px, s.space.sm, 0px, s.space.lg],
    children: [headLabel, headMore],

    headLabel = text : t.label {
      contents: "Overview"
    }

    headMore = frame : buttons.iconButton {}
  }

  summary = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.lg},
    padding: [s.space.xs, s.space.lg, s.space.lg],
    children: [goal, runtime],

    goal = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.xs},
      children: [goalHead, goalText],

      goalHead = frame {
        width: 100%,
        layout: {justify-content: .space-between, align-items: .center},
        children: [goalLabel, goalEdit],

        goalLabel = text : t.captionMedium {
          contents: "Goal",
          fill[0].color: c.colors.faint
        }

        goalEdit = asset : icons.pen {
          width: 13px,
          height: 13px,
          fill[0].color: c.colors.faint
        }
      }

      goalText = text : t.small {
        width: 100%,
        contents: "Milestone 1: run real work end-to-end across devices and return replies with attachments."
      }
    }

    runtime = frame {
      width: 100%,
      layout: {direction: .column, item-gap: 6px},
      children: [runtimeLabel, runtimeCard],

      runtimeLabel = text : t.captionMedium {
        contents: "Project assistant",
        fill[0].color: c.colors.faint
      }

      runtimeCard = frame {
        width: 100%,
        layout: {direction: .column, item-gap: s.space.xxs},
        children: [runtimeLine, runtimeNote],

        runtimeLine = frame {
          width: 100%,
          layout: {justify-content: .space-between, align-items: .center},
          children: [runtimeDevice, runtimeState],

          runtimeDevice = frame {
            layout: {align-items: .center, item-gap: s.space.sm},
            children: [runtimeGlyph, runtimeName],

            runtimeGlyph = asset : icons.device {
              width: 14px,
              height: 14px,
              fill[0].color: c.colors.muted
            }

            runtimeName = text : t.label {
              contents: "Ubuntu Dev"
            }
          }

          runtimeState = frame : status.labelAgent {}
        }

        runtimeNote = text : t.caption {
          width: 100%,
          contents: "ChatGPT · gpt-5.1",
          fill[0].color: c.colors.muted
        }
      }
    }
  }

  tabBar = frame {
    width: 100%,
    layout: {align-items: .end, item-gap: s.space.lg},
    border: {color: c.colors.borderSoft, sides: .bottom},
    padding: [0px, s.space.lg],
    children: [threadsTab, memoryTab],

    threadsTab = frame : tabs.tab {}

    memoryTab = frame : tabs.tabIdle {}
  }

  body = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xxs},
    slot: .true,
    padding: [s.space.sm, s.space.md],
    children: [
      needsHead,
      needsRow,
      activeHead,
      activeRow1,
      activeRow2,
      queuedHead,
      queuedRow,
      recentHead,
      recentRow1,
      recentRow2,
      recentMore
    ],

    needsHead = frame : groupHead {
      width: 100%,

      lead {
        label {
          contents: "Needs attention"
        }

        count {
          contents: "1"
        }
      }
    }

    needsRow = frame : threadRow {
      width: 100%,

      sub {
        dir {
          display: .none
        }

        place {
          contents: "Question · Check PS-158 migration"
        }
      }

      line {
        time {
          contents: "14:33"
        }

        lead {
          name {
            contents: "Run migration 031 on replica first?"
          }

          @with-variant(status.dotAttention)
          mark {
            left: .nil
          }
        }
      }
    }

    activeHead = frame : groupHead {
      width: 100%,
      padding-top: 6px,
      padding-left: s.space.sm,
      padding-bottom: 0px,
      padding-right: s.space.sm
    }

    activeRow1 = frame : threadRow {
      width: 100%
    }

    activeRow2 = frame : threadRow {
      width: 100%,

      line {
        lead {
          name {
            contents: "Write PS-160 test notes"
          }
        }

        time {
          contents: "02:00"
        }
      }

      sub {
        place {
          contents: "Ubuntu Dev ·"
        }

        dir {
          contents: "baton"
        }
      }
    }

    queuedHead = frame : groupHead {
      width: 100%,
      padding-top: 6px,
      padding-left: s.space.sm,
      padding-bottom: 0px,
      padding-right: s.space.sm,

      lead {
        label {
          contents: "Waiting for device"
        }

        count {
          contents: "1"
        }
      }
    }

    queuedRow = frame : threadRow {
      width: 100%,

      sub {
        dir {
          contents: "baton"
        }

        place {
          contents: "MacBook Pro ·"
        }
      }

      line {
        time {
          contents: "14:20"
        }

        lead {
          name {
            contents: "Push PS-160 branch"
          }

          @with-variant(status.dotQueued)
          mark {
            left: .nil
          }
        }
      }
    }

    recentHead = frame : groupHead {
      width: 100%,
      padding-top: 6px,
      padding-left: s.space.sm,
      padding-bottom: 0px,
      padding-right: s.space.sm,

      lead {
        label {
          contents: "Recent"
        }

        count {
          contents: "12"
        }
      }
    }

    recentRow1 = frame : threadRow {
      width: 100%,

      sub {
        dir {
          contents: "baton"
        }

        place {
          contents: "Ubuntu Dev ·"
        }
      }

      line {
        time {
          contents: "14:09"
        }

        lead {
          name {
            contents: "Run unit tests on Ubuntu"
          }

          @with-variant(status.dotIdle)
          mark {
            left: .nil
          }
        }
      }
    }

    recentRow2 = frame : threadRow {
      width: 100%,

      sub {
        dir {
          display: .none
        }

        place {
          contents: "Windows Desktop · exit 0"
        }
      }

      line {
        time {
          contents: "14:03"
        }

        lead {
          name {
            contents: "git worktree add",
            font-size: 12,
            font-family: "Paper Mono"
          }

          @with-variant(status.dotIdle)
          mark {
            left: .nil
          }
        }
      }
    }

    recentMore = frame : buttons.smallGhost {
      label {
        contents: "Show 10 more"
      }
    }
  }
}

// Memory tab
@variant
export overviewMemory = frame : overview {
  title: "Overview panel / Memory",
  left: 760px,

  body {
    overrides: [
      insert(mem1, after = .nil),
      insert(mem2, after = mem1),
      insert(mem3, after = mem2),
      insert(mem4, after = mem3),
      insert(addMemory, after = mem4),
      remove(overview.body.recentRow2),
      remove(overview.body.recentHead),
      remove(overview.body.queuedRow),
      remove(overview.body.queuedHead),
      remove(overview.body.activeRow2),
      remove(overview.body.recentMore),
      remove(overview.body.activeHead),
      remove(overview.body.activeRow1),
      remove(overview.body.recentRow1),
      remove(overview.body.needsRow),
      remove(overview.body.needsHead)
    ]
  }

  tabBar {
    @with-variant(tabs.tab)
    memoryTab {
      count {
        contents: "4"
      }

      label {
        contents: "Memory"
      }
    }

    @with-variant(tabs.tabIdle)
    threadsTab {
      count {
        contents: "7"
      }

      label {
        contents: "Threads"
      }

      left: .nil
    }
  }

  mem1 = frame : memoryRow {
    width: 100%
  }

  mem2 = frame : memoryRow {
    width: 100%,

    content {
      contents: "PS-160 worktree on Windows is at D:\\src\\baton-ps160."
    }

    meta {
      contents: "v1 · project assistant · today 14:03"
    }
  }

  mem3 = frame : memoryRow {
    width: 100%,

    content {
      contents: "Verification must use a real subscription; test doubles do not count."
    }

    meta {
      contents: "v3 · You · Yesterday 21:40"
    }
  }

  mem4 = frame : memoryRow {
    width: 100%,

    content {
      contents: "Run pnpm test to check the workspace. Build artifacts are not committed."
    }

    meta {
      contents: "v1 · project assistant · Oct 18"
    }
  }

  addMemory = frame : buttons.smallGhost {
    lead {
      width: 13px,
      height: 13px,
      display: .visible
    }

    label {
      contents: "Add memory"
    }
  }
}
