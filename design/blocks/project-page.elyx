import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "blocks/sidebar.elyx" as sidebars
import "blocks/project-header.elyx" as headers
import "blocks/conversation.elyx" as conv
import "controls/chip.elyx" as chips
import "blocks/composer.elyx" as composers
import "blocks/overview.elyx" as overviews

// Project page: sidebar, main conversation, and overview panel. Each state in screens/ instantiates this block.
// Main conversation aligns to the bottom so earlier turns clip at the top as if scrolled to the latest turn.
// Conversation turns and the composer share a single column (max-width 720px). When Thread detail replaces the overview panel, status chips appear above the composer.
export projectPage = frame {
  title: "Project page",
  width: s.size.screenWidth,
  height: s.size.screenHeight,
  layout: {direction: .row},
  fill: c.colors.canvas,
  children: [sidebar, main, overview],

  sidebar = frame : sidebars.sidebar {}

  main = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column},
    children: [header, transcript, dock],

    header = frame : headers.projectHeader {
      width: 100%
    }

    transcript = frame {
      width: 100%,
      height: 100%,
      layout: {
        direction: .column,
        justify-content: .end,
        align-items: .center,
        item-gap: s.space.xl
      },
      slot: .true,
      padding: [s.space.xl, s.space.xxl, s.space.lg],
      children: [day, user0, agent0, user1, agent1, typing],

      day = frame : conv.dayDivider {
        width: 100%,
        max-width: s.size.measure
      }

      user0 = frame : conv.userMessage {
        width: 100%,
        max-width: s.size.measure,

        bubble {
          content {
            contents: "Has PS-160 been merged into main?"
          }
        }
      }

      agent0 = frame : conv.agentTurn {
        width: 100%,
        max-width: s.size.measure,

        content {
          contents: "Yes, main is now at 4c1e9a2. Ready for verification."
        }
      }

      user1 = frame : conv.userMessage {
        width: 100%,
        max-width: s.size.measure,

        bubble {
          content {
            width: 420px,
            contents: "Start verification on Windows and Ubuntu: run reconnect tests on Windows and unit tests on Ubuntu. Tell me when they finish."
          }
        }
      }

      agent1 = frame : conv.agentTurnWork {
        width: 100%,
        max-width: s.size.measure,

        content {
          contents: "Opened both chats. Saved the Windows worktree path, D:\\src\\baton-ps160, in project memory. I'll report back once both finish."
        }
      }

      typing = frame : conv.typing {
        width: 100%,
        max-width: s.size.measure,

        label {
          contents: "Reading Codex's reply from Ubuntu Dev…"
        }
      }
    }

    dock = frame {
      width: 100%,
      layout: {direction: .column, align-items: .center, item-gap: 10px},
      slot: .true,
      padding: [0px, s.space.xxl, 20px],
      children: [signals, composer],

      signals = frame {
        width: 100%,
        max-width: s.size.measure,
        display: .none,
        layout: {align-items: .center, item-gap: 6px},
        children: [running, queued, attention],

        running = frame : chips.statusChip {}

        queued = frame : chips.statusChipQueued {}

        attention = frame : chips.statusChipAttention {}
      }

      composer = frame : composers.composer {
        width: 100%,
        max-width: s.size.measure
      }
    }
  }

  overview = frame : overviews.overview {}
}
