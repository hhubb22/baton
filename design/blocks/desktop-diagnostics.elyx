import "tokens/colors.elyx" as c
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/icons.elyx" as icons
import "controls/status.elyx" as status
import "screens/devices.elyx" as devices

export diagnosticRow = frame {
  title: "Diagnostic fact",
  left: 0px,
  top: 0px,
  width: 740px,
  layout: {item-gap: 20px},
  children: [label, value],

  label = text : t.caption {
    width: 148px,
    contents: "Last exit"
  }

  value = text : t.small {
    width: 100%,
    contents: "Unexpected exit · code 1 · Oct 27, 14:32"
  }
}

export diagnostics = frame {
  title: "Local device diagnostics",
  left: 0px,
  top: 120px,
  width: 740px,
  layout: {direction: .column, item-gap: 12px},
  children: [
    heading,
    process,
    lastExit,
    versions,
    platform,
    phase,
    problem,
    actions
  ],

  heading = text : t.heading {
    contents: "On this computer"
  }

  process = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: 20px},
    children: [label, state],

    label = text : t.caption {
      width: 148px,
      contents: "Device service"
    }

    state = frame {
      layout: {align-items: .center, item-gap: 8px},
      children: [dot, value],

      dot = shape : status.dotOnline {}

      value = text : t.small {
        contents: "PID 8421"
      }
    }
  }

  lastExit = frame : diagnosticRow {
    width: 100%
  }

  versions = frame : diagnosticRow {
    width: 100%,

    label {
      contents: "Versions"
    }

    value {
      contents: "Baton 0.1.0 · batond 0.1.0"
    }
  }

  platform = frame : diagnosticRow {
    width: 100%,

    label {
      contents: "Platform"
    }

    value {
      contents: "macOS · arm64"
    }
  }

  phase = frame : diagnosticRow {
    width: 100%,
    display: .none,

    label {
      contents: "Update"
    }

    value {
      contents: "Preparing · 1 reply still running"
    }
  }

  problem = text : t.captionAttention {
    width: 100%,
    display: .none,
    contents: "Finish migration before restarting the device service."
  }

  actions = frame {
    width: 100%,
    layout: {item-gap: 8px},
    overflow: .visible,
    children: [retry, restart, logs, copy],

    retry = frame : buttons.smallSecondary {
      display: .none,

      label {
        contents: "Retry migration"
      }
    }

    restart = frame : buttons.smallSecondary {
      label {
        contents: "Restart device service"
      }
    }

    logs = frame : buttons.smallGhost {
      label {
        contents: "Open logs folder"
      }
    }

    copy = frame : buttons.smallGhost {
      label {
        contents: "Copy diagnostic summary"
      }
    }
  }
}

export desktopDevicePage = frame : devices.devices {
  title: "Desktop device details",
  left: 0px,
  top: 540px,

  main {
    content {
      list {
        ubuntu {
          fill[0].color: c.colors.transparent,

          @with-variant(icons.chevronRight)
          chevron {}
        }

        ubuntuDetail {
          display: .none
        }

        windows {
          state {
            caption {
              display: .none
            }
          }
        }

        macDetail {
          overrides: [
            insert(
              local,
              after = devices.devices.main.content.list.macDetail.macNotice
            )
          ],

          macNotice {
            display: .none
          }

          display: .visible
        }

        mac {
          fill[0].color: c.colors.selected,

          @with-variant(icons.chevronDown)
          chevron {}

          @with-variant(status.labelOnline)
          state {
            caption {
              display: .none
            }
          }
        }
      }

      intro {
        introCopy {
          introTitle {
            contents: "3 devices, 3 online"
          }
        }
      }
    }
  }

  sidebar {
    top {
      nav {
        navDevices {
          trail {
            note {
              contents: "3/3 online"
            }
          }
        }
      }
    }
  }

  local = frame : diagnostics {
    width: 100%
  }
}
