import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/icons.elyx" as icons

// Dialog: heading, content slot, footer note, and actions slot.
// At most two overlay layers; a dialog may open a select menu inside it, never a stacked dialog.
export dialog = frame {
  title: "Dialog",
  width: 480px,
  layout: {direction: .column, item-gap: 20px},
  fill: c.colors.surface,
  border: c.colors.border,
  shadow: [
    {
      drop-shadow: {
        color: c.colors.shadowFar,
        offset: point(0px, 12px),
        blur-radius: 32px
      }
    },
    {
      drop-shadow: {
        color: c.colors.shadowNear,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: 14px,
  padding: s.space.xl,
  children: [heading, content, footer],

  heading = text : t.heading {
    contents: "Archive “Switch Patrol”?"
  }

  content = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.lg},
    slot: .true,
    children: message,

    message = text : t.small {
      width: 100%,
      contents: "Stops the project assistant and closes 3 open questions. Chat, memory, and threads are kept.",
      fill[0].color: c.colors.muted
    }
  }

  footer = frame {
    width: 100%,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: s.space.lg
    },
    children: [note, actions],

    note = text : t.caption {
      width: 100%,
      contents: "",
      fill[0].color: c.colors.faint
    }

    actions = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      slot: .true,
      children: [cancel, confirm],

      cancel = frame : buttons.secondary {}

      confirm = frame : buttons.dangerSolid {}
    }
  }
}

// Settings action row: title, description, and button
export settingRow = frame {
  title: "Settings action row",
  top: 400px,
  width: 512px,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: s.space.xl
  },
  children: [copy, action],

  copy = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xxs},
    children: [rowTitle, rowText],

    rowTitle = text : t.label {
      contents: "Pause project"
    }

    rowText = text : t.caption {
      width: 100%,
      contents: "New messages wait until you resume. Threads keep running.",
      fill[0].color: c.colors.muted
    }
  }

  action = frame : buttons.smallSecondary {
    label {
      contents: "Pause"
    }

    @with-variant(icons.pause)
    lead {
      width: 13px,
      height: 13px,
      display: .visible
    }
  }
}
