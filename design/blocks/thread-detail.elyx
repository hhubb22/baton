import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "controls/avatar.elyx" as avatars
import "blocks/composer.elyx" as composers
import "blocks/conversation.elyx" as conv
import "blocks/attention-card.elyx" as attention
import "blocks/banner.elyx" as banners

// 附件：所在设备、路径、能否查看。附件指向登记目录里的文件时可以直接预览
export attachmentRow = frame {
  title: "附件 / 可查看",
  width: 392px,
  layout: {align-items: .center, item-gap: 10px},
  padding: [s.space.sm, 0px],
  children: [glyph, copy, action],

  glyph = asset : icons.file {
    width: 15px,
    height: 15px,
    fill[0].color: c.colors.muted
  }

  copy = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 1px},
    children: [path, note],

    path = text : t.small {
      contents: "reconnect.log"
    }

    note = text : t.caption {
      contents: "Windows 台式机 · 48 KiB",
      fill[0].color: c.colors.faint
    }
  }

  action = text : t.caption {
    contents: "查看",
    fill[0].color: c.colors.link
  }
}

@variant
export attachmentOffline = frame : attachmentRow {
  title: "附件 / 设备离线",
  top: 64px,

  copy {
    path {
      fill[0].color: c.colors.muted,
      contents: "macos-reconnect.log"
    }

    note {
      contents: "MacBook Pro · 离线，暂不可查看"
    }
  }

  action {
    display: .none
  }
}

// 代码提交：写仓库和完整 SHA，不需要设备在线
@variant
export commitRow = frame : attachmentRow {
  title: "附件 / 代码提交",
  top: 128px,

  action {
    contents: "复制"
  }

  copy {
    note {
      contents: "hhubb22/baton · fix(gateway): 唤醒后重建 TLS 连接"
    }

    path {
      contents: "4c1e9a2f0b7d63e18a5c2f9e4d1b0a7c6e3f2d19",
      font-size: 12,
      font-family: "Paper Mono"
    }
  }

  @with-variant(icons.commit)
  glyph {}
}

// 发给 Agent 的消息：和主对话里的用户消息一样，右对齐的浅灰气泡。
// Project Agent 发的消息在气泡左下角带它的标识，你发的不带。发送时间在悬停时显示。超过一行的消息给正文写明宽度
export threadMessage = frame {
  title: "Thread 消息 / Project Agent 发的",
  top: 192px,
  width: 392px,
  layout: {direction: .column, align-items: .end, item-gap: 6px},
  children: [line, meta],

  line = frame {
    layout: {align-items: .end, item-gap: s.space.sm},
    children: [from, bubble],

    from = frame : avatars.agentMark {
      width: 20px,
      height: 20px
    }

    bubble = frame {
      width: .auto,
      layout: {direction: .row},
      fill: c.colors.subtle,
      shadow: {
        drop-shadow: {
          color: rgb(0%, 0%, 0%, 4%),
          offset: point(0px, 1px),
          blur-radius: 2px
        }
      },
      corner-radius: 18px,
      padding: [10px, 16px],
      children: content,

      content = text : t.body {
        width: 300px,
        contents: "在 D:\\src\\baton-ps160 跑 go test ./internal/gateway -run Reconnect -count=1，再让机器睡眠 1 分钟后唤醒，看能不能重新连上。日志保存为附件。"
      }
    }
  }

  meta = frame {
    display: .none,
    layout: {align-items: .center, item-gap: s.space.xs},
    padding: [0px, s.space.xs],
    children: [metaIcon, metaText, withdraw],

    metaIcon = asset : icons.clock {
      width: 13px,
      height: 13px,
      fill[0].color: c.colors.faint
    }

    metaText = text : t.caption {
      contents: "排队中 ·",
      fill[0].color: c.colors.faint
    }

    withdraw = text : t.caption {
      contents: "撤回",
      fill[0].color: c.colors.link
    }
  }
}

// 排队中的消息：你发的，描边气泡表示还没发出，这一轮结束后发出，发出前可以撤回
@variant
export threadMessageQueued = frame : threadMessage {
  title: "Thread 消息 / 排队中",
  top: 320px,

  line {
    bubble {
      border[0].color: c.colors.border,
      fill[0].color: c.colors.transparent,
      shadow[0]: .nil,

      content {
        width: .auto,
        contents: "顺便把 macOS 的日志也贴上来。"
      }
    }

    from {
      display: .none
    }
  }

  meta {
    display: .visible
  }
}

// Agent 的回复：和 Project Agent 的回复一样，靠左的正文，不加名字。结束时间和这一轮的用时在悬停时显示。
// 开头是这一轮的过程记录，附件收在正文后的卡片里。正文和附件由中心保存，设备离线时仍能看到
export threadReply = frame {
  title: "Agent 回复",
  top: 480px,
  width: 392px,
  layout: {direction: .column, item-gap: s.space.md},
  children: [trace, content, attachments],

  trace = frame : threadTrace {
    width: 100%
  }

  content = text : t.body {
    width: 100%,
    contents: "48 项中 47 项通过。TestReconnectAfterSleep 在睡眠唤醒后 30 秒内没有重新连上，日志在附件里。"
  }

  attachments = frame {
    width: 100%,
    layout: {direction: .column},
    fill: c.colors.surface,
    border: c.colors.hairline,
    shadow: [
      {
        drop-shadow: {
          color: rgb(0%, 0%, 0%, 3%),
          offset: point(0px, 1px),
          blur-radius: 2px
        }
      },
      {
        drop-shadow: {
          color: rgb(0%, 0%, 0%, 4%),
          offset: point(0px, 4px),
          blur-radius: 16px
        }
      }
    ],
    corner-radius: 14px,
    padding: [s.space.xxs, s.space.md],
    children: [first, second],

    first = frame : attachmentRow {
      width: 100%
    }

    second = frame : attachmentOffline {
      width: 100%
    }
  }
}

// 一轮的过程记录：Agent 调用的工具、执行的命令和改动的文件，和主对话的过程记录同一个样式，默认收起成一行。
// 完整过程留在设备上，点开时从设备分页读取；设备离线时写明暂不可查看，中心保存的回复不受影响
export threadTrace = frame : conv.activityLog {
  title: "Thread 过程记录 / 收起",
  top: 760px,
  width: 392px,

  logBody {
    logSteps {
      overrides: [
        insert(
          unavailable,
          after = conv.activityLog.logBody.logSteps.stepMemory
        )
      ],

      stepMemory {
        stepRow {
          stepNote {
            display: .none
          }

          stepLead {
            stepLabel {
              contents: "写入 reconnect.log"
            }

            @with-variant(icons.file)
            stepGlyph {}
          }
        }
      }

      stepCommand {
        stepRow {
          stepNote {
            display: .none
          }

          stepLead {
            stepLabel {
              contents: "go test -run Reconnect ./internal/gateway"
            }
          }
        }

        stepOutput {
          stepResult {
            contents: "=== RUN   TestReconnectAfterSleep\nreconnect_test.go:88: 唤醒后 30 秒内未重连\n--- FAIL: TestReconnectAfterSleep (92.41s)\nFAIL"
          }
        }
      }
    }
  }

  logHead {
    logLabel {
      contents: "执行了 1 条命令，写了 1 个文件"
    }
  }

  unavailable = text : t.small {
    display: .none,
    contents: "Windows 台式机离线，暂不可查看",
    fill[0].color: c.colors.faint
  }
}

// 展开：逐条列出步骤，命令可以继续展开看输出
@variant
export threadTraceOpen = frame : threadTrace {
  title: "Thread 过程记录 / 展开",
  top: 830px,

  logBody {
    display: .visible
  }

  logHead {
    @with-variant(icons.chevronDown)
    logChevron {}
  }
}

// 设备离线：过程记录读不到，只说明原因
@variant
export threadTraceOffline = frame : threadTraceOpen {
  title: "Thread 过程记录 / 设备离线",
  top: 1100px,

  logBody {
    logSteps {
      stepCommand {
        display: .none
      }

      stepMemory {
        display: .none
      }

      unavailable {
        display: .visible
      }
    }
  }
}

// 设备上的会话记录已删除：过程记录读不到，中心保存的回复和附件不受影响
@variant
export threadTraceMissing = frame : threadTraceOffline {
  title: "Thread 过程记录 / 历史缺失",
  top: 1180px,

  logBody {
    logSteps {
      unavailable {
        contents: "设备上的会话记录已删除"
      }
    }
  }
}

// 执行中的一轮：过程记录展开显示，开头是已过的时间，下面是从设备推送的实时输出。实时输出只做展示，不保存到中心；
// 断开后从设备补取，补不齐的地方标出缺口。这一轮结束后收起，换成从设备读取的过程记录
export liveOutput = frame {
  title: "执行中",
  top: 1260px,
  width: 392px,
  layout: {direction: .column, item-gap: 6px},
  children: [note, stream],

  note = frame {
    height: 24px,
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [mark, label],

    mark = frame {
      width: 13px,
      height: 13px,
      layout: {justify-content: .center, align-items: .center},
      children: dot,

      dot = shape : status.dot {}
    }

    label = text : t.small {
      contents: "执行中 · 03:12",
      line-height: 1,
      fill[0].color: c.colors.info
    }
  }

  stream = frame {
    width: 100%,
    layout: {direction: .column},
    padding: [0px, 0px, 0px, 6px],
    children: rail,

    rail = frame {
      width: 100%,
      layout: {direction: .column},
      border: {color: c.colors.borderSoft, width: 1.5px, sides: .left},
      padding: [0px, 0px, 0px, 15px],
      children: lines,

      lines = frame {
        width: 100%,
        layout: {direction: .column},
        fill: c.colors.code,
        border: c.colors.codeBorder,
        corner-radius: 10px,
        padding: [10px, s.space.md],
        children: [output, gap, tail],

        output = text : t.mono {
          width: 100%,
          contents: "$ go test ./internal/gateway -run Reconnect -count=1\n=== RUN   TestReconnectAfterSleep\n    sleeping host for 180s…"
        }

        gap = frame {
          width: 100%,
          display: .none,
          layout: {align-items: .center, item-gap: 6px},
          padding: [6px, 0px, 2px],
          children: [gapGlyph, gapText],

          gapGlyph = asset : icons.offline {
            width: 13px,
            height: 13px,
            fill[0].color: c.colors.faint
          }

          gapText = text : t.caption {
            contents: "连接中断，重连后从设备补取",
            line-height: 1,
            fill[0].color: c.colors.faint
          }
        }

        tail = text : t.mono {
          width: 100%,
          display: .none,
          contents: "    reconnected after 41.2s\n--- PASS: TestReconnectAfterSleep (221.07s)"
        }
      }
    }
  }
}

// 实时输出中断：设备离线或连接断开。计时停在最后一次报告，不把过去的执行中当成当前事实
@variant
export liveOutputInterrupted = frame : liveOutput {
  title: "执行中 / 输出中断",
  top: 1440px,

  note {
    label {
      fill[0].color: c.colors.muted,
      contents: "14:32 后没有上报"
    }

    mark {
      @with-variant(status.dotIdle)
      dot {
        left: .nil
      }
    }
  }

  stream {
    rail {
      lines {
        gap {
          display: .visible
        }
      }
    }
  }
}

// 重连后补不齐：设备只保留最近一段输出，缺掉的地方标出缺口
@variant
export liveOutputGap = frame : liveOutput {
  title: "执行中 / 输出缺口",
  top: 1630px,

  stream {
    rail {
      lines {
        gap {
          gapText {
            contents: "缺一段输出，设备上已不再保留"
          }

          display: .visible,

          @with-variant(icons.dots)
          gapGlyph {}
        }

        tail {
          display: .visible
        }
      }
    }
  }

  note {
    label {
      contents: "执行中 · 06:41"
    }
  }
}

// 选中回复、文件预览或事项里的文字后出现，把文字和来源预填到主对话输入框
export selectionMenu = frame {
  title: "选中文字后的菜单",
  top: 1860px,
  layout: {align-items: .center},
  fill: c.colors.surface,
  border: c.colors.border,
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 8%),
      offset: point(0px, 4px),
      blur-radius: 12px
    }
  },
  corner-radius: s.radius.md,
  padding: s.space.xxs,
  children: ask,

  ask = frame : buttons.smallGhost {
    label {
      contents: "问 Project Agent"
    }

    @with-variant(icons.reply)
    lead {
      width: 14px,
      height: 14px,
      display: .visible
    }
  }
}

// Thread 详情面板：在 Project 页右侧打开，主对话保持不动。内容和主对话是同一套聊天样式：
// 发给 Agent 的消息右对齐，Agent 的回复靠左，关联的事项以卡片出现在时间线里。
// 标题栏只放名称和状态；设备和目录在输入区下方一行，Agent 写在输入区的提示文字里。
export threadDetail = frame {
  title: "Thread 详情面板",
  caption: "440px。替换概览栏显示；返回后回到概览。",
  left: 480px,
  width: s.size.detail,
  height: s.size.screenHeight,
  layout: {direction: .column},
  fill: c.colors.surface,
  border: {color: c.colors.borderSoft, sides: .left},
  children: [head, body, footer],

  head = frame {
    width: 100%,
    height: s.size.header,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: s.space.md
    },
    border: {color: c.colors.borderSoft, sides: .bottom},
    padding: [0px, s.space.sm],
    children: [lead, tools],

    lead = frame {
      layout: {align-items: .center, item-gap: 6px},
      children: [back, name, state],

      back = frame : buttons.iconButton {
        @with-variant(icons.chevronLeft)
        glyph {}
      }

      name = text : t.label {
        contents: "在 Windows 上跑重连测试",
        font-size: 14,
        font-style: "Semibold"
      }

      state = frame {
        layout: {align-items: .center, item-gap: 6px},
        padding: [0px, 0px, 0px, 6px],
        children: [mark, stateText],

        mark = shape : status.dotIdle {}

        stateText = text : t.caption {
          contents: "空闲",
          fill[0].color: c.colors.muted
        }
      }
    }

    tools = frame {
      layout: {align-items: .center, item-gap: s.space.xxs},
      children: [external, more, close],

      external = frame : buttons.iconButton {
        @with-variant(icons.external)
        glyph {}
      }

      more = frame : buttons.iconButton {}

      close = frame : buttons.iconButton {
        @with-variant(icons.close)
        glyph {}
      }
    }
  }

  body = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, justify-content: .end, item-gap: s.space.xl},
    padding: [s.space.xl, s.space.xl, s.space.sm],
    children: [message1, reply1, item, message2, live, queued],

    message1 = frame : threadMessage {
      width: 100%
    }

    reply1 = frame : threadReply {
      width: 100%
    }

    item = frame : attention.attentionCard {
      width: 100%,
      overrides: [
        remove(attention.attentionCard.footer),
        remove(attention.attentionCard.threadRef),
        remove(attention.attentionCard.summary)
      ],

      head {
        time {
          display: .none
        }
      }

      options {
        third {
          label {
            contents: "再跑一次"
          }
        }

        second {
          label {
            contents: "先跳过"
          }
        }

        first {
          label {
            contents: "找出原因并修好"
          }
        }
      }

      heading {
        contents: "1 项测试没通过，下一步怎么做？"
      }
    }

    message2 = frame : conv.userMessage {
      width: 100%,
      display: .none,

      bubble {
        content {
          contents: "睡眠时间改成 3 分钟，再跑一次。"
        }
      }
    }

    live = frame : liveOutput {
      width: 100%,
      display: .none
    }

    queued = frame : threadMessageQueued {
      width: 100%,
      display: .none
    }
  }

  footer = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 10px},
    padding: [s.space.sm, s.space.xl, 14px],
    children: [notice, composer, context],

    notice = frame : banners.banner {
      width: 100%,
      display: .none
    }

    composer = frame : composers.threadComposer {
      width: 100%
    }

    context = frame {
      width: 100%,
      layout: {align-items: .center, item-gap: s.space.md},
      padding: [0px, s.space.lg],
      children: [device, dir],

      device = frame {
        layout: {align-items: .center, item-gap: 5px},
        children: [deviceGlyph, deviceName],

        deviceGlyph = asset : icons.laptop {
          width: 13px,
          height: 13px,
          fill[0].color: c.colors.faint
        }

        deviceName = text : t.caption {
          contents: "Windows 台式机",
          line-height: 1,
          fill[0].color: c.colors.faint
        }
      }

      dir = frame {
        layout: {align-items: .center, item-gap: 5px},
        children: [dirGlyph, dirName],

        dirGlyph = asset : icons.folder {
          width: 13px,
          height: 13px,
          fill[0].color: c.colors.faint
        }

        dirName = text : t.caption {
          contents: "D:\\src\\baton-ps160",
          font-family: "Paper Mono",
          line-height: 1,
          fill[0].color: c.colors.faint
        }
      }
    }
  }
}

// Agent 执行中：你直接发的消息开启新的一轮，下面是实时输出和排队中的消息。可以选排队或插入，也可以停止
@variant
export threadDetailRunning = frame : threadDetail {
  title: "Thread 详情面板 / 执行中",
  left: 1000px,

  footer {
    @with-variant(composers.threadComposerRunning)
    composer {}
  }

  head {
    lead {
      state {
        stateText {
          fill[0].color: c.colors.info,
          contents: "执行中"
        }

        @with-variant(status.dot)
        mark {}
      }
    }
  }

  body {
    item {
      display: .none
    }

    reply1 {
      attachments {
        second {
          display: .none
        }
      }
    }

    queued {
      display: .visible
    }

    live {
      display: .visible
    }

    message2 {
      display: .visible
    }
  }
}

// 已请求停止：等设备确认，确认前状态仍是执行中。排队中的消息随停止一起撤回
@variant
export threadDetailStopping = frame : threadDetailRunning {
  title: "Thread 详情面板 / 正在停止",
  left: 1520px,
  top: 0px,

  footer {
    @with-variant(composers.threadComposerStopping)
    composer {}
  }

  body {
    queued {
      meta {
        withdraw {
          display: .none
        }

        metaText {
          contents: "已随停止撤回"
        }
      }
    }

    live {
      note {
        label {
          contents: "停止中 · 03:40"
        }
      }
    }
  }
}

// 执行中设备离线：标题栏写离线前的状态，实时输出停在最后一次报告，重连后补取
@variant
export threadDetailOffline = frame : threadDetailRunning {
  title: "Thread 详情面板 / 执行中设备离线",
  left: 2040px,
  top: 0px,

  body {
    queued {
      display: .none
    }

    @with-variant(liveOutputInterrupted)
    live {}
  }

  footer {
    notice {
      copy {
        detail {
          contents: "这一轮可能仍在设备上执行，重连后补取输出。"
        }

        heading {
          contents: "Windows 台式机离线"
        }
      }

      display: .visible
    }
  }

  head {
    lead {
      state {
        stateText {
          fill[0].color: c.colors.muted,
          contents: "离线前执行中"
        }

        @with-variant(status.dotIdle)
        mark {
          left: .nil
        }
      }
    }
  }
}

// 已归档：不再接收消息，消息、回复和附件都保留
@variant
export threadDetailArchived = frame : threadDetail {
  title: "Thread 详情面板 / 已归档",
  left: 2560px,
  top: 0px,

  footer {
    composer {
      display: .none
    }

    notice {
      action {
        display: .none
      }

      copy {
        detail {
          contents: "不再接收消息，记录和附件都保留。"
        }

        heading {
          contents: "已归档"
        }
      }

      display: .visible,

      @with-variant(icons.archive)
      glyph {}
    }
  }

  body {
    item {
      display: .none
    }
  }

  head {
    lead {
      state {
        stateText {
          contents: "已归档"
        }
      }
    }
  }
}

// 等待设备：Thread 已保存，设备上线并同步后开始，没有期限
@variant
export threadDetailWaiting = frame : threadDetail {
  title: "Thread 详情面板 / 等待设备",
  left: 480px,
  top: 1060px,

  body {
    item {
      display: .none
    }

    reply1 {
      display: .none
    }

    message1 {
      line {
        from {
          display: .none
        }

        bubble {
          content {
            contents: "在 ~/src/baton 跑 go test ./internal/gateway -run Reconnect，让机器睡眠 1 分钟后唤醒，看能不能重新连上。"
          }
        }
      }

      meta {
        metaText {
          contents: "等待设备"
        }

        display: .visible
      }
    }
  }

  footer {
    context {
      dir {
        dirName {
          contents: "~/src/baton"
        }
      }

      device {
        deviceName {
          contents: "MacBook Pro"
        }
      }
    }

    notice {
      copy {
        detail {
          contents: "设备上线后开始，不会改派到其他设备。"
        }

        heading {
          contents: "等待 MacBook Pro 上线"
        }
      }

      display: .visible
    }
  }

  head {
    lead {
      state {
        stateText {
          contents: "等待设备"
        }

        @with-variant(status.dotQueued)
        mark {}
      }

      name {
        contents: "在 MacBook 上跑重连测试"
      }
    }
  }
}

// 状态未知：没能确认 Agent 是否收到最后一条消息。Baton 不自动重发，看过情况后可以继续发
@variant
export threadDetailUnknown = frame : threadDetail {
  title: "Thread 详情面板 / 状态未知",
  left: 1000px,
  top: 1060px,

  footer {
    @with-variant(banners.bannerAttention)
    notice {
      action {
        label {
          contents: "查看过程"
        }
      }

      copy {
        detail {
          contents: "设备上的 Worker 重启过，没能确认。Baton 不会自动重发。"
        }

        heading {
          contents: "不确定 Codex 是否收到这条消息"
        }
      }

      top: .nil,
      display: .visible
    }
  }

  body {
    message2 {
      meta {
        metaText {
          contents: "不确定是否收到"
        }

        display: .visible,

        @with-variant(icons.alert)
        metaIcon {}
      }

      display: .visible
    }

    item {
      display: .none
    }

    reply1 {
      attachments {
        second {
          display: .none
        }
      }
    }
  }

  head {
    lead {
      state {
        stateText {
          fill[0].color: c.colors.attentionText,
          contents: "状态未知"
        }

        @with-variant(status.dotAttention)
        mark {}
      }
    }
  }
}

// 已停止且可以恢复：写明原因，下一条消息恢复原会话，Thread ID 不变
@variant
export threadDetailStopped = frame : threadDetail {
  title: "Thread 详情面板 / 已停止",
  left: 1520px,
  top: 1060px,

  footer {
    notice {
      action {
        display: .none
      }

      copy {
        detail {
          contents: "已发生的修改不会回滚。"
        }

        heading {
          contents: "超过 2 小时，已停止"
        }
      }

      display: .visible,

      @with-variant(icons.stop)
      glyph {}
    }

    composer {
      prompt {
        contents: "发消息恢复原会话"
      }
    }
  }

  head {
    lead {
      state {
        stateText {
          fill[0].color: c.colors.danger,
          contents: "已停止"
        }

        @with-variant(status.dotStopped)
        mark {}
      }
    }
  }

  body {
    item {
      display: .none
    }

    reply1 {
      attachments {
        second {
          display: .none
        }
      }
    }

    message2 {
      display: .visible
    }
  }
}

// 无法恢复：写明原因，例如设备上的会话记录已删除或 Agent 不支持恢复。不伪装成原会话，横幅没有动作
@variant
export threadDetailUnresumable = frame : threadDetailStopped {
  title: "Thread 详情面板 / 无法恢复",
  left: 2040px,
  top: 1060px,

  footer {
    composer {
      display: .none
    }

    notice {
      copy {
        detail {
          contents: "设备上的会话记录已删除。"
        }

        heading {
          contents: "无法恢复原会话"
        }
      }

      @with-variant(icons.alert)
      glyph {}
    }
  }

  body {
    message2 {
      display: .none
    }

    reply1 {
      @with-variant(threadTraceMissing)
      trace {}
    }
  }
}

