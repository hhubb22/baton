import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "controls/avatar.elyx" as avatars
import "blocks/composer.elyx" as composers
import "blocks/conversation.elyx" as conv
import "blocks/attention-card.elyx" as attention
import "blocks/banner.elyx" as banners

// Attachment: device, path, and availability. Files inside registered directories can be previewed directly
export attachmentRow = frame {
  title: "Attachment / Available",
  width: 392px,
  layout: {align-items: .center, item-gap: 10px},
  padding: [s.space.sm, 0px],
  children: [glyph, copy, action],

  glyph = asset : icons.file {
    width: 15px,
    height: 15px,
    fill[0].color: c.colors.muted
  }

  copy = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 1px},
    children: [path, note],

    path = text : t.small {
      contents: "reconnect.log"
    }

    note = text : t.caption {
      contents: "Windows Desktop · 48 KB",
      fill[0].color: c.colors.faint
    }
  }

  action = text : t.caption {
    contents: "View",
    fill[0].color: c.colors.accentText
  }
}

@variant
export attachmentOffline = frame : attachmentRow {
  title: "Attachment / Offline device",
  top: 64px,

  copy {
    path {
      fill[0].color: c.colors.muted,
      contents: "macos-reconnect.log"
    }

    note {
      contents: "MacBook Pro · offline, unavailable"
    }
  }

  action {
    display: .none
  }
}

// Git commit attachment: shows repo and full SHA without requiring the device to be online
@variant
export commitRow = frame : attachmentRow {
  title: "Attachment / Commit",
  top: 128px,

  action {
    contents: "Copy"
  }

  copy {
    note {
      contents: "hhubb22/baton · fix(gateway): rebuild TLS connection after wake"
    }

    path {
      contents: "4c1e9a2f0b7d63e18a5c2f9e4d1b0a7c6e3f2d19",
      font-size: 12,
      font-family: "Paper Mono"
    }
  }

  @with-variant(icons.commit)
  glyph {}
}

// Message sent to the Agent: right-aligned subtle bubble like user messages in the main conversation.
// Messages from the Project Agent carry its teal mark at the bottom-left; messages from you do not. Timestamps appear on hover. Specify an explicit width on multiline text
export threadMessage = frame {
  title: "Thread message / From project assistant",
  top: 192px,
  width: 392px,
  layout: {direction: .column, align-items: .end, item-gap: 6px},
  children: [line, meta],

  line = frame {
    layout: {align-items: .end, item-gap: s.space.sm},
    children: [from, bubble],

    from = frame : avatars.agentMark {
      width: 20px,
      height: 20px
    }

    bubble = frame {
      width: .auto,
      layout: {direction: .row},
      fill: c.colors.subtle,
      shadow: {
        drop-shadow: {
          color: c.colors.shadowSoft,
          offset: point(0px, 1px),
          blur-radius: 2px
        }
      },
      corner-radius: 18px,
      padding: [10px, 16px],
      children: content,

      content = text : t.body {
        width: 300px,
        contents: "In D:\\src\\baton-ps160, run go test ./internal/gateway -run Reconnect -count=1, suspend the machine for 1 minute, and check if it reconnects after waking. Save the log as an attachment."
      }
    }
  }

  meta = frame {
    display: .none,
    layout: {align-items: .center, item-gap: s.space.xs},
    padding: [0px, s.space.xs],
    children: [metaIcon, metaText, withdraw],

    metaIcon = asset : icons.clock {
      width: 13px,
      height: 13px,
      fill[0].color: c.colors.faint
    }

    metaText = text : t.caption {
      contents: "Sending next ·",
      fill[0].color: c.colors.faint
    }

    withdraw = text : t.caption {
      contents: "Cancel",
      fill[0].color: c.colors.accentText
    }
  }
}

// Queued message from you: outlined bubble indicates it has not been delivered yet; sent after the current turn finishes and can be withdrawn beforehand
@variant
export threadMessageQueued = frame : threadMessage {
  title: "Thread message / Waiting to send",
  top: 320px,

  line {
    bubble {
      border[0].color: c.colors.border,
      fill[0].color: c.colors.transparent,
      shadow[0]: .nil,

      content {
        width: .auto,
        contents: "Attach the macOS log as well."
      }
    }

    from {
      display: .none
    }
  }

  meta {
    display: .visible
  }
}

// Agent reply: left-aligned body text without a name, matching Project Agent replies. Completion time and duration appear on hover.
// Starts with the turn's activity trace, followed by body text and an attachments card. Reply text and attachment references are stored on the Coordinator and remain visible when the device is offline
export threadReply = frame {
  title: "Agent reply",
  top: 480px,
  width: 392px,
  layout: {direction: .column, item-gap: s.space.md},
  children: [trace, content, attachments],

  trace = frame : threadTrace {
    width: 100%
  }

  content = text : t.body {
    width: 100%,
    contents: "47 of 48 tests passed. TestReconnectAfterSleep did not reconnect within 30s after waking from sleep; log attached."
  }

  attachments = frame {
    width: 100%,
    layout: {direction: .column},
    border: {color: c.colors.borderSoft, sides: .left},
    padding: [0px, 0px, 0px, 14px],
    children: [first, second],

    first = frame : attachmentRow {
      width: 100%
    }

    second = frame : attachmentOffline {
      width: 100%
    }
  }
}

// Turn activity trace: tool calls, commands, and file edits made by the Agent, using the same collapsed-by-default style as the main conversation.
// Full trace stays on the device and loads on demand when expanded; notes when unavailable if the device is offline while Coordinator-saved replies remain readable
export threadTrace = frame : conv.activityLog {
  title: "Thread trace / Collapsed",
  top: 760px,
  width: 392px,

  logBody {
    logSteps {
      overrides: [
        insert(
          unavailable,
          after = conv.activityLog.logBody.logSteps.stepMemory
        )
      ],

      stepMemory {
        stepRow {
          stepNote {
            display: .none
          }

          stepLead {
            stepLabel {
              contents: "Wrote reconnect.log"
            }

            @with-variant(icons.file)
            stepGlyph {}
          }
        }
      }

      stepCommand {
        stepRow {
          stepNote {
            display: .none
          }

          stepLead {
            stepLabel {
              contents: "go test -run Reconnect ./internal/gateway"
            }
          }
        }

        stepOutput {
          stepResult {
            contents: "=== RUN   TestReconnectAfterSleep\nreconnect_test.go:88: did not reconnect within 30s after wake\n--- FAIL: TestReconnectAfterSleep (92.41s)\nFAIL"
          }
        }
      }
    }
  }

  logHead {
    logLabel {
      contents: "Ran 1 command, wrote 1 file"
    }
  }

  unavailable = text : t.small {
    display: .none,
    contents: "Windows Desktop is offline · activity unavailable",
    fill[0].color: c.colors.faint
  }
}

// Expanded: lists each step and lets commands expand to show output
@variant
export threadTraceOpen = frame : threadTrace {
  title: "Thread trace / Expanded",
  top: 830px,

  logBody {
    display: .visible
  }

  logHead {
    @with-variant(icons.chevronDown)
    logChevron {}
  }
}

// Offline device: trace cannot be fetched from the device and explains why
@variant
export threadTraceOffline = frame : threadTraceOpen {
  title: "Thread trace / Offline device",
  top: 1100px,

  logBody {
    logSteps {
      stepCommand {
        display: .none
      }

      stepMemory {
        display: .none
      }

      unavailable {
        display: .visible
      }
    }
  }
}

// Local session history deleted on the device: trace is unavailable while Coordinator-saved replies and attachments remain intact
@variant
export threadTraceMissing = frame : threadTraceOffline {
  title: "Thread trace / History missing",
  top: 1180px,

  logBody {
    logSteps {
      unavailable {
        contents: "Past chat history was deleted on this computer"
      }
    }
  }
}

// Running turn: trace stays expanded with an elapsed timer at the top and live output streamed from the device below. Live output is display-only and not stored on the Coordinator;
// reconnects backfill from the device and mark any missing gap. Collapses into the on-demand trace once the turn finishes
export liveOutput = frame {
  title: "Live output / Running",
  top: 1260px,
  width: 392px,
  layout: {direction: .column, item-gap: 6px},
  children: [note, stream],

  note = frame {
    height: 24px,
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [mark, label],

    mark = frame {
      width: 13px,
      height: 13px,
      layout: {justify-content: .center, align-items: .center},
      children: dot,

      dot = shape : status.dot {}
    }

    label = text : t.small {
      contents: "Running · 03:12",
      line-height: 1,
      fill[0].color: c.colors.accentText
    }
  }

  stream = frame {
    width: 100%,
    layout: {direction: .column},
    padding: [0px, 0px, 0px, 6px],
    children: rail,

    rail = frame {
      width: 100%,
      layout: {direction: .column},
      border: {color: c.colors.borderSoft, width: 1.5px, sides: .left},
      padding: [0px, 0px, 0px, 15px],
      children: lines,

      lines = frame {
        width: 100%,
        layout: {direction: .column},
        fill: c.colors.code,
        border: c.colors.codeBorder,
        corner-radius: 10px,
        padding: [10px, s.space.md],
        children: [output, gap, tail],

        output = text : t.mono {
          width: 100%,
          contents: "$ go test ./internal/gateway -run Reconnect -count=1\n=== RUN   TestReconnectAfterSleep\n    sleeping host for 180s…"
        }

        gap = frame {
          width: 100%,
          display: .none,
          layout: {align-items: .center, item-gap: 6px},
          padding: [6px, 0px, 2px],
          children: [gapGlyph, gapText],

          gapGlyph = asset : icons.offline {
            width: 13px,
            height: 13px,
            fill[0].color: c.colors.faint
          }

          gapText = text : t.caption {
            contents: "Connection lost · output resumes when reconnected",
            line-height: 1,
            fill[0].color: c.colors.faint
          }
        }

        tail = text : t.mono {
          width: 100%,
          display: .none,
          contents: "    reconnected after 41.2s\n--- PASS: TestReconnectAfterSleep (221.07s)"
        }
      }
    }
  }
}

// Live output interrupted: device went offline or disconnected. Timer stops at the last report rather than presenting past activity as current
@variant
export liveOutputInterrupted = frame : liveOutput {
  title: "Live output / Interrupted",
  top: 1440px,

  note {
    label {
      fill[0].color: c.colors.muted,
      contents: "No report since 14:32"
    }

    mark {
      @with-variant(status.dotIdle)
      dot {
        left: .nil
      }
    }
  }

  stream {
    rail {
      lines {
        gap {
          display: .visible
        }
      }
    }
  }
}

// Output gap after reconnect: device retains only a bounded recent window and marks the missing segment
@variant
export liveOutputGap = frame : liveOutput {
  title: "Live output / Output gap",
  top: 1630px,

  stream {
    rail {
      lines {
        gap {
          gapText {
            contents: "Earlier output is no longer available on Windows Desktop"
          }

          display: .visible,

          @with-variant(icons.dots)
          gapGlyph {}
        }

        tail {
          display: .visible
        }
      }
    }
  }

  note {
    label {
      contents: "Running · 06:41"
    }
  }
}

// Appears when selecting text in a reply, file preview, or attention item to prefill a quote in the main conversation composer
export selectionMenu = frame {
  title: "Selection popover",
  top: 1860px,
  layout: {align-items: .center},
  fill: c.colors.surface,
  border: c.colors.border,
  shadow: {
    drop-shadow: {
      color: c.colors.shadowNear,
      offset: point(0px, 4px),
      blur-radius: 12px
    }
  },
  corner-radius: s.radius.md,
  padding: s.space.xxs,
  children: ask,

  ask = frame : buttons.smallGhost {
    label {
      contents: "Ask project assistant"
    }

    @with-variant(icons.reply)
    lead {
      width: 14px,
      height: 14px,
      display: .visible
    }
  }
}

// Thread detail panel: opens on the right of the Project page while keeping the main conversation in place. Shares the same chat styling:
// messages to the Agent align right, Agent replies align left, and linked attention items appear inline in the timeline.
// Header holds only title and status; device and directory sit below the composer, and the Agent is named in the composer placeholder.
export threadDetail = frame {
  title: "Thread detail panel",
  caption: "Read chat activity and replies. Back returns to the project overview.",
  left: 480px,
  width: s.size.detail,
  height: s.size.screenHeight,
  layout: {direction: .column},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: [
    {
      drop-shadow: {
        color: c.colors.shadowNear,
        offset: point(0px, 1px),
        blur-radius: 3px
      }
    },
    {
      drop-shadow: {
        color: c.colors.shadowFar,
        offset: point(0px, 12px),
        blur-radius: 40px
      }
    }
  ],
  corner-radius: s.radius.lg,
  children: [head, body, footer],

  head = frame {
    width: 100%,
    height: s.size.header,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: s.space.md
    },
    border: {color: c.colors.borderSoft, sides: .bottom},
    padding: [0px, s.space.sm],
    children: [lead, tools],

    lead = frame {
      layout: {align-items: .center, item-gap: 6px},
      children: [back, name, state],

      back = frame : buttons.iconButton {
        @with-variant(icons.chevronLeft)
        glyph {}
      }

      name = text : t.label {
        contents: "Run reconnect tests on Windows",
        font-size: 14,
        font-style: "SemiBold"
      }

      state = frame : status.labelIdle {
        padding-top: 0px,
        padding-left: 6px,
        padding-bottom: 0px,
        padding-right: 0px
      }
    }

    tools = frame {
      layout: {align-items: .center, item-gap: s.space.xxs},
      children: [external, more, close],

      external = frame : buttons.iconButton {
        @with-variant(icons.external)
        glyph {}
      }

      more = frame : buttons.iconButton {}

      close = frame : buttons.iconButton {
        @with-variant(icons.close)
        glyph {}
      }
    }
  }

  body = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, justify-content: .end, item-gap: s.space.xl},
    padding: [s.space.xl, s.space.xl, s.space.sm],
    children: [message1, reply1, item, message2, live, queued],

    message1 = frame : threadMessage {
      width: 100%
    }

    reply1 = frame : threadReply {
      width: 100%
    }

    item = frame : attention.attentionCard {
      width: 100%,
      overrides: [remove(attention.attentionCard.threadRef)]
    }

    message2 = frame : conv.userMessage {
      width: 100%,
      display: .none,

      bubble {
        content {
          contents: "Sleep for 3 minutes and run it again."
        }
      }
    }

    live = frame : liveOutput {
      width: 100%,
      display: .none
    }

    queued = frame : threadMessageQueued {
      width: 100%,
      display: .none
    }
  }

  footer = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 10px},
    padding: [s.space.sm, s.space.xl, 14px],
    children: [notice, composer, context],

    notice = frame : banners.banner {
      width: 100%,
      display: .none,
      layout.align-items: .start,
      layout.direction: .column,
      layout.item-gap: 8px,

      glyph {
        display: .none
      }
    }

    composer = frame : composers.threadComposer {
      width: 100%
    }

    context = frame {
      width: 100%,
      layout: {align-items: .center, item-gap: s.space.md},
      padding: [0px, s.space.lg],
      children: [device, dir],

      device = frame {
        layout: {align-items: .center, item-gap: 5px},
        children: [deviceGlyph, deviceName],

        deviceGlyph = asset : icons.laptop {
          width: 13px,
          height: 13px,
          fill[0].color: c.colors.faint
        }

        deviceName = text : t.caption {
          contents: "Windows Desktop",
          line-height: 1,
          fill[0].color: c.colors.faint
        }
      }

      dir = frame {
        layout: {align-items: .center, item-gap: 5px},
        children: [dirGlyph, dirName],

        dirGlyph = asset : icons.folder {
          width: 13px,
          height: 13px,
          fill[0].color: c.colors.faint
        }

        dirName = text : t.caption {
          contents: "D:\\src\\baton-ps160",
          font-family: "Paper Mono",
          line-height: 1,
          fill[0].color: c.colors.faint
        }
      }
    }
  }
}

// Agent running: a direct user message starts a new turn with live output and a queued follow-up below. Can queue, steer, or stop
@variant
export threadDetailRunning = frame : threadDetail {
  title: "Thread detail panel / Running",
  left: 1000px,

  footer {
    @with-variant(composers.threadComposerRunning)
    composer {}
  }

  body {
    item {
      display: .none
    }

    reply1 {
      attachments {
        second {
          display: .none
        }
      }
    }

    queued {
      display: .visible
    }

    live {
      display: .visible
    }

    message2 {
      display: .visible
    }
  }

  head {
    lead {
      @with-variant(status.label)
      state {}
    }
  }
}

// Stop requested: awaits device confirmation while remaining Running. Queued messages are withdrawn along with the stop request
@variant
export threadDetailStopping = frame : threadDetailRunning {
  title: "Thread detail panel / Stopping",
  left: 1520px,
  top: 0px,

  footer {
    @with-variant(composers.threadComposerStopping)
    composer {}
  }

  body {
    queued {
      meta {
        withdraw {
          display: .none
        }

        metaText {
          contents: "Canceled when stopping"
        }
      }
    }

    live {
      note {
        label {
          contents: "Stopping · 03:40"
        }
      }
    }
  }

  head {
    lead {
      state {
        caption {
          contents: "Stopping…"
        }
      }
    }
  }
}

// Offline while running: header notes the last known state before disconnect, live output stops at the last report, and reconnects backfill
@variant
export threadDetailOffline = frame : threadDetailRunning {
  title: "Thread detail panel / Offline while running",
  left: 2040px,
  top: 0px,

  body {
    queued {
      display: .none
    }

    @with-variant(liveOutputInterrupted)
    live {}
  }

  footer {
    notice {
      copy {
        detail {
          contents: "Codex may still be running on Windows Desktop. Output will update when it reconnects."
        }

        heading {
          contents: "Windows Desktop is offline"
        }
      }

      display: .visible
    }
  }

  head {
    lead {
      @with-variant(status.labelIdle)
      state {
        caption {
          contents: "Last seen running"
        }

        left: .nil
      }
    }
  }
}

// Archived: no longer accepts messages while preserving messages, replies, and attachments
@variant
export threadDetailArchived = frame : threadDetail {
  title: "Thread detail panel / Archived",
  left: 2560px,
  top: 0px,

  footer {
    composer {
      display: .none
    }

    notice {
      action {
        display: .none
      }

      copy {
        detail {
          contents: "This chat is closed to new messages. Past replies and attachment links are kept."
        }

        heading {
          contents: "Archived"
        }
      }

      display: .visible,

      @with-variant(icons.archive)
      glyph {}
    }
  }

  body {
    item {
      display: .none
    }
  }

  head {
    lead {
      state {
        caption {
          contents: "Archived"
        }
      }
    }
  }
}

// Waiting for device: Thread is saved and starts once the device connects and syncs, with no expiration
@variant
export threadDetailWaiting = frame : threadDetail {
  title: "Thread detail panel / Waiting for device",
  left: 480px,
  top: 1060px,

  body {
    item {
      display: .none
    }

    reply1 {
      display: .none
    }

    message1 {
      line {
        from {
          display: .none
        }

        bubble {
          content {
            contents: "In ~/src/baton, run go test ./internal/gateway -run Reconnect, suspend the machine for 1 minute, and check if it reconnects after waking."
          }
        }
      }

      meta {
        metaText {
          contents: "Saved · sends when MacBook Pro is online ·"
        }

        display: .visible
      }
    }
  }

  footer {
    context {
      dir {
        dirName {
          contents: "~/src/baton"
        }
      }

      device {
        deviceName {
          contents: "MacBook Pro"
        }
      }
    }

    composer {
      prompt {
        contents: "Message Codex on MacBook Pro…"
      }
    }

    notice {
      copy {
        detail {
          contents: "Your message is saved and will send when MacBook Pro is online. This chat stays on MacBook Pro."
        }

        heading {
          contents: "Waiting for MacBook Pro to come online"
        }
      }

      display: .visible
    }
  }

  head {
    lead {
      @with-variant(status.labelQueued)
      state {}

      name {
        contents: "Run reconnect tests on MacBook"
      }
    }
  }
}

// Status unknown: could not confirm whether the Agent received the last message. Baton does not resend automatically; inspect the trace and send again if needed
@variant
export threadDetailUnknown = frame : threadDetail {
  title: "Thread detail panel / Status unknown",
  left: 1000px,
  top: 1060px,

  footer {
    @with-variant(banners.bannerAttention)
    notice {
      action {
        label {
          contents: "View activity"
        }
      }

      copy {
        detail {
          contents: "Codex restarted while sending. Check the output above before sending your message again."
        }

        heading {
          contents: "Not sure if Codex received your last message"
        }
      }

      top: .nil,
      display: .visible
    }
  }

  body {
    message2 {
      meta {
        metaText {
          contents: "Delivery unknown"
        }

        display: .visible,

        @with-variant(icons.alert)
        metaIcon {}
      }

      display: .visible
    }

    item {
      display: .none
    }

    reply1 {
      attachments {
        second {
          display: .none
        }
      }
    }
  }

  head {
    lead {
      @with-variant(status.labelAttention)
      state {}
    }
  }
}

// Stopped and resumable: states the reason; the next message resumes the original session with the same Thread ID
@variant
export threadDetailStopped = frame : threadDetail {
  title: "Thread detail panel / Stopped",
  left: 1520px,
  top: 1060px,

  footer {
    notice {
      action {
        display: .none
      }

      copy {
        detail {
          contents: "Files already changed on Windows Desktop are kept. Send a message below to continue."
        }

        heading {
          contents: "Stopped after reaching the 2-hour limit"
        }
      }

      display: .visible,

      @with-variant(icons.stop)
      glyph {}
    }
  }

  body {
    item {
      display: .none
    }

    reply1 {
      attachments {
        second {
          display: .none
        }
      }
    }

    message2 {
      display: .visible
    }
  }

  head {
    lead {
      @with-variant(status.labelStopped)
      state {}
    }
  }
}

// Missing local history: hides the composer and offers a new chat in the same folder.
@variant
export threadDetailUnresumable = frame : threadDetailStopped {
  title: "Thread detail panel / History missing",
  left: 2040px,
  top: 1060px,

  footer {
    composer {
      display: .none
    }

    notice {
      action {
        label {
          contents: "New chat in this folder"
        }

        display: .visible
      }

      copy {
        detail {
          contents: "Codex cannot continue because its local chat history was deleted. Start a new chat in this folder."
        }

        heading {
          contents: "Past chat history was deleted on Windows Desktop"
        }
      }

      @with-variant(icons.alert)
      glyph {}
    }
  }

  body {
    message2 {
      display: .none
    }

    reply1 {
      @with-variant(threadTraceMissing)
      trace {}
    }
  }
}

// Failed to start: directory missing or Agent unavailable. States the reason and does not reassign to another device
@variant
export threadDetailFailed = frame : threadDetail {
  title: "Thread detail panel / Failed to start",
  left: 2560px,
  top: 1060px,

  footer {
    composer {
      display: .none
    }

    context {
      dir {
        dirName {
          contents: "~/src/baton-old"
        }
      }

      device {
        deviceName {
          contents: "Ubuntu Dev"
        }
      }
    }

    notice {
      action {
        label {
          contents: "Choose folder"
        }
      }

      copy {
        detail {
          contents: "~/src/baton-old no longer exists on Ubuntu Dev. Choose another folder to start a new chat."
        }

        heading {
          contents: "Folder not found on Ubuntu Dev"
        }
      }

      display: .visible,

      @with-variant(icons.alert)
      glyph {}
    }
  }

  body {
    item {
      display: .none
    }

    reply1 {
      display: .none
    }

    message1 {
      line {
        from {
          display: .none
        }

        bubble {
          content {
            contents: "Run the unit test suite in ~/src/baton-old."
          }
        }
      }
    }
  }

  head {
    lead {
      @with-variant(status.labelStopped)
      state {}

      name {
        contents: "Run unit tests on Ubuntu"
      }
    }
  }
}

@variant
export threadTraceLoading = frame : threadTraceOffline {
  title: "Thread trace / Loading",
  caption: "Read full activity from the device. Saved replies stay visible.",
  left: 0px,
  top: 2200px,

  logBody {
    logSteps {
      unavailable {
        contents: "Loading activity from Windows Desktop…"
      }
    }
  }
}

@variant
export threadTraceFailed = frame : threadTraceLoading {
  title: "Thread trace / Read failed",
  caption: "Retry reads the same activity without sending another message.",
  left: 0px,
  top: 2440px,

  logBody {
    logSteps {
      overrides: [insert(retry, after = threadTrace.unavailable)],

      unavailable {
        width: 100%,
        contents: "Could not read this activity from Windows Desktop."
      }
    }
  }

  retry = frame : buttons.smallSecondary {
    label {
      contents: "Retry"
    }
  }
}

export historyPager = frame {
  title: "History pagination",
  left: 0px,
  top: 2800px,
  width: 392px,
  layout: {direction: .column, align-items: .center, item-gap: 8px},
  children: [action, note],

  action = frame : buttons.smallSecondary {
    label {
      contents: "Load earlier history"
    }
  }

  note = text : t.caption {
    width: 100%,
    contents: "Showing recent activity",
    align: .center,
    fill[0].color: c.colors.muted
  }
}

@variant
export threadDetailHistory = frame : threadDetail {
