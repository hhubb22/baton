import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/button.elyx" as buttons
import "controls/status.elyx" as status
import "controls/input.elyx" as inputs
import "controls/label.elyx" as labels
import "blocks/dialog.elyx" as dialogs

// OS switcher tab item
export systemTab = frame {
  title: "OS tab",
  left: 0px,
  top: 0px,
  width: 80px,
  height: 28px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: s.radius.pill,
  children: tabLabel,

  tabLabel = text : t.label {
    contents: "Windows",
    font-size: 12,
    line-height: 1,
    fill[0].color: c.colors.muted
  }
}

@variant
export systemTabOn = frame : systemTab {
  title: "OS tab / Selected",
  top: 40px,
  fill[0].color: c.colors.surface,
  shadow[0].drop-shadow.blur-radius: 2px,
  shadow[0].drop-shadow.color: c.colors.shadowNear,
  shadow[0].drop-shadow.offset: [0px, 1px],
  shadow[1].drop-shadow.blur-radius: 6px,
  shadow[1].drop-shadow.color: c.colors.shadowSoft,
  shadow[1].drop-shadow.offset: [0px, 1px],

  tabLabel {
    fill[0].color: c.colors.text
  }
}

// Copyable monospace block for enrollment token and registration command
export copyBlock = frame {
  title: "Copyable code block",
  left: 0px,
  top: 96px,
  width: 512px,
  layout: {item-gap: s.space.sm},
  fill: c.colors.subtle,
  corner-radius: s.radius.md,
  padding: [10px, 6px, 10px, s.space.md],
  children: [code, copy],

  code = text : t.mono {
    width: 100%,
    contents: "7Q2mX4kP-9vRa-Lw3e-H8tN",
    font-size: 12,
    line-height: 1.7
  }

  copy = frame : buttons.iconButton {
    width: 24px,
    height: 24px,

    @with-variant(icons.copy)
    glyph {
      width: 14px,
      height: 14px
    }
  }
}

// Enroll device: issues a single-use enrollment token valid for 10 minutes to register batond on a device.
// The token is passed via environment variable or stdin rather than command-line arguments. The dialog waits until the device connects or the token expires
export enrollDialog = frame : dialogs.dialog {
  title: "Connect device / Waiting",
  caption: "Run the command, then paste the code when prompted.",
  left: 0px,
  top: 200px,
  width: 600px,
  connections[0].label: "Code expires",
  connections[0].target: enrollExpired,
  connections[1].label: "Device connected",
  connections[1].target: enrollConnected,
  connections[2].label: "Code already used",
  connections[2].target: enrollRejected,

  footer {
    overrides: [
      insert(waiting, after = .nil),
      remove(dialogs.dialog.footer.note)
    ],

    actions {
      overrides: [remove(dialogs.dialog.footer.actions.confirm)],

      cancel {
        label {
          contents: "Close"
        }
      }
    }
  }

  content {
    overrides: [
      insert(nameRow, after = .nil),
      insert(tokenField, after = nameRow),
      insert(commandField, after = tokenField),
      remove(dialogs.dialog.content.message)
    ]
  }

  heading {
    contents: "Connect a device"
  }

  waiting = frame {
    width: 100%,
    layout: {
      align-items: .center,
      item-gap: s.space.sm,
      wrap: .true,
      line-gap: 4px
    },
    children: [waitDot, waitText, waitTime],

    waitDot = shape : status.dotQueued {}

    waitText = text : t.caption {
      contents: "Waiting for your computer to connect…",
      fill[0].color: c.colors.muted
    }

    waitTime = text : t.caption {
      contents: "Expires in 9m 41s",
      fill[0].color: c.colors.faint
    }
  }

  nameRow = frame {
    width: 100%,
    layout: {align-items: .end, item-gap: s.space.md},
    children: [nameField, systems],

    nameField = frame {
      width: 100%,
      layout: {direction: .column, item-gap: 6px},
      children: [nameLabel, nameInput],

      nameLabel = frame : labels.label {
        labelText {
          contents: "Device name"
        }
      }

      nameInput = frame : inputs.filled {
        width: 100%,

        value {
          contents: "MacBook Pro"
        }
      }
    }

    systems = frame {
      width: 240px,
      height: s.size.control,
      layout: {align-items: .center, item-gap: 2px},
      fill: c.colors.subtle,
      corner-radius: s.radius.pill,
      padding: 2px,
      children: [windows, macos, linux],

      windows = frame : systemTab {
        width: 100%,
        height: 100%,
        connections[0].target: enrollWindows
      }

      macos = frame : systemTabOn {
        width: 100%,
        height: 100%,
        connections[0].target: enrollDialog,

        tabLabel {
          contents: "macOS"
        }
      }

      linux = frame : systemTab {
        width: 100%,
        height: 100%,
        connections[0].target: enrollLinux,

        tabLabel {
          contents: "Linux"
        }
      }
    }
  }

  tokenField = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 6px},
    children: [tokenLabel, token, tokenNote],

    tokenLabel = frame : labels.label {
      labelText {
        contents: "Setup code (expires in 10 minutes)"
      }
    }

    token = frame : copyBlock {
      width: 100%,

      copy {
        connections[1].target: enrollCopyFailed,
        connections[0].target: enrollCopied,
        connections[1].label: "Clipboard blocked",
        connections[0].label: "Copied"
      }
    }

    tokenNote = text : t.caption {
      width: 100%,
      contents: "Use this code once to connect this computer.",
      fill[0].color: c.colors.muted
    }
  }

  commandField = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 6px},
    children: [commandLabel, command, commandNote],

    commandLabel = frame : labels.label {
      labelText {
        contents: "Run this in your terminal"
      }
    }

    command = frame : copyBlock {
      width: 100%,

      copy {
        connections[1].target: enrollCommandCopyFailed,
        connections[0].target: enrollCommandCopied,
        connections[1].label: "Clipboard blocked",
        connections[0].label: "Copied"
      }

      code {
        contents: "read -rs BATON_ENROLLMENT_TOKEN && export BATON_ENROLLMENT_TOKEN\nbatond register --coordinator https://baton.example.com \\\n  --display-name \"MacBook Pro\" --system macos"
      }
    }

    commandNote = text : t.caption {
      width: 100%,
      contents: "Paste the setup code, then press Enter. The code stays hidden as you type.",
      fill[0].color: c.colors.muted
    }
  }
}

// Windows reads the token via PowerShell
@variant
export enrollWindows = frame : enrollDialog {
  title: "Connect device / Windows",
  left: 720px,
  top: 200px,

  content {
    commandField {
      command {
        code {
          contents: "$env:BATON_ENROLLMENT_TOKEN = Read-Host -MaskInput\nbatond register --coordinator https://baton.example.com `\n  --display-name \"Windows Desktop\" --system windows"
        }
      }
    }

    tokenField {
      token {
        code {
          contents: "Lw3e-H8tN-7Q2mX4kP-9vRa"
        }
      }
    }

    nameRow {
      systems {
        @with-variant(systemTab)
        macos {
          left: .nil
        }

        @with-variant(systemTabOn)
        windows {}
      }

      nameField {
        nameInput {
          value {
            contents: "Windows Desktop"
          }
        }
      }
    }
  }
}

// Token is consumed once the device connects; dialog shows the result
@variant
export enrollConnected = frame : enrollDialog {
  title: "Connect device / Connected",
  left: 1440px,
  top: 200px,

  footer {
    actions {
      @with-variant(buttons.button)
      cancel {
        label {
          contents: "Done"
        }
      }
    }

    waiting {
      waitText {
        fill[0].color: c.colors.text,
        contents: "Connected"
      }

      waitTime {
        display: .none
      }

      @with-variant(status.dotOnline)
      waitDot {}
    }
  }

  content {
    overrides: [insert(done, after = .nil)],

    commandField {
      display: .none
    }

    tokenField {
      display: .none
    }

    nameRow {
      display: .none
    }
  }

  done = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.md},
    fill: c.colors.panel,
    border: c.colors.borderSoft,
    corner-radius: 10px,
    padding: [s.space.md, s.space.lg],
    children: [doneGlyph, doneCopy],

    doneGlyph = asset : icons.laptop {
      width: 20px,
      height: 20px,
      fill[0].color: c.colors.muted
    }

    doneCopy = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.xxs},
      children: [doneName, doneMeta],

      doneName = text : t.label {
        contents: "MacBook Pro"
      }

      doneMeta = text : t.caption {
        width: 100%,
        contents: "macOS · Codex and Pi available",
        fill[0].color: c.colors.muted
      }
    }
  }
}

// Token expired or already consumed: regenerate a new token
@variant
export enrollExpired = frame : enrollDialog {
  title: "Connect device / Code expired",
  left: 2160px,
  top: 200px,

  footer {
    actions {
      overrides: [insert(regen, after = dialogs.dialog.footer.actions.cancel)]
    }

    waiting {
      waitTime {
        display: .none
      }

      waitText {
        contents: "Setup code expired"
      }

      @with-variant(status.dotStopped)
      waitDot {}
    }
  }

  content {
    tokenField {
      @with-variant(t.captionDanger)
      tokenNote {
        contents: "Get a new code, then run the command again."
      }

      token {
        code {
          fill[0].color: c.colors.faint
        }

        copy {
          display: .none
        }
      }

      tokenLabel {
        labelText {
          contents: "Setup code expired"
        }
      }
    }
  }

  regen = frame : buttons.button {
    connections[0].target: enrollCodeLoading,

    label {
      contents: "Get a new code"
    }
  }
}

@variant
export enrollLinux = frame : enrollDialog {
  title: "Connect device / Linux",
  caption: "Read the setup code without adding it to command arguments.",
  left: 2880px,
  top: 200px,

  content {
    commandField {
      command {
        code {
          contents: "read -rs BATON_ENROLLMENT_TOKEN && export BATON_ENROLLMENT_TOKEN\nbatond register --coordinator https://baton.example.com \\\n  --display-name \"Ubuntu Dev\" --system linux"
        }
      }
    }

    nameRow {
      systems {
        @with-variant(systemTabOn)
        linux {}

        @with-variant(systemTab)
        macos {
          left: .nil
        }
      }

      nameField {
        nameInput {
          value {
            contents: "Ubuntu Dev"
          }
        }
      }
    }
  }
}

@variant
export enrollCodeLoading = frame : enrollDialog {
  title: "Connect device / Getting a code",
  caption: "Keep the device name and system while a new setup code is requested.",
  left: 0px,
  top: 1080px,
  connections[0].label: "Code ready",
  connections[0].target: enrollDialog,
  connections[1].label: "Request failed",
  connections[1].target: enrollCodeFailed,
  connections[2]: .nil,

  footer {
    waiting {
      waitTime {
        display: .none
      }

      waitText {
        contents: "Getting a new code…"
      }
    }
  }

  content {
    commandField {
      display: .none
    }

    tokenField {
      token {
        copy {
          display: .none
        }

        code {
          contents: "Waiting for Baton…"
        }
      }

      tokenNote {
        contents: "The command will be ready when the code is issued."
      }

      tokenLabel {
        labelText {
          contents: "Getting a setup code…"
        }
      }
    }
  }
}

@variant
export enrollCodeFailed = frame : enrollCodeLoading {
  title: "Connect device / Could not get a code",
  caption: "Check the connection and retry without re-entering the device name.",
  left: 720px,
  top: 1080px,

  content {
    tokenField {
      tokenNote {
        fill[0].color: c.colors.attentionText,
        contents: "Baton could not be reached. Check your connection, then get a new code."
      }

      tokenLabel {
        labelText {
          contents: "Setup code unavailable"
        }
      }

      token {
        code {
          contents: "No code issued"
        }
      }
    }
  }

  footer {
    waiting {
      waitText {
        contents: "Could not get a setup code"
      }
    }

    actions {
      overrides: [insert(retry, after = dialogs.dialog.footer.actions.cancel)]
    }
  }

  retry = frame : buttons.button {
    connections[0].target: enrollCodeLoading,

    label {
      contents: "Get a new code"
    }
  }
}

@variant
export enrollCopied = frame : enrollDialog {
  title: "Connect device / Code copied",
  caption: "Copy feedback stays next to the code. Paste it into the waiting terminal.",
  left: 1440px,
  top: 1080px,

  content {
    tokenField {
      tokenNote {
        contents: "Setup code copied. Paste it into your terminal when prompted."
      }

      token {
        copy {
          @with-variant(icons.check)
          glyph {}
        }
      }
    }
  }
}

@variant
export enrollCopyFailed = frame : enrollDialog {
  title: "Connect device / Copy unavailable",
  caption: "Select and copy the code manually when clipboard access is blocked.",
  left: 2160px,
  top: 1080px,

  content {
    tokenField {
      tokenNote {
        fill[0].color: c.colors.attentionText,
        contents: "Browser clipboard access is blocked. Select the setup code and copy it manually."
      }
    }
  }
}

@variant
export enrollRejected = frame : enrollExpired {
  title: "Connect device / Code already used",
  caption: "Issue a fresh setup code for this computer.",
  left: 2880px,
  top: 1080px,

  content {
    tokenField {
      tokenLabel {
        labelText {
          contents: "Setup code already used"
        }
      }

      tokenNote {
        contents: "This code has already connected a device. Get a new code to connect another computer."
      }
    }
  }

  footer {
    waiting {
      waitText {
        contents: "Setup code already used"
      }
    }
  }
}

@variant
export enrollCommandCopied = frame : enrollDialog {
  title: "Connect device / Command copied",
  caption: "Paste the command into the terminal before entering the setup code.",
  left: 0px,
  top: 1960px,

  content {
    commandField {
      commandNote {
        contents: "Command copied. Paste it into your terminal, then enter the setup code when prompted."
      }

      command {
        copy {
          @with-variant(icons.check)
          glyph {}
        }
      }
    }
  }
}

@variant
export enrollCommandCopyFailed = frame : enrollDialog {
  title: "Connect device / Copy command manually",
  caption: "Select and copy the command if browser clipboard access is blocked.",
  left: 720px,
  top: 1960px,

  content {
    commandField {
      commandNote {
        fill[0].color: c.colors.attentionText,
        contents: "Browser clipboard access is blocked. Select the command and copy it manually."
      }
    }
  }
}
