import "./colors@dark.elyx" as dark

export primary = tokens {
  white: .white,
  black: .black
}

// Light is the default theme. Components read only from colors; dark overrides live in colors@dark.elyx.
// Values come from OKLCH: neutrals share hue 262 at low chroma so surfaces, borders, shadows, and the scrim match the backdrop's cool tone.
// Text colors used for reading (text, muted, faint, *Text, danger, success) reach 4.5:1 on canvas, surface, and subtle.
@variants(dark.colors)
export colors = tokens {
  // Shell: the backdrop image sits under glass; the sidebar reads directly on glass, glassLift raises the overview, raised marks the selected row
  glass: rgb(100%, 100%, 100%, 66%),
  glassLift: rgb(100%, 100%, 100%, 50%),
  glassEdge: rgb(100%, 100%, 100%, 55%),
  raised: rgb(100%, 100%, 100%, 78%),
  // Elevation: shadowSoft for controls and rows, shadowNear and shadowFar as the two layers under cards, composers, and popovers; highlight and sheen light solid buttons
  shadowSoft: rgb(10.2%, 12.3%, 16.1%, 5%),
  shadowNear: rgb(10.2%, 12.3%, 16.1%, 8%),
  shadowFar: rgb(10.2%, 12.3%, 16.1%, 14%),
  highlight: rgb(100%, 100%, 100%, 28%),
  sheen: rgb(100%, 100%, 100%, 14%),
  // Keys: button material lit from above. keyTop and keyBottom tint the face gradient; Solid tokens serve accent and danger faces, the rest serve surface faces
  keyTop: rgb(100%, 100%, 100%, 8%),
  keyBottom: rgb(10.2%, 12.3%, 16.1%, 4%),
  keyHighlight: rgb(100%, 100%, 100%, 95%),
  keyShade: rgb(10.2%, 12.3%, 16.1%, 6%),
  keyPress: rgb(10.2%, 12.3%, 16.1%, 14%),
  keyGround: rgb(100%, 100%, 100%, 90%),
  keyEdgeSolid: rgb(0.4%, 0.7%, 1.3%, 22%),
  keyShadeSolid: rgb(0.4%, 0.7%, 1.3%, 22%),
  keyPressSolid: rgb(0.4%, 0.7%, 1.3%, 40%),
  keyLiftSolid: rgb(10.2%, 12.3%, 16.1%, 22%),
  // Surfaces: canvas for content cards, panel for notices and inset areas, surface for cards/composers/popovers, subtle for hover and pill backgrounds
  canvas: rgb(98.1%, 98.4%, 99%),
  panel: rgb(95.8%, 96.4%, 97.4%),
  surface: .white,
  subtle: rgb(92.9%, 93.8%, 95.4%),
  hover: rgb(10.2%, 12.3%, 16.1%, 4%),
  selected: rgb(10.2%, 12.3%, 16.1%, 7%),
  // Borders: hairline for card and composer outlines paired with shadows
  hairline: rgb(10.2%, 12.3%, 16.1%, 7%),
  borderSoft: rgb(10.2%, 12.3%, 16.1%, 9%),
  border: rgb(10.2%, 12.3%, 16.1%, 13%),
  borderStrong: rgb(10.2%, 12.3%, 16.1%, 19%),
  // Text: muted for secondary copy, faint only for placeholders and metadata
  text: rgb(11%, 12.3%, 14.5%),
  muted: rgb(28.6%, 30.3%, 33.3%),
  faint: rgb(41.1%, 42.9%, 46.1%),
  // Accent (blue): send, primary buttons, running state, links, and focus. accentSoft with accentText for secondary card actions
  accent: rgb(16.5%, 41.2%, 90%),
  accentHover: rgb(10.4%, 34.9%, 83.2%),
  accentPressed: rgb(8.5%, 30%, 72.3%),
  accentSoft: rgb(90.6%, 94.6%, 99.8%),
  accentText: rgb(15.6%, 36%, 76.2%),
  accentShadow: rgb(16.5%, 41.2%, 90%, 28%),
  onAccent: .white,
  focus: rgb(25.2%, 53%, 93.2%),
  // Project Agent (teal): reserved for Project Agent identity, active runs, and recommendations
  agent: rgb(0.7%, 66.4%, 59.4%),
  agentText: rgb(2.7%, 45.2%, 40.4%),
  agentSoft: rgb(89.5%, 97.5%, 95.9%),
  // Status
  success: rgb(9.5%, 47.8%, 23.1%),
  attention: rgb(93%, 43%, 7.1%),
  attentionText: rgb(61.6%, 27.3%, 8.6%),
  attentionSoft: rgb(99.9%, 94.3%, 90.1%),
  attentionEdge: rgb(93%, 43%, 7.1%, 22%),
  danger: rgb(74.4%, 18.4%, 18.2%),
  dangerSoft: rgb(99.8%, 93.3%, 93.1%),
  // Fill behind onAccent text on destructive confirm buttons
  dangerFill: rgb(74.4%, 18.4%, 18.2%),
  // Inverse: the one floating notice that must stand out on a page (dark in light theme, light in dark theme)
  inverse: rgb(13.5%, 14.6%, 16.8%),
  onInverse: rgb(97%, 97.5%, 98.2%),
  onInverseMuted: rgb(68%, 69.5%, 72.5%),
  // Code and scrim
  code: rgb(95.8%, 96.4%, 97.4%),
  codeBorder: rgb(10.2%, 12.3%, 16.1%, 8%),
  overlay: rgb(10.2%, 12.3%, 16.1%, 32%),
  transparent: .transparent
}

// Project avatar background hues, rotated in creation order. Same OKLCH lightness (0.6) so no Project looks louder than another.
export hues = tokens {
  slate: rgb(45.8%, 50.5%, 58.7%),
  amber: rgb(70.7%, 42.8%, 6.3%),
  violet: rgb(52.7%, 43.3%, 77.3%),
  green: rgb(29.2%, 57.4%, 36.1%),
  blue: rgb(25.8%, 51.8%, 77.2%),
  rose: rgb(75.3%, 35.8%, 43.3%)
}
