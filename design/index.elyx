import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/field.elyx" as fields
import "controls/input.elyx" as inputs
import "controls/toggle.elyx" as toggles
import "controls/status.elyx" as status
import "controls/badge.elyx" as badges
import "controls/avatar.elyx" as avatars
import "controls/tabs.elyx" as tabs
import "controls/kbd.elyx" as kbd
import "controls/chip.elyx" as chips
import "blocks/conversation.elyx" as conv
import "blocks/thread-line.elyx" as lines
import "blocks/attention-card.elyx" as attention
import "blocks/composer.elyx" as composers
import "blocks/banner.elyx" as banners
import "blocks/thread-detail.elyx" as details

overview = frame {
  title: "Baton 设计系统",
  caption: "浅色为默认主题。页面见 screens/。",
  left: 0px,
  top: 0px,
  width: 1200px,
  layout: {direction: .column, item-gap: s.space.xxl},
  fill: c.colors.canvas,
  padding: s.space.section,
  children: [
    intro,
    colorSection,
    typeSection,
    controlSection,
    statusSection,
    conversationSection,
    inputSection
  ]
}

intro = frame {
  width: 100%,
  layout: {direction: .column, item-gap: s.space.md},
  children: [introTitle, introText, rules],

  introTitle = text : t.title {
    contents: "Baton 设计系统",
    font-size: 28
  }

  introText = text : t.body {
    width: 760px,
    contents: "Baton 的界面围绕 Project 主对话组织：用户和 Project Agent 对话，Project Agent 在各台设备上开 Thread 交给 Agent 执行，需要判断的事进入待处理。界面要让人随时看清三件事：Project Agent 在哪台设备上运行或者为什么没运行，每个 Thread 在哪台设备、处于什么状态、最后一次报告是什么时候，哪些事在等自己。",
    fill[0].color: c.colors.muted
  }

  rules = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xs},
    padding: [s.space.sm, 0px, 0px],
    children: [rule1, rule2, rule3, rule4, rule5, rule6],

    rule1 = text : t.small {
      contents: "青色只属于 Project Agent：它的标识、运行中状态和它给出的建议。用户主操作用实心蓝，一屏只有一个。"
    }

    rule2 = text : t.small {
      contents: "一屏最多一个实心主按钮，其余用次要或轻量按钮。"
    }

    rule3 = text : t.small {
      contents: "浮层最多两层。需要第三层时改用弹窗，并替换当前弹窗。"
    }

    rule4 = text : t.small {
      contents: "弱化文字用 muted 或 faint 颜色，不用透明度。faint 只给占位符和元信息。"
    }

    rule5 = text : t.small {
      contents: "对话条目、卡片和输入区共用一列，左右对齐。卡片用发丝线外框、14px 圆角和两层浅阴影，行之间不加分隔线。"
    }

    rule6 = text : t.small {
      contents: "每个等待或异常状态都配一句标题、一句说明和一个动作。"
    }
  }
}

// 色块：示例颜色、名称、用途
swatch = frame {
  title: "色块",
  left: 1300px,
  top: 0px,
  width: 168px,
  layout: {direction: .column, item-gap: 6px},
  children: [chip, name, purpose],

  chip = frame {
    width: 100%,
    height: 48px,
    fill: c.colors.canvas,
    border: c.colors.borderSoft,
    corner-radius: s.radius.md
  }

  name = text : t.label {
    contents: "canvas"
  }

  purpose = text : t.caption {
    width: 100%,
    contents: "主内容区",
    fill[0].color: c.colors.faint
  }
}

section = frame {
  title: "区块",
  left: 1300px,
  top: 160px,
  width: 1104px,
  layout: {direction: .column, item-gap: s.space.lg},
  fill: c.colors.surface,
  border: c.colors.borderSoft,
  corner-radius: s.radius.lg,
  padding: s.space.xl,
  children: [heading, note],

  heading = text : t.heading {
    contents: "颜色"
  }

  note = text : t.small {
    width: 100%,
    contents: "",
    fill[0].color: c.colors.muted
  }
}

colorSection = frame : section {
  width: 100%,
  overrides: [
    insert(surfaceRow, after = section.note),
    insert(roleRow, after = surfaceRow),
    insert(stateRow, after = roleRow)
  ],

  note {
    contents: "四层中性表面用亮度区分，边界用 8% / 11% / 16% 的发丝线。角色色各管一件事。"
  }

  surfaceRow = frame {
    width: 100%,
    layout: {item-gap: s.space.lg},
    children: [sCanvas, sPanel, sSurface, sSubtle, sText, sMuted],

    sCanvas = frame : swatch {}

    sPanel = frame : swatch {
      chip {
        fill[0].color: c.colors.panel
      }

      name {
        contents: "panel"
      }

      purpose {
        contents: "侧栏、概览栏"
      }
    }

    sSurface = frame : swatch {
      chip {
        fill[0].color: c.colors.surface,
        border[0].color: c.colors.border
      }

      name {
        contents: "surface"
      }

      purpose {
        contents: "卡片、输入区、弹窗"
      }
    }

    sSubtle = frame : swatch {
      chip {
        fill[0].color: c.colors.subtle
      }

      name {
        contents: "subtle"
      }

      purpose {
        contents: "用户消息、标签底色"
      }
    }

    sText = frame : swatch {
      chip {
        fill[0].color: c.colors.text
      }

      name {
        contents: "text / muted"
      }

      purpose {
        contents: "正文和次要文字"
      }
    }

    sMuted = frame : swatch {
      chip {
        fill[0].color: c.colors.faint
      }

      name {
        contents: "faint"
      }

      purpose {
        contents: "占位符、时间、设备名"
      }
    }
  }

  roleRow = frame {
    width: 100%,
    layout: {item-gap: s.space.lg},
    children: [rAccent, rAgent, rAgentSoft, rLink, rAttention, rDanger],

    rAccent = frame : swatch {
      chip {
        fill[0].color: c.colors.accent
      }

      name {
        contents: "accent"
      }

      purpose {
        contents: "用户主操作、发送"
      }
    }

    rAgent = frame : swatch {
      chip {
        fill[0].color: c.colors.agent
      }

      name {
        contents: "agent"
      }

      purpose {
        contents: "Project Agent 标识与运行中"
      }
    }

    rAgentSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.agentSoft
      }

      name {
        contents: "agentSoft"
      }

      purpose {
        contents: "Project Agent 的建议标签"
      }
    }

    rLink = frame : swatch {
      chip {
        fill[0].color: c.colors.link
      }

      name {
        contents: "link / focus"
      }

      purpose {
        contents: "链接、焦点、未读"
      }
    }

    rAttention = frame : swatch {
      chip {
        fill[0].color: c.colors.attention
      }

      name {
        contents: "attention"
      }

      purpose {
        contents: "等你处理、状态未知"
      }
    }

    rDanger = frame : swatch {
      chip {
        fill[0].color: c.colors.danger
      }

      name {
        contents: "danger"
      }

      purpose {
        contents: "已停止、归档、吊销"
      }
    }
  }

  stateRow = frame {
    width: 100%,
    layout: {item-gap: s.space.lg},
    children: [stInfo, stSuccess, stInfoSoft, stAttentionSoft, stDangerSoft],

    stInfo = frame : swatch {
      chip {
        fill[0].color: c.colors.info
      }

      name {
        contents: "info"
      }

      purpose {
        contents: "Thread 执行中"
      }
    }

    stSuccess = frame : swatch {
      chip {
        fill[0].color: c.colors.success
      }

      name {
        contents: "success"
      }

      purpose {
        contents: "设备在线、命令退出码 0"
      }
    }

    stInfoSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.infoSoft
      }

      name {
        contents: "infoSoft"
      }

      purpose {
        contents: "状态标签底色"
      }
    }

    stAttentionSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.attentionSoft
      }

      name {
        contents: "attentionSoft"
      }

      purpose {
        contents: "需要处理的横幅"
      }
    }

    stDangerSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.dangerSoft
      }

      name {
        contents: "dangerSoft"
      }

      purpose {
        contents: "已停止标签底色"
      }
    }
  }
}

typeSection = frame : section {
  width: 100%,
  overrides: [insert(typeList, after = section.note)],

  heading {
    contents: "文字"
  }

  note {
    contents: "界面字体在设计稿里用 PingFang SC，Web 端用系统 UI 字体栈；字重只用 Regular、Medium、Semibold。代码用 Paper Mono，含中文的等宽内容用 Maple Mono CN。"
  }

  typeList = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.md},
    children: [
      tTitle,
      tHeading,
      tBody,
      tSmall,
      tLabel,
      tCaption,
      tMono,
      tMonoCN
    ],

    tTitle = text : t.title {
      contents: "title 20 · 页面标题"
    }

    tHeading = text : t.heading {
      contents: "heading 15 · 弹窗和事项标题"
    }

    tBody = text : t.body {
      contents: "body 14 · 主对话里的消息和回复"
    }

    tSmall = text : t.small {
      contents: "small 13 · 列表、表单、说明"
    }

    tLabel = text : t.label {
      contents: "label 13 · 按钮、行标题、字段名"
    }

    tCaption = text : t.caption {
      contents: "caption 12 · 时间、设备、版本"
    }

    tMono = text : t.mono {
      contents: "mono 12 · git worktree add D:\\src\\baton-ps160"
    }

    tMonoCN = text : t.monoCN {
      contents: "monoCN 12 · --- FAIL: 测试超时（30 秒）"
    }
  }
}

controlSection = frame : section {
  width: 100%,
  overrides: [
    insert(buttonRow, after = section.note),
    insert(formRow, after = buttonRow),
    insert(miscRow, after = formRow),
    insert(chipRow, after = miscRow)
  ],

  heading {
    contents: "控件"
  }

  note {
    contents: "控件高度 20 / 28 / 32，圆角 4 / 6 / 8 / 12；卡片 14，气泡 18，输入区 20，分段切换、工具栏选择片和状态片用全圆角。不可用的操作保持可点，点击后说明原因。"
  }

  buttonRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.md},
    children: [
      bPrimary,
      bSecondary,
      bGhost,
      bDanger,
      bSmall,
      bSmallSecondary,
      bIcon,
      bIconOn
    ],

    bPrimary = frame : buttons.button {}

    bSecondary = frame : buttons.secondary {}

    bGhost = frame : buttons.ghost {}

    bDanger = frame : buttons.danger {}

    bSmall = frame : buttons.small {
      label {
        contents: "新建"
      }
    }

    bSmallSecondary = frame : buttons.smallSecondary {
      label {
        contents: "重试"
      }
    }

    bIcon = frame : buttons.iconButton {}

    bIconOn = frame : buttons.iconButtonOn {}
  }

  formRow = frame {
    width: 100%,
    layout: {item-gap: s.space.xl},
    children: [fTitle, fGoal, fToggle],

    fTitle = frame : fields.field {
      width: 300px,

      @with-variant(inputs.filled)
      input {
        top: .nil
      }
    }

    fGoal = frame : fields.optionalText {
      width: 300px
    }

    fToggle = frame : toggles.on {
      width: 360px,

      copy {
        helper {
          contents: "在已登记目录下以设备上的用户身份执行。Baton 不提供沙箱。"
        }
      }
    }
  }

  miscRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.xl},
    children: [selects, tabGroup, seg, keys, people],

    selects = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [sel, selCompact],

      sel = frame : inputs.select {
        width: 180px
      }

      selCompact = frame : inputs.selectCompact {}
    }

    tabGroup = frame {
      layout: {align-items: .end, item-gap: s.space.lg},
      children: [tabA, tabB],

      tabA = frame : tabs.tab {}

      tabB = frame : tabs.tabIdle {}
    }

    seg = frame : tabs.segmented {}

    keys = frame {
      layout: {align-items: .center, item-gap: s.space.xs},
      children: [kSend, kEsc],

      kSend = frame : kbd.kbd {}

      kEsc = frame : kbd.esc {}
    }

    people = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [aSlate, aAmber, aViolet, aGreen, aAgent, aPerson],

      aSlate = frame : avatars.avatar {}

      aAmber = frame : avatars.amber {}

      aViolet = frame : avatars.violet {}

      aGreen = frame : avatars.green {}

      aAgent = frame : avatars.agentMark {}

      aPerson = frame : avatars.person {}
    }
  }

  chipRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.xl},
    children: [pickerChips, statusChips],

    pickerChips = frame {
      layout: {align-items: .center, item-gap: s.space.xxs},
      children: [chLocation, chModel, chHover],

      chLocation = frame : chips.chip {}

      chModel = frame : chips.chipModel {}

      chHover = frame : chips.chipHover {}
    }

    statusChips = frame {
      layout: {align-items: .center, item-gap: 6px},
      children: [scRunning, scQueued, scAttention],

      scRunning = frame : chips.statusChip {}

      scQueued = frame : chips.statusChipQueued {}

      scAttention = frame : chips.statusChipAttention {}
    }
  }
}

statusSection = frame : section {
  width: 100%,
  overrides: [
    insert(pillRow, after = section.note),
    insert(badgeRow, after = pillRow)
  ],

  heading {
    contents: "状态"
  }

  note {
    contents: "Thread 有六种状态，Baton 不判断一轮是成功还是失败。状态点只用六种颜色，含义由旁边的文字说明。等你处理用橙色实心数量，未读用蓝点，两者分开。"
  }

  pillRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [pRun, pQueued, pIdle, pStopped, pUnknown, pArchived],

    pRun = frame : status.pill {}

    pQueued = frame : status.pillQueued {}

    pIdle = frame : status.pillIdle {}

    pStopped = frame : status.pillStopped {}

    pUnknown = frame : status.pillUnknown {}

    pArchived = frame : status.pillArchived {}
  }

  badgeRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.md},
    children: [
      cAttention,
      cQuiet,
      tagPlain,
      tagSuggest,
      tagNeeds,
      unreadDot,
      agentDot
    ],

    cAttention = frame : badges.count {}

    cQuiet = frame : badges.countQuiet {}

    tagPlain = frame : badges.tag {}

    tagSuggest = frame : badges.tagAgent {}

    tagNeeds = frame : badges.tagAttention {}

    unreadDot = shape : badges.unread {}

    agentDot = shape : status.dotAgent {}
  }
}

conversationSection = frame : section {
  width: 100%,
  overrides: [insert(convColumns, after = section.note)],

  heading {
    contents: "主对话"
  }

  note {
    contents: "用户消息是右对齐的浅灰气泡，Project Agent 的回复是靠左的正文。一轮里执行的命令和记忆修改收在一行可展开的过程记录里；开过或发过消息的 Thread 收进一张卡片，每个 Thread 一行。等你决定的事项也是卡片，选项是带序号的浅灰行。Thread 回复的附件写明所在设备，设备离线时暂不可查看。"
  }

  convColumns = frame {
    width: 100%,
    layout: {item-gap: s.space.xl},
    children: [convLeft, convRight],

    convLeft = frame {
      width: 600px,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [
        eUser,
        eAgent,
        eCardSent,
        eLog,
        eNote,
        eThread,
        eThreadQueued,
        eThreadStopped
      ],

      eUser = frame : conv.userMessage {
        width: 100%
      }

      eAgent = frame : conv.agentTurnWork {
        width: 100%
      }

      eCardSent = frame : lines.threadCardSent {
        width: 100%
      }

      eLog = frame : conv.activityLogOpen {
        width: 100%
      }

      eNote = frame : conv.systemNote {
        width: 100%
      }

      eThread = frame : lines.threadLineIdle {
        width: 100%
      }

      eThreadQueued = frame : lines.threadLineQueued {
        width: 100%
      }

      eThreadStopped = frame : lines.threadLineStopped {
        width: 100%
      }
    }

    convRight = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [eDecision, eAnswered, eAttachment, eCommit],

      eDecision = frame : attention.attentionCard {
        width: 100%
      }

      eAnswered = frame : attention.attentionAnswered {
        width: 100%
      }

      eAttachment = frame : details.attachmentOffline {
        width: 100%
      }

      eCommit = frame : details.commitRow {
        width: 100%
      }
    }
  }
}

inputSection = frame : section {
  width: 100%,
  overrides: [insert(inputColumns, after = section.note)],

  heading {
    contents: "输入区与横幅"
  }

  note {
    contents: "主对话输入区只给 Project Agent 发消息。Thread 页顶部的输入区用来新建 Thread，选位置和模型，Agent 跟着模型走，写在提示文字里。Thread 输入区直接发给 Agent：可以换模型，执行中默认排队，Agent 支持时可以插入，也可以停止这一轮。横幅放在输入区上方，说明为什么没有运行或不能继续。"
  }

  inputColumns = frame {
    width: 100%,
    layout: {item-gap: s.space.xl},
    children: [inputLeft, inputRight],

    inputLeft = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [
        iMessage,
        iNewThread,
        iThreadRunning,
        iThreadQueueOnly,
        iThreadStopping
      ],

      iMessage = frame : composers.composerFilled {
        width: 100%
      }

      iNewThread = frame : composers.composerNewThread {
        width: 100%
      }

      iThreadRunning = frame : composers.threadComposerRunning {}

      iThreadQueueOnly = frame : composers.threadComposerQueueOnly {}

      iThreadStopping = frame : composers.threadComposerStopping {}
    }

    inputRight = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [bOffline, bPaused, bAttention],

      bOffline = frame : banners.banner {
        width: 100%
      }

      bPaused = frame : banners.bannerPaused {
        width: 100%
      }

      bAttention = frame : banners.bannerAttention {
        width: 100%
      }
    }
  }
}
