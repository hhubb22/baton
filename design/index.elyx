import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/button.elyx" as buttons
import "controls/field.elyx" as fields
import "controls/input.elyx" as inputs
import "controls/toggle.elyx" as toggles
import "controls/status.elyx" as status
import "controls/badge.elyx" as badges
import "controls/avatar.elyx" as avatars
import "controls/tabs.elyx" as tabs
import "controls/kbd.elyx" as kbd
import "controls/chip.elyx" as chips
import "blocks/conversation.elyx" as conv
import "blocks/thread-line.elyx" as lines
import "blocks/attention-card.elyx" as attention
import "blocks/composer.elyx" as composers
import "blocks/banner.elyx" as banners
import "blocks/thread-detail.elyx" as details

overview = frame {
  title: "Baton design system",
  caption: "Light is the default theme. Full screens live in screens/.",
  left: 0px,
  top: 0px,
  width: 1200px,
  layout: {direction: .column, item-gap: s.space.xxl},
  fill: c.colors.canvas,
  padding: s.space.section,
  children: [
    intro,
    colorSection,
    typeSection,
    controlSection,
    statusSection,
    conversationSection,
    inputSection
  ]
}

intro = frame {
  width: 100%,
  layout: {direction: .column, item-gap: s.space.md},
  children: [introTitle, introText, rules],

  introTitle = text : t.title {
    contents: "Baton design system",
    font-size: 28
  }

  introText = text : t.body {
    width: 760px,
    contents: "Connect your computers, chat with coding assistants, and assign work across devices through a project. Questions that need your decision appear in the inbox.",
    fill[0].color: c.colors.muted
  }

  rules = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.xs},
    padding: [s.space.sm, 0px, 0px],
    children: [rule1, rule2, rule3, rule4, rule5, rule6],

    rule1 = text : t.small {
      contents: "Teal identifies the project assistant, its activity, and its recommendations. Blue marks the primary user action."
    }

    rule2 = text : t.small {
      contents: "At most one solid primary button per screen; use secondary or ghost buttons for everything else."
    }

    rule3 = text : t.small {
      contents: "At most two overlay layers. When a third would open, replace the current dialog instead of stacking."
    }

    rule4 = text : t.small {
      contents: "De-emphasize text with muted or faint colors, not opacity. Reserve faint for placeholders and metadata."
    }

    rule5 = text : t.small {
      contents: "Messages, replies, cards, and the composer share one aligned column. Cards use a hairline border, 14px radius, and two soft shadows."
    }

    rule6 = text : t.small {
      contents: "Every waiting or abnormal state pairs a short heading with a one-line explanation and a single action when actionable."
    }
  }
}

// Color swatch: sample color, token name, and purpose
swatch = frame {
  title: "Color swatch",
  left: 1300px,
  top: 0px,
  width: 168px,
  layout: {direction: .column, item-gap: 6px},
  children: [chip, name, purpose],

  chip = frame {
    width: 100%,
    height: 48px,
    fill: c.colors.canvas,
    border: c.colors.borderSoft,
    corner-radius: s.radius.md
  }

  name = text : t.label {
    contents: "canvas"
  }

  purpose = text : t.caption {
    width: 100%,
    contents: "Main content area",
    fill[0].color: c.colors.faint
  }
}

section = frame {
  title: "Section",
  left: 1300px,
  top: 160px,
  width: 1104px,
  layout: {direction: .column, item-gap: s.space.lg},
  fill: c.colors.surface,
  border: c.colors.borderSoft,
  corner-radius: s.radius.lg,
  padding: s.space.xl,
  children: [heading, note],

  heading = text : t.heading {
    contents: "Colors"
  }

  note = text : t.small {
    width: 100%,
    contents: "",
    fill[0].color: c.colors.muted
  }
}

colorSection = frame : section {
  width: 100%,
  overrides: [
    insert(surfaceRow, after = section.note),
    insert(roleRow, after = surfaceRow),
    insert(stateRow, after = roleRow)
  ],

  note {
    contents: "Cool neutrals share one hue with the backdrop. Pages sit on a frosted backdrop, content on solid cards. Reading text reaches 4.5:1; each role color serves a single purpose."
  }

  surfaceRow = frame {
    width: 100%,
    layout: {item-gap: s.space.lg},
    children: [sCanvas, sPanel, sSurface, sSubtle, sText, sMuted],

    sCanvas = frame : swatch {}

    sPanel = frame : swatch {
      chip {
        fill[0].color: c.colors.panel
      }

      name {
        contents: "panel"
      }

      purpose {
        contents: "Notices, inset areas"
      }
    }

    sSurface = frame : swatch {
      chip {
        fill[0].color: c.colors.surface,
        border[0].color: c.colors.border
      }

      name {
        contents: "surface"
      }

      purpose {
        contents: "Cards, composer, dialogs"
      }
    }

    sSubtle = frame : swatch {
      chip {
        fill[0].color: c.colors.subtle
      }

      name {
        contents: "subtle"
      }

      purpose {
        contents: "User messages, pill fills"
      }
    }

    sText = frame : swatch {
      chip {
        fill[0].color: c.colors.text
      }

      name {
        contents: "text / muted"
      }

      purpose {
        contents: "Body and secondary text"
      }
    }

    sMuted = frame : swatch {
      chip {
        fill[0].color: c.colors.faint
      }

      name {
        contents: "faint"
      }

      purpose {
        contents: "Placeholders and metadata"
      }
    }
  }

  roleRow = frame {
    width: 100%,
    layout: {item-gap: s.space.lg},
    children: [rAccent, rAgent, rAgentSoft, rLink, rAttention, rDanger],

    rAccent = frame : swatch {
      chip {
        fill[0].color: c.colors.accent
      }

      name {
        contents: "accent"
      }

      purpose {
        contents: "Primary action, send"
      }
    }

    rAgent = frame : swatch {
      chip {
        fill[0].color: c.colors.agent
      }

      name {
        contents: "agent"
      }

      purpose {
        contents: "Project assistant activity"
      }
    }

    rAgentSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.agentSoft
      }

      name {
        contents: "agentSoft"
      }

      purpose {
        contents: "Project assistant suggestion"
      }
    }

    rLink = frame : swatch {
      chip {
        fill[0].color: c.colors.accentText
      }

      name {
        contents: "accentText"
      }

      purpose {
        contents: "Running, links, unread"
      }
    }

    rAttention = frame : swatch {
      chip {
        fill[0].color: c.colors.attention
      }

      name {
        contents: "attention"
      }

      purpose {
        contents: "Needs attention, unknown"
      }
    }

    rDanger = frame : swatch {
      chip {
        fill[0].color: c.colors.danger
      }

      name {
        contents: "danger"
      }

      purpose {
        contents: "Stopped, archive, disconnect"
      }
    }
  }

  stateRow = frame {
    width: 100%,
    layout: {item-gap: s.space.lg},
    children: [stInfo, stSuccess, stInfoSoft, stAttentionSoft, stDangerSoft],

    stInfo = frame : swatch {
      chip {
        fill[0].color: c.colors.glass,
        border[0].color: c.colors.border
      }

      name {
        contents: "glass"
      }

      purpose {
        contents: "Frosted backdrop tint"
      }
    }

    stSuccess = frame : swatch {
      chip {
        fill[0].color: c.colors.success
      }

      name {
        contents: "success"
      }

      purpose {
        contents: "Device online"
      }
    }

    stInfoSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.accentSoft
      }

      name {
        contents: "accentSoft"
      }

      purpose {
        contents: "Running pill, card actions"
      }
    }

    stAttentionSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.attentionSoft
      }

      name {
        contents: "attentionSoft"
      }

      purpose {
        contents: "Attention banner fill"
      }
    }

    stDangerSoft = frame : swatch {
      chip {
        fill[0].color: c.colors.dangerSoft
      }

      name {
        contents: "dangerSoft"
      }

      purpose {
        contents: "Stopped pill fill"
      }
    }
  }
}

typeSection = frame : section {
  width: 100%,
  overrides: [insert(typeList, after = section.note)],

  heading {
    contents: "Typography"
  }

  note {
    contents: "UI copy uses Inter in Regular, Medium, and SemiBold, with PingFang SC as the CJK fallback. Code and monospace copy use Paper Mono."
  }

  typeList = frame {
    width: 100%,
    layout: {direction: .column, item-gap: s.space.md},
    children: [tTitle, tHeading, tBody, tSmall, tLabel, tCaption, tMono],

    tTitle = text : t.title {
      contents: "title 20 · Page title"
    }

    tHeading = text : t.heading {
      contents: "heading 15 · Dialog and item heading"
    }

    tBody = text : t.body {
      contents: "body 14 · Messages and replies in main conversation"
    }

    tSmall = text : t.small {
      contents: "small 13 · Lists, forms, and descriptions"
    }

    tLabel = text : t.label {
      contents: "label 13 · Buttons, row titles, and field names"
    }

    tCaption = text : t.caption {
      contents: "caption 12 · Timestamps, devices, and versions"
    }

    tMono = text : t.mono {
      contents: "mono 12 · git worktree add D:\\src\\baton-ps160"
    }
  }
}

controlSection = frame : section {
  width: 100%,
  overrides: [
    insert(buttonRow, after = section.note),
    insert(formRow, after = buttonRow),
    insert(miscRow, after = formRow),
    insert(chipRow, after = miscRow)
  ],

  heading {
    contents: "Controls"
  }

  note {
    contents: "Control heights are 20 / 28 / 32 with 4 / 6 / 8 / 12 corner radii; cards use 14, bubbles 18, composer 20, and segmented controls, picker chips, and status chips use full pills. Unavailable actions remain clickable and explain why."
  }

  buttonRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.md},
    children: [
      bPrimary,
      bSecondary,
      bGhost,
      bDanger,
      bSmall,
      bSmallSecondary,
      bIcon,
      bIconOn
    ],

    bPrimary = frame : buttons.button {}

    bSecondary = frame : buttons.secondary {}

    bGhost = frame : buttons.ghost {}

    bDanger = frame : buttons.danger {}

    bSmall = frame : buttons.small {
      label {
        contents: "New"
      }
    }

    bSmallSecondary = frame : buttons.smallSecondary {
      label {
        contents: "Retry"
      }
    }

    bIcon = frame : buttons.iconButton {}

    bIconOn = frame : buttons.iconButtonOn {}
  }

  formRow = frame {
    width: 100%,
    layout: {item-gap: s.space.xl},
    children: [fTitle, fGoal, fToggle],

    fTitle = frame : fields.field {
      width: 300px,

      @with-variant(inputs.filled)
      input {
        top: .nil
      }
    }

    fGoal = frame : fields.optionalText {
      width: 300px
    }

    fToggle = frame : toggles.on {
      width: 360px,

      copy {
        helper {
          contents: "Shell commands the project assistant runs itself. Threads set their own access."
        }
      }
    }
  }

  miscRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.xl},
    children: [selects, tabGroup, seg, keys, people],

    selects = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [sel, selCompact],

      sel = frame : inputs.select {
        width: 180px
      }

      selCompact = frame : inputs.selectCompact {}
    }

    tabGroup = frame {
      layout: {align-items: .end, item-gap: s.space.lg},
      children: [tabA, tabB],

      tabA = frame : tabs.tab {}

      tabB = frame : tabs.tabIdle {}
    }

    seg = frame : tabs.segmented {}

    keys = frame {
      layout: {align-items: .center, item-gap: s.space.xs},
      children: [kSend, kEsc],

      kSend = frame : kbd.kbd {}

      kEsc = frame : kbd.esc {}
    }

    people = frame {
      layout: {align-items: .center, item-gap: s.space.sm},
      children: [aSlate, aAmber, aViolet, aGreen, aAgent, aPerson],

      aSlate = frame : avatars.avatar {}

      aAmber = frame : avatars.amber {}

      aViolet = frame : avatars.violet {}

      aGreen = frame : avatars.green {}

      aAgent = frame : avatars.agentMark {}

      aPerson = frame : avatars.person {}
    }
  }

  chipRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.xl},
    children: [pickerChips, statusChips],

    pickerChips = frame {
      layout: {align-items: .center, item-gap: s.space.xxs},
      children: [chLocation, chModel, chHover],

      chLocation = frame : chips.chip {}

      chModel = frame : chips.chipModel {}

      chHover = frame : chips.chipHover {}
    }

    statusChips = frame {
      layout: {align-items: .center, item-gap: 6px},
      children: [scRunning, scQueued, scAttention],

      scRunning = frame : chips.statusChip {}

      scQueued = frame : chips.statusChipQueued {}

      scAttention = frame : chips.statusChipAttention {}
    }
  }
}

statusSection = frame : section {
  width: 100%,
  overrides: [
    insert(pillRow, after = section.note),
    insert(badgeRow, after = pillRow)
  ],

  heading {
    contents: "Status"
  }

  note {
    contents: "Show whether a chat is running, waiting, idle, stopped, unknown, or archived. Labels explain each status dot. Commands show exit codes; replies explain the results."
  }

  pillRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.sm},
    children: [pRun, pQueued, pIdle, pStopped, pUnknown, pArchived],

    pRun = frame : status.pill {}

    pQueued = frame : status.pillQueued {}

    pIdle = frame : status.pillIdle {}

    pStopped = frame : status.pillStopped {}

    pUnknown = frame : status.pillUnknown {}

    pArchived = frame : status.pillArchived {}
  }

  badgeRow = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: s.space.md},
    children: [
      cAttention,
      cQuiet,
      tagPlain,
      tagSuggest,
      tagNeeds,
      unreadDot,
      agentDot
    ],

    cAttention = frame : badges.count {}

    cQuiet = frame : badges.countQuiet {}

    tagPlain = frame : badges.tag {}

    tagSuggest = frame : badges.tagAgent {}

    tagNeeds = frame : badges.tagAttention {}

    unreadDot = shape : badges.unread {}

    agentDot = shape : status.dotAgent {}
  }
}

conversationSection = frame : section {
  width: 100%,
  overrides: [insert(convColumns, after = section.note)],

  heading {
    contents: "Main conversation"
  }

  note {
    contents: "User messages are right-aligned bubbles. Assistant replies start with collapsible activity, followed by chat cards and reply text. Questions offer specific actions. Attachments name their computer and show when it is offline."
  }

  convColumns = frame {
    width: 100%,
    layout: {item-gap: s.space.xl},
    children: [convLeft, convRight],

    convLeft = frame {
      width: 600px,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [
        eUser,
        eAgent,
        eCardSent,
        eLog,
        eNote,
        eThread,
        eThreadQueued,
        eThreadStopped
      ],

      eUser = frame : conv.userMessage {
        width: 100%
      }

      eAgent = frame : conv.agentTurnWork {
        width: 100%
      }

      eCardSent = frame : lines.threadCardSent {
        width: 100%
      }

      eLog = frame : conv.activityLogOpen {
        width: 100%
      }

      eNote = frame : conv.systemNote {
        width: 100%
      }

      eThread = frame : lines.threadLineIdle {
        width: 100%
      }

      eThreadQueued = frame : lines.threadLineQueued {
        width: 100%
      }

      eThreadStopped = frame : lines.threadLineStopped {
        width: 100%
      }
    }

    convRight = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [eDecision, eAnswered, eAttachment, eCommit],

      eDecision = frame : attention.attentionCard {
        width: 100%
      }

      eAnswered = frame : attention.attentionAnswered {
        width: 100%
      }

      eAttachment = frame : details.attachmentOffline {
        width: 100%
      }

      eCommit = frame : details.commitRow {
        width: 100%
      }
    }
  }
}

inputSection = frame : section {
  width: 100%,
  overrides: [insert(inputColumns, after = section.note)],

  heading {
    contents: "Composer and banners"
  }

  note {
    contents: "Placeholders name the assistant and computer. While a reply is running, offer Send next and Send now when supported. Put waiting, stopping, and recovery details beside the affected input."
  }

  inputColumns = frame {
    width: 100%,
    layout: {item-gap: s.space.xl},
    children: [inputLeft, inputRight],

    inputLeft = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [
        iMessage,
        iNewThread,
        iThreadRunning,
        iThreadQueueOnly,
        iThreadStopping
      ],

      iMessage = frame : composers.composerFilled {
        width: 100%
      }

      iNewThread = frame : composers.composerNewThread {
        width: 100%
      }

      iThreadRunning = frame : composers.threadComposerRunning {}

      iThreadQueueOnly = frame : composers.threadComposerQueueOnly {}

      iThreadStopping = frame : composers.threadComposerStopping {}
    }

    inputRight = frame {
      width: 100%,
      layout: {direction: .column, item-gap: s.space.lg},
      children: [bOffline, bPaused, bAttention],

      bOffline = frame : banners.banner {
        width: 100%
      }

      bPaused = frame : banners.bannerPaused {
        width: 100%
      }

      bAttention = frame : banners.bannerAttention {
        width: 100%
      }
    }
  }
}
