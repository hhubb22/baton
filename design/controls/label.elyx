import "foundations/typography.elyx" as t
import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s

// Field label; optional fields append faint "(optional)"
export label = frame {
  title: "Field label",
  layout: {align-items: .center, item-gap: s.space.xxs},
  children: [labelText, hint],

  labelText = text : t.label {
    contents: "Project name"
  }

  hint = text : t.small {
    display: .none,
    contents: "(optional)",
    fill[0].color: c.colors.faint
  }
}

@variant
export optional = frame : label {
  title: "Field label / Optional",
  top: 40px,

  labelText {
    contents: "Goal"
  }

  hint {
    display: .visible
  }
}
