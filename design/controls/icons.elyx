// 图标：24 视框、1.7px 描边、单色，用 fill 着色。
// 每个图标都是 glyph 的变体，实例里可以用 @with-variant(icons.<名称>) 换图标。
export glyph = asset {
  title: "glyph",
  width: 20px,
  height: 20px,
  fill: c.colors.text,
  contents: plusAsset
}

@variant
export alert = asset : glyph {
  title: "alert",
  left: 0px,
  top: 56px,
  contents: alertAsset
}

@variant
export archive = asset : glyph {
  title: "archive",
  left: 56px,
  top: 56px,
  contents: archiveAsset
}

