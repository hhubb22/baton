import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons
import "controls/status.elyx" as status

// Picker chip: location and model selectors in composer toolbars; transparent at rest, subtle fill on hover.
// Location is directory plus device, e.g. "baton · MacBook Pro"
export chip = frame {
  title: "Picker chip / Location",
  width: .auto,
  height: s.size.compact,
  layout: {align-items: .center, item-gap: 6px},
  corner-radius: s.radius.pill,
  padding: [0px, 8px],
  children: [glyph, label, caret],

  glyph = asset : icons.folder {
    width: 15px,
    height: 15px,
    fill[0].color: c.colors.muted
  }

  label = text : t.small {
    contents: "baton · MacBook Pro",
    line-height: 1
  }

  caret = asset : icons.chevronDown {
    width: 12px,
    height: 12px,
    fill[0].color: c.colors.faint
  }
}

@variant
export chipModel = frame : chip {
  title: "Picker chip / Model",
  left: 200px,

  label {
    contents: "gpt-6.1-sol"
  }

  @with-variant(icons.sparkle)
  glyph {}
}

@variant
export chipHover = frame : chip {
  title: "Picker chip / Hover",
  left: 360px,
  fill[0].color: c.colors.hover
}

// Status chip: floats above the composer to summarize active Threads and items when the overview panel is replaced
export statusChip = frame {
  title: "Status chip / Running",
  top: 56px,
  width: .auto,
  height: s.size.compact,
  layout: {align-items: .center, item-gap: 6px},
  fill: c.colors.surface,
  border: c.colors.hairline,
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 4%),
      offset: point(0px, 1px),
      blur-radius: 3px
    }
  },
  corner-radius: s.radius.pill,
  padding: [0px, 10px],
  children: [mark, label, count],

  mark = shape : status.dot {}

  label = text : t.small {
    contents: "Running",
    line-height: 1
  }

  count = text : t.small {
    contents: "2",
    font-size: 12,
    font-family: "Paper Mono",
    line-height: 1,
    fill[0].color: c.colors.faint
  }
}

@variant
export statusChipQueued = frame : statusChip {
  title: "Status chip / Waiting",
  left: 120px,
  top: 56px,

  count {
    contents: "1"
  }

  label {
    contents: "Waiting for device"
  }

  @with-variant(status.dotQueued)
  mark {
    left: .nil
  }
}

@variant
export statusChipAttention = frame : statusChip {
  title: "Status chip / Decision",
  left: 296px,
  top: 56px,

  count {
    contents: "1"
  }

  label {
    contents: "Needs decision"
  }

  @with-variant(status.dotAttention)
  mark {
    left: .nil
  }
}
