import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// Status dots use six colors; the adjacent label or group heading explains the exact meaning.
// Blue: running; gray: waiting for device, idle, archived, or offline; green: device online; red: stopped; orange: status unknown or needs attention; teal: Project Agent running.
export dot = shape {
  title: "Status dot / Running",
  width: s.size.dot,
  height: s.size.dot,
  fill: c.colors.info,
  type: .ellipse
}

@variant
export dotQueued = shape : dot {
  title: "Status dot / Waiting for device",
  left: 24px,
  border[0].color: c.colors.faint,
  border[0].width: 1.2px,
  fill[0].color: c.colors.transparent
}

@variant
export dotOnline = shape : dot {
  title: "Status dot / Online",
  left: 48px,
  fill[0].color: c.colors.success
}

@variant
export dotStopped = shape : dot {
  title: "Status dot / Stopped",
  left: 72px,
  fill[0].color: c.colors.danger
}

@variant
export dotAttention = shape : dot {
  title: "Status dot / Unknown or needs attention",
  left: 96px,
  fill[0].color: c.colors.attention
}

@variant
export dotIdle = shape : dot {
  title: "Status dot / Idle, archived, or offline",
  left: 120px,
  fill[0].color: c.colors.faint
}

@variant
export dotAgent = shape : dot {
  title: "Status dot / Project assistant running",
  left: 144px,
  fill[0].color: c.colors.agent
}

// Thread status pill: used on Thread rows, Thread detail, and linked Threads in attention items.
// Status comes from device reports; Baton does not judge whether a turn succeeded or failed.
export pill = frame {
  title: "Thread status / Running",
  top: 40px,
  width: .auto,
  height: s.size.micro,
  layout: {align-items: .center, item-gap: 6px},
  fill: c.colors.infoSoft,
  corner-radius: s.radius.pill,
  padding: [0px, s.space.sm],
  children: [mark, label],

  mark = shape : dot {}

  label = text : t.caption {
    contents: "Running",
    fill[0].color: c.colors.text
  }
}

@variant
export pillQueued = frame : pill {
  title: "Thread status / Waiting for device",
  left: 104px,
  top: 40px,
  fill[0].color: c.colors.subtle,

  label {
    contents: "Waiting for device"
  }

  @with-variant(dotQueued)
  mark {
    left: .nil
  }
}

@variant
export pillIdle = frame : pill {
  title: "Thread status / Idle",
  left: 256px,
  top: 40px,
  fill[0].color: c.colors.subtle,

  label {
    contents: "Idle"
  }

  @with-variant(dotIdle)
  mark {
    left: .nil
  }
}

@variant
export pillStopped = frame : pill {
  title: "Thread status / Stopped",
  left: 328px,
  top: 40px,
  fill[0].color: c.colors.dangerSoft,

  label {
    contents: "Stopped"
  }

  @with-variant(dotStopped)
  mark {
    left: .nil
  }
}

@variant
export pillUnknown = frame : pill {
  title: "Thread status / Status unknown",
  left: 424px,
  top: 40px,
  fill[0].color: c.colors.attentionSoft,

  label {
    contents: "Status unknown"
  }

  @with-variant(dotAttention)
  mark {
    left: .nil
  }
}

@variant
export pillArchived = frame : pill {
  title: "Thread status / Archived",
  left: 560px,
  top: 40px,
  fill[0].color: c.colors.subtle,

  label {
    fill[0].color: c.colors.muted,
    contents: "Archived"
  }

  @with-variant(dotIdle)
  mark {
    left: .nil
  }
}
