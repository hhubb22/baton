import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// 状态点只有六种颜色，具体含义由旁边的文字和分组标题说明。
// 蓝：执行中；灰：等待设备、空闲、已归档或离线；绿：设备在线；红：已停止；橙：状态未知或等你处理；青：Project Agent 运行中。
export dot = shape {
  title: "状态点 / 执行中",
  width: s.size.dot,
  height: s.size.dot,
  fill: c.colors.info,
  type: .ellipse
}

@variant
export dotQueued = shape : dot {
  title: "状态点 / 等待设备",
  left: 24px,
  border[0].color: c.colors.faint,
  border[0].width: 1.2px,
  fill[0].color: c.colors.transparent
}

@variant
export dotOnline = shape : dot {
  title: "状态点 / 设备在线",
  left: 48px,
  fill[0].color: c.colors.success
}

@variant
export dotStopped = shape : dot {
  title: "状态点 / 已停止",
  left: 72px,
  fill[0].color: c.colors.danger
}

@variant
export dotAttention = shape : dot {
  title: "状态点 / 状态未知、等你处理",
  left: 96px,
  fill[0].color: c.colors.attention
}

@variant
export dotIdle = shape : dot {
  title: "状态点 / 空闲、已归档、离线",
  left: 120px,
  fill[0].color: c.colors.faint
}

@variant
export dotAgent = shape : dot {
  title: "状态点 / Project Agent 运行中",
  left: 144px,
  fill[0].color: c.colors.agent
}

// Thread 状态标签：用在 Thread 行、Thread 详情和事项的关联 Thread 上。
// 状态只来自设备报告；Baton 不判断一轮对话做得好不好，所以没有成功和失败。
export pill = frame {
  title: "Thread 状态 / 执行中",
  top: 40px,
  width: .auto,
  height: s.size.micro,
  layout: {align-items: .center, item-gap: 6px},
  fill: c.colors.infoSoft,
  corner-radius: s.radius.pill,
  padding: [0px, s.space.sm],
  children: [mark, label],

  mark = shape : dot {}

  label = text : t.caption {
    contents: "执行中",
    fill[0].color: c.colors.text
  }
}

@variant
export pillQueued = frame : pill {
  title: "Thread 状态 / 等待设备",
  left: 96px,
  top: 40px,
  fill[0].color: c.colors.subtle,

  label {
    contents: "等待设备"
  }

  @with-variant(dotQueued)
  mark {
    left: .nil
  }
}

@variant
export pillIdle = frame : pill {
  title: "Thread 状态 / 空闲",
  left: 208px,
  top: 40px,
  fill[0].color: c.colors.subtle,

  label {
    contents: "空闲"
  }

  @with-variant(dotIdle)
  mark {
    left: .nil
  }
}

@variant
export pillStopped = frame : pill {
  title: "Thread 状态 / 已停止",
  left: 288px,
  top: 40px,
  fill[0].color: c.colors.dangerSoft,

  label {
    contents: "已停止"
  }

  @with-variant(dotStopped)
  mark {
    left: .nil
  }
}

@variant
export pillUnknown = frame : pill {
  title: "Thread 状态 / 状态未知",
  left: 384px,
  top: 40px,
  fill[0].color: c.colors.attentionSoft,

  label {
    contents: "状态未知"
  }

  @with-variant(dotAttention)
  mark {
    left: .nil
  }
}

@variant
export pillArchived = frame : pill {
  title: "Thread 状态 / 已归档",
  left: 496px,
  top: 40px,
  fill[0].color: c.colors.subtle,

  label {
    fill[0].color: c.colors.muted,
    contents: "已归档"
  }

  @with-variant(dotIdle)
  mark {
    left: .nil
  }
}
