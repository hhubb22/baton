import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// Attention count: solid orange pill, shows 9+ above 9
export count = frame {
  title: "Count / Needs attention",
  width: .auto,
  height: 16px,
  min-width: 16px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.attention,
  corner-radius: s.radius.pill,
  padding: [0px, 5px],
  children: value,

  value = text : t.caption {
    contents: "2",
    font-size: 11,
    font-style: "Medium",
    line-height: 1,
    fill[0].color: c.primary.white
  }
}

// Quiet count: muted text for tabs and group headings
@variant
export countQuiet = frame : count {
  title: "Count / Quiet",
  left: 40px,
  fill[0].color: c.colors.subtle,

  value {
    fill[0].color: c.colors.muted,
    contents: "7"
  }
}

// Tag: indicates source or attribute, such as "Default device" or "Created by Baton"
export tag = frame {
  title: "Tag",
  left: 88px,
  width: .auto,
  height: 18px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.subtle,
  corner-radius: s.radius.inner,
  padding: [0px, 6px],
  children: value,

  value = text : t.caption {
    contents: "Default device",
    font-size: 11,
    line-height: 1,
    fill[0].color: c.colors.muted
  }
}

@variant
export tagAgent = frame : tag {
  title: "Tag / Project assistant",
  left: 200px,
  fill[0].color: c.colors.agentSoft,

  value {
    fill[0].color: c.colors.agentText,
    contents: "Recommended"
  }
}

@variant
export tagAttention = frame : tag {
  title: "Tag / Needs attention",
  left: 312px,
  fill[0].color: c.colors.attentionSoft,

  value {
    fill[0].color: c.colors.attentionText,
    contents: "Needs attention"
  }
}

// Unread dot
export unread = shape {
  title: "Unread dot",
  left: 432px,
  top: 5px,
  width: 6px,
  height: 6px,
  fill: c.colors.accentText,
  type: .ellipse
}
