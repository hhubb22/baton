import "controls/label.elyx" as labels
import "foundations/typography.elyx" as t
import "tokens/colors.elyx" as c
import "controls/input.elyx" as inputs

// Field: label, input, and helper note explaining what the value affects.
export field = frame {
  title: "Field",
  width: 320px,
  layout: {direction: .column, item-gap: 6px},
  children: [label, input, helper],

  label = frame : labels.label {}

  input = frame : inputs.input {
    width: 100%
  }

  helper = text : t.caption {
    width: 100%,
    contents: "You can rename this project anytime.",
    fill[0].color: c.colors.muted
  }
}

@variant
export error = frame : field {
  title: "Field / Error",
  top: 120px,

  helper {
    fill[0].color: c.colors.danger,
    contents: "Enter a project name."
  }

  @with-variant(inputs.error)
  input {
    top: .nil
  }
}

@variant
export optionalText = frame : field {
  title: "Field / Optional multiline",
  top: 240px,

  helper {
    contents: "Describe what you want the project assistant to achieve."
  }

  @with-variant(inputs.textarea)
  input {
    top: .nil
  }

  @with-variant(labels.optional)
  label {
    top: .nil
  }
}
