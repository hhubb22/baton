import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// Project avatar: first letter of the title on a rotating background hue. Hue distinguishes Projects and does not convey state.
export avatar = frame {
  title: "Project avatar / 20",
  width: 20px,
  height: 20px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.hues.slate,
  corner-radius: 5px,
  children: initial,

  initial = text : t.caption {
    contents: "B",
    font-size: 11,
    font-style: "SemiBold",
    line-height: 1,
    fill[0].color: c.primary.white
  }
}

@variant
export amber = frame : avatar {
  title: "Project avatar / Amber",
  left: 32px,
  fill[0].color: c.hues.amber,

  initial {
    contents: "C"
  }
}

@variant
export violet = frame : avatar {
  title: "Project avatar / Violet",
  left: 64px,
  fill[0].color: c.hues.violet,

  initial {
    contents: "D"
  }
}

@variant
export green = frame : avatar {
  title: "Project avatar / Green",
  left: 96px,
  fill[0].color: c.hues.green,

  initial {
    contents: "S"
  }
}

@variant
export large = frame : avatar {
  title: "Project avatar / 40",
  left: 140px,
  width: 40px,
  height: 40px,
  corner-radius: 10px,

  initial {
    font-size: 18
  }
}

// Project Agent mark: teal dot on soft teal badge
export agentMark = frame {
  title: "Project assistant mark",
  top: 56px,
  width: 16px,
  height: 16px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.agentSoft,
  corner-radius: s.radius.pill,
  children: core,

  core = shape {
    width: 6px,
    height: 6px,
    fill: c.colors.agent,
    type: .ellipse
  }
}

// Employee avatar
export person = frame {
  title: "Employee avatar",
  left: 40px,
  top: 56px,
  width: 24px,
  height: 24px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.subtle,
  border: c.colors.borderSoft,
  corner-radius: s.radius.pill,
  children: initial,

  initial = text : t.caption {
    contents: "K",
    font-size: 11,
    font-style: "Medium",
    line-height: 1,
    fill[0].color: c.colors.text
  }
}
