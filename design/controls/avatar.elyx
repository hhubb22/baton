import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// Project 头像：标题首字 + 轮换底色。底色只用于区分 Project，不表达状态。
export avatar = frame {
  title: "Project 头像 / 20",
  width: 20px,
  height: 20px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.hues.slate,
  corner-radius: 5px,
  children: initial,

  initial = text : t.caption {
    contents: "B",
    font-size: 11,
    font-style: "Semibold",
    line-height: 1,
    fill[0].color: c.primary.white
  }
}

@variant
export amber = frame : avatar {
  title: "Project 头像 / 琥珀",
  left: 32px,
  fill[0].color: c.hues.amber,

  initial {
    contents: "兼"
  }
}

@variant
export violet = frame : avatar {
  title: "Project 头像 / 紫",
  left: 64px,
  fill[0].color: c.hues.violet,

  initial {
    contents: "文"
  }
}

@variant
export green = frame : avatar {
  title: "Project 头像 / 绿",
  left: 96px,
  fill[0].color: c.hues.green,

  initial {
    contents: "交"
  }
}

@variant
export large = frame : avatar {
  title: "Project 头像 / 40",
  left: 140px,
  width: 40px,
  height: 40px,
  corner-radius: 10px,

  initial {
    font-size: 18
  }
}

// Project Agent 的标识：青色圆点 + 名称，出现在它的每段回复开头
export agentMark = frame {
  title: "Project Agent 标识",
  top: 56px,
  width: 16px,
  height: 16px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.agentSoft,
  corner-radius: s.radius.pill,
  children: core,

  core = shape {
    width: 6px,
    height: 6px,
    fill: c.colors.agent,
    type: .ellipse
  }
}

// 员工头像
export person = frame {
  title: "员工头像",
  left: 40px,
  top: 56px,
  width: 24px,
  height: 24px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.subtle,
  border: c.colors.borderSoft,
  corner-radius: s.radius.pill,
  children: initial,

  initial = text : t.caption {
    contents: "何",
    font-size: 11,
    font-style: "Medium",
    line-height: 1,
    fill[0].color: c.colors.text
  }
}
