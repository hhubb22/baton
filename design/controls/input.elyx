import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "resources/assets/chevron-down.svg" as chevronAsset

export input = frame {
  title: "Input / Placeholder",
  width: 320px,
  height: s.size.control,
  layout: {align-items: .center},
  fill: c.colors.surface,
  border: c.colors.border,
  corner-radius: s.radius.sm,
  padding: [0px, 10px],
  children: value,

  value = text : t.smallPlaceholder {
    contents: "e.g. Baton Dev"
  }
}

@variant
export filled = frame : input {
  title: "Input / Filled",
  top: 56px,

  @with-variant(t.small)
  value {
    contents: "Baton Dev"
  }
}

@variant
export focus = frame : input {
  title: "Input / Focus",
  top: 112px,
  border[0].color: c.colors.focus,
  border[0].width: 1.5px,

  @with-variant(t.small)
  value {
    contents: "Baton Dev"
  }
}

@variant
export error = frame : input {
  title: "Input / Error",
  top: 168px,
  border[0].color: c.colors.danger,

  value {
    contents: ""
  }
}

// Multiline text input
@variant
export textarea = frame : input {
  title: "Textarea",
  top: 224px,
  height: 80px,
  padding-top: 8px,
  padding-left: 10px,
  padding-bottom: 8px,
  padding-right: 10px,
  layout.align-items: .start,
  layout.direction: .row,

  value {
    width: 100%,
    contents: "Additional context"
  }
}

// Select dropdown: value + trailing chevron
export select = frame {
  title: "Select",
  left: 360px,
  width: 240px,
  height: s.size.control,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: s.space.sm
  },
  fill: c.colors.surface,
  border: c.colors.border,
  corner-radius: s.radius.sm,
  padding: [0px, 8px, 0px, 10px],
  children: [value, chevron],

  value = text : t.small {
    contents: "MacBook Pro"
  }

  chevron = asset {
    width: 14px,
    height: 14px,
    fill: c.colors.faint,
    contents: chevronAsset
  }
}

@variant
export selectCompact = frame : select {
  title: "Select / Compact",
  left: 360px,
  top: 56px,
  width: .auto,
  height: s.size.compact,
  padding-left: 8px,
  padding-right: 6px,
  border[0].color: c.colors.transparent,
  border[0].width: 0px,
  fill[0].color: c.colors.subtle,

  value {
    contents: "Codex",
    font-size: 12
  }
}
