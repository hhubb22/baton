import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// Tab: active tab has dark text and a bottom rule; count uses faint gray
export tab = frame {
  title: "Tab / Active",
  height: 36px,
  layout: {align-items: .center, item-gap: 6px},
  border: {color: c.colors.text, width: 1.5px, sides: .bottom},
  children: [label, count],

  label = text : t.label {
    contents: "Threads"
  }

  count = text : t.caption {
    contents: "7",
    fill[0].color: c.colors.faint
  }
}

@variant
export tabIdle = frame : tab {
  title: "Tab / Idle",
  left: 88px,
  border[0].color: c.colors.transparent,

  label {
    fill[0].color: c.colors.muted,
    contents: "Memory"
  }

  count {
    contents: "4"
  }
}

// Segmented control: pill track with elevated white active item. Used in Thread composer to switch between Queue and Steer
export segmented = frame {
  title: "Segmented control",
  top: 64px,
  height: 28px,
  layout: {align-items: .center, item-gap: 2px},
  fill: c.colors.subtle,
  corner-radius: s.radius.pill,
  padding: 2px,
  children: [first, second],

  first = frame {
    height: 100%,
    layout: {align-items: .center},
    fill: c.colors.surface,
    shadow: [
      {
        drop-shadow: {
          color: c.colors.shadowNear,
          offset: point(0px, 1px),
          blur-radius: 2px
        }
      },
      {
        drop-shadow: {
          color: c.colors.shadowSoft,
          offset: point(0px, 1px),
          blur-radius: 6px
        }
      }
    ],
    corner-radius: s.radius.pill,
    padding: [0px, 10px],
    children: firstLabel,

    firstLabel = text : t.label {
      contents: "Send next",
      font-size: 12,
      line-height: 1
    }
  }

  second = frame {
    height: 100%,
    layout: {align-items: .center},
    corner-radius: s.radius.pill,
    padding: [0px, 10px],
    children: secondLabel,

    secondLabel = text : t.label {
      contents: "Send now",
      font-size: 12,
      line-height: 1,
      fill[0].color: c.colors.muted
    }
  }
}

@variant
export segmentedSecond = frame : segmented {
  title: "Segmented control / Second selected",
  left: 160px,
  top: 64px,

  second {
    shadow[0].drop-shadow.color: c.colors.shadowNear,
    shadow[1].drop-shadow.color: c.colors.shadowSoft,
    fill[0].color: c.colors.surface,

    secondLabel {
      fill[0].color: c.colors.text
    }

    shadow[0].drop-shadow.offset: [0px, 1px],
    shadow[1].drop-shadow.offset: [0px, 1px],
    shadow[0].drop-shadow.blur-radius: 2px,
    shadow[1].drop-shadow.blur-radius: 6px
  }

  first {
    shadow[1]: .nil,
    shadow[0]: .nil,
    fill[0]: .nil,

    firstLabel {
      fill[0].color: c.colors.muted
    }
  }
}
