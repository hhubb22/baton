import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t

// 标签页：选中项文字加深并有底线，计数用灰色
export tab = frame {
  title: "标签页 / 选中",
  height: 36px,
  layout: {align-items: .center, item-gap: 6px},
  border: {color: c.colors.text, width: 1.5px, sides: .bottom},
  children: [label, count],

  label = text : t.label {
    contents: "Thread"
  }

  count = text : t.caption {
    contents: "7",
    fill[0].color: c.colors.faint
  }
}

@variant
export tabIdle = frame : tab {
  title: "标签页 / 未选中",
  left: 80px,
  border[0].color: c.colors.transparent,

  label {
    fill[0].color: c.colors.muted,
    contents: "记忆"
  }

  count {
    contents: "4"
  }
}

// 分段切换：胶囊底，选中项白底浮起。输入区用它切「发消息」和「新建 Thread」，Thread 输入区用它切「排队」和「插入」
export segmented = frame {
  title: "分段切换",
  top: 64px,
  height: 28px,
  layout: {align-items: .center, item-gap: 2px},
  fill: c.colors.subtle,
  corner-radius: s.radius.pill,
  padding: 2px,
  children: [first, second],

  first = frame {
    height: 100%,
    layout: {align-items: .center},
    fill: c.colors.surface,
    shadow: [
      {
        drop-shadow: {
          color: rgb(0%, 0%, 0%, 8%),
          offset: point(0px, 1px),
          blur-radius: 2px
        }
      },
      {
        drop-shadow: {
          color: rgb(0%, 0%, 0%, 4%),
          offset: point(0px, 1px),
          blur-radius: 6px
        }
      }
    ],
    corner-radius: s.radius.pill,
    padding: [0px, 10px],
    children: firstLabel,

    firstLabel = text : t.label {
      contents: "发消息",
      font-size: 12,
      line-height: 1
    }
  }

  second = frame {
    height: 100%,
    layout: {align-items: .center},
    corner-radius: s.radius.pill,
    padding: [0px, 10px],
    children: secondLabel,

    secondLabel = text : t.label {
      contents: "新建 Thread",
      font-size: 12,
      line-height: 1,
      fill[0].color: c.colors.muted
    }
  }
}

@variant
export segmentedSecond = frame : segmented {
  title: "分段切换 / 选中第二项",
  left: 160px,
  top: 64px,

  second {
    shadow[0].drop-shadow.color: rgb(0%, 0%, 0%, 8%),
    shadow[1].drop-shadow.color: rgb(0%, 0%, 0%, 4%),
    fill[0].color: c.colors.surface,

    secondLabel {
      fill[0].color: c.colors.text
    }

    shadow[0].drop-shadow.offset: [0px, 1px],
    shadow[1].drop-shadow.offset: [0px, 1px],
    shadow[0].drop-shadow.blur-radius: 2px,
    shadow[1].drop-shadow.blur-radius: 6px
  }

  first {
    shadow[0]: .nil,
    shadow[1]: .nil,
    fill[0]: .nil,

    firstLabel {
      fill[0].color: c.colors.muted
    }
  }
}
