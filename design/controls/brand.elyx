import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "resources/assets/baton-mark-mono.svg" as monoSvg
import "resources/assets/baton-mark.svg" as lightSvg
import "resources/assets/baton-mark-dark.svg" as darkSvg
import "resources/assets/baton-app-icon-flattened.svg" as appSvg

export monoMark = asset {
  title: "Monochrome mark",
  caption: "Uses the text color in either theme.",
  left: 0px,
  top: 0px,
  width: 24px,
  height: 24px,
  fill: c.colors.text,
  contents: monoSvg
}

export colorMark = asset {
  title: "Color mark / Light",
  caption: "Instances use the mark for the current theme.",
  left: 96px,
  top: 0px,
  width: 32px,
  height: 32px,
  contents: lightSvg
}

@context(theme="dark")
export colorMarkDark = asset : colorMark {
  title: "Color mark / Dark",
  left: 192px,
  top: 0px,
  contents: darkSvg
}

// The derived SVG applies baton-app-icon.svg's transforms to its path coordinates.
export appIcon = asset {
  title: "App icon",
  caption: "Preserves the supplied artwork and background.",
  left: 288px,
  top: 0px,
  width: 64px,
  height: 64px,
  contents: appSvg
}

export brandSample = frame {
  title: "Brand sample",
  caption: "Original SVG assets in a reusable surface.",
  left: 0px,
  top: 160px,
  width: 480px,
  height: 112px,
  layout: {align-items: .center, item-gap: s.space.xl},
  fill: c.colors.surface,
  border: c.colors.hairline,
  corner-radius: s.radius.lg,
  padding: s.space.xl,
  children: [mark, wordmark, monoExample, appExample],

  mark = asset : colorMark {}

  wordmark = text : t.title {
    contents: "Baton"
  }

  monoExample = asset : monoMark {}

  appExample = asset : appIcon {
    width: 48px,
    height: 48px
  }
}

@context(theme="dark")
export brandSampleDark = frame : brandSample {
  title: "Brand sample / Dark",
  caption: "The parent theme variant selects the nested color mark explicitly.",
  left: 640px,
  top: 160px,

  @with-variant(colorMarkDark)
  mark {}
}

nestedPreview = frame {
  title: "Brand / Nested instances",
  caption: "An instanced parent switches its nested mark to the dark SVG when theme=dark.",
  left: 0px,
  top: 360px,
  width: 544px,
  layout: {direction: .column},
  fill: c.colors.canvas,
  padding: s.space.xxl,
  children: example,

  example = frame : brandSample {}
}
