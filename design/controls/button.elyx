import "tokens/colors.elyx" as c
import "tokens/spacing.elyx" as s
import "foundations/typography.elyx" as t
import "controls/icons.elyx" as icons

// At most one solid primary button per screen; use secondary or ghost for the rest.
// Primary carries a top sheen, a 1px highlight, and an accent-tinted shadow; secondary and danger keep a 1px neutral shadow; ghost is flat.
// Leading icon is hidden by default; set lead.display and select an icon with @with-variant in instances.
export button = frame {
  title: "Button / Primary",
  width: .auto,
  height: s.size.control,
  layout: {justify-content: .center, align-items: .center, item-gap: 6px},
  fill: [
    c.colors.accent,
    {
      linear-gradient: {
        angle: 180deg,
        stops: [stop(0%, c.colors.sheen), stop(100%, c.colors.transparent)]
      }
    }
  ],
  shadow: [
    {
      inner-shadow: {
        color: c.colors.highlight,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: c.colors.accentShadow,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: s.radius.md,
  padding: [0px, s.space.md],
  children: [lead, label],

  lead = asset : icons.plus {
    width: 15px,
    height: 15px,
    display: .none,
    fill[0].color: c.colors.onAccent
  }

  label = text : t.label {
    contents: "Create",
    fill[0].color: c.colors.onAccent
  }
}

@variant
export secondary = frame : button {
  title: "Button / Secondary",
  left: 160px,
  border[0].color: c.colors.border,
  fill[0].color: c.colors.surface,
  shadow[0].drop-shadow.blur-radius: 2px,
  shadow[0].drop-shadow.color: c.colors.shadowNear,
  shadow[0].inner-shadow.color: c.colors.shadowNear,
  shadow[1]: .nil,

  label {
    fill[0].color: c.colors.text,
    contents: "Cancel"
  }

  lead {
    fill[0].color: c.colors.muted
  }
}

@variant
export ghost = frame : button {
  title: "Button / Ghost",
  left: 320px,
  fill[0].color: c.colors.transparent,
  shadow[0]: .nil,
  shadow[1]: .nil,

  label {
    fill[0].color: c.colors.text,
    contents: "View details"
  }

  lead {
    fill[0].color: c.colors.muted
  }
}

@variant
export danger = frame : button {
  title: "Button / Danger",
  left: 480px,
  border[0].color: c.colors.border,
  fill[0].color: c.colors.surface,
  shadow[0].drop-shadow.blur-radius: 2px,
  shadow[0].drop-shadow.color: c.colors.shadowNear,
  shadow[0].inner-shadow.color: c.colors.shadowNear,
  shadow[1]: .nil,

  label {
    fill[0].color: c.colors.danger,
    contents: "Archive"
  }

  lead {
    fill[0].color: c.colors.danger
  }
}

@variant
export hover = frame : button {
  title: "Button / Primary hover",
  top: 64px,
  fill[0].color: c.colors.accentHover
}

@variant
export pressed = frame : button {
  title: "Button / Primary pressed",
  left: 160px,
  top: 64px,
  fill[0].color: c.colors.accentPressed
}

@variant
export focus = frame : button {
  title: "Button / Focus",
  left: 320px,
  top: 64px,
  border[0].color: c.colors.focus,
  border[0].position: .outside,
  border[0].width: 2px
}

@variant
export secondaryHover = frame : secondary {
  title: "Button / Secondary hover",
  left: 480px,
  top: 64px,
  fill[0].color: c.colors.subtle
}

@variant
export small = frame : button {
  title: "Button / Primary small",
  top: 128px,
  height: s.size.compact,
  padding-top: 0px,
  padding-left: 10px,
  padding-bottom: 0px,
  padding-right: 10px,

  label {
    font-size: 12
  }
}

@variant
export smallSecondary = frame : secondary {
  title: "Button / Secondary small",
  left: 160px,
  top: 128px,
  height: s.size.compact,
  padding-top: 0px,
  padding-left: 10px,
  padding-bottom: 0px,
  padding-right: 10px,

  label {
    font-size: 12
  }
}

@variant
export smallGhost = frame : ghost {
  title: "Button / Ghost small",
  left: 320px,
  top: 128px,
  height: s.size.compact,
  padding-top: 0px,
  padding-left: s.space.sm,
  padding-bottom: 0px,
  padding-right: s.space.sm,

  label {
    fill[0].color: c.colors.muted,
    font-size: 12
  }
}

@variant
export smallDanger = frame : danger {
  title: "Button / Danger small",
  top: 192px,
  height: s.size.compact,
  padding-top: 0px,
  padding-left: 10px,
  padding-bottom: 0px,
  padding-right: 10px,

  label {
    contents: "Remove",
    font-size: 12
  }
}

@variant
export smallGhostDanger = frame : smallGhost {
  title: "Button / Ghost small danger",
  left: 160px,
  top: 192px,

  label {
    fill[0].color: c.colors.danger,
    contents: "Disconnect device"
  }

  lead {
    fill[0].color: c.colors.danger
  }
}

// Icon-only button for headers and toolbars
export iconButton = frame {
  title: "Icon button",
  left: 480px,
  top: 128px,
  width: s.size.compact,
  height: s.size.compact,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: s.radius.sm,
  children: glyph,

  glyph = asset : icons.dots {
    width: 16px,
    height: 16px,
    fill[0].color: c.colors.muted
  }
}

@variant
export iconButtonOn = frame : iconButton {
  title: "Icon button / Active",
  left: 528px,
  top: 128px,
  fill[0].color: c.colors.selected,

  glyph {
    fill[0].color: c.colors.text
  }
}

// Send button: solid accent when the composer has text, idle on subtle while it is empty. Stays clickable in both states.
export sendButton = frame {
  title: "Send button",
  left: 600px,
  top: 128px,
  width: s.size.control,
  height: s.size.control,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.accent,
  corner-radius: s.radius.pill,
  children: glyph,

  glyph = asset : icons.arrowUp {
    width: 16px,
    height: 16px,
    fill[0].color: c.colors.onAccent
  }
}

@variant
export sendButtonIdle = frame : sendButton {
  title: "Send button / Empty composer",
  left: 648px,
  fill[0].color: c.colors.subtle,

  glyph {
    fill[0].color: c.colors.muted
  }
}
