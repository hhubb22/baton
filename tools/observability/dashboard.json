{
  "name": "Baton observability",
  "tags": ["baton"],
  "tiles": [
    {
      "name": "首个输出耗时 p50 / p95",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__TRACE_SOURCE_ID__",
        "groupBy": "SpanAttributes['baton.agent'], SpanAttributes['gen_ai.provider.name'], ResourceAttributes['os.type'], ResourceAttributes['service.version']",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "toFloat64OrZero(SpanAttributes['baton.turn.first_output_ms'])",
            "where": "SpanName = 'baton.turn' AND mapContains(SpanAttributes, 'baton.turn.first_output_ms')",
            "whereLanguage": "sql",
            "alias": "p50 ms"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "toFloat64OrZero(SpanAttributes['baton.turn.first_output_ms'])",
            "where": "SpanName = 'baton.turn' AND mapContains(SpanAttributes, 'baton.turn.first_output_ms')",
            "whereLanguage": "sql",
            "alias": "p95 ms"
          }
        ]
      }
    },
    {
      "name": "Turn 完成率",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__TRACE_SOURCE_ID__",
        "groupBy": "SpanAttributes['baton.agent'], SpanAttributes['gen_ai.provider.name'], ResourceAttributes['os.type'], ResourceAttributes['service.version']",
        "select": [
          {
            "aggFn": "avg",
            "valueExpression": "if(SpanAttributes['baton.turn.result'] = 'completed', 1, 0)",
            "where": "SpanName = 'baton.turn'",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "等待、命令与报告最老时间",
      "x": 0,
      "y": 3,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__METRIC_SOURCE_ID__",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricType": "gauge",
            "metricName": "baton.wait.oldest_age_s",
            "alias": "等待秒数"
          },
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricType": "gauge",
            "metricName": "baton.outbox.oldest_age_s",
            "alias": "命令秒数"
          },
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricType": "gauge",
            "metricName": "baton.reports.oldest_age_s",
            "alias": "报告秒数"
          }
        ]
      }
    },
    {
      "name": "设备账本预算比例",
      "x": 12,
      "y": 3,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__METRIC_SOURCE_ID__",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricType": "gauge",
            "metricName": "baton.ledger.budget_ratio"
          }
        ]
      }
    },
    {
      "name": "Project Run 结果",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__TRACE_SOURCE_ID__",
        "groupBy": "SpanAttributes['baton.turn.result'], ResourceAttributes['service.version']",
        "select": [{ "aggFn": "count", "where": "SpanName = 'baton.project.run'", "whereLanguage": "sql" }]
      }
    },
    {
      "name": "模型用量及未报告次数",
      "x": 12,
      "y": 6,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__TRACE_SOURCE_ID__",
        "groupBy": "SpanAttributes['gen_ai.request.model'], ResourceAttributes['service.version']",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "toUInt64OrZero(SpanAttributes['gen_ai.usage.input_tokens'])",
            "where": "startsWith(SpanName, 'chat ') AND SpanAttributes['baton.usage.reported'] = 'true' AND mapContains(SpanAttributes, 'gen_ai.usage.input_tokens')",
            "whereLanguage": "sql",
            "alias": "输入 token"
          },
          {
            "aggFn": "sum",
            "valueExpression": "toUInt64OrZero(SpanAttributes['gen_ai.usage.output_tokens'])",
            "where": "startsWith(SpanName, 'chat ') AND SpanAttributes['baton.usage.reported'] = 'true' AND mapContains(SpanAttributes, 'gen_ai.usage.output_tokens')",
            "whereLanguage": "sql",
            "alias": "输出 token"
          },
          {
            "aggFn": "count",
            "where": "startsWith(SpanName, 'chat ') AND SpanAttributes['baton.usage.reported'] = 'false'",
            "whereLanguage": "sql",
            "alias": "未报告用量"
          }
        ]
      }
    },
    {
      "name": "断线恢复等待 p95",
      "x": 0,
      "y": 9,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__LOG_SOURCE_ID__",
        "groupBy": "ResourceAttributes['service.version']",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "toFloat64OrZero(LogAttributes['baton.wait.duration_ms'])",
            "where": "Body = 'baton.wait.end' AND LogAttributes['baton.wait.reason'] = 'device_offline'",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "数据库耗时与连接等待 p95",
      "x": 12,
      "y": 9,
      "w": 12,
      "h": 3,
      "config": {
        "displayType": "line",
        "sourceId": "__TRACE_SOURCE_ID__",
        "groupBy": "ResourceAttributes['service.version']",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration / 1000000",
            "where": "mapContains(SpanAttributes, 'db.operation.name')",
            "whereLanguage": "sql",
            "alias": "数据库 ms"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "toFloat64OrZero(SpanAttributes['db.client.connection.wait_time_ms'])",
            "where": "mapContains(SpanAttributes, 'db.client.connection.wait_time_ms')",
            "whereLanguage": "sql",
            "alias": "连接等待 ms"
          }
        ]
      }
    }
  ]
}
